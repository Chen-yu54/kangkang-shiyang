.page {
  min-height: 100vh;
  background: #1a1510;
  display: flex;
  flex-direction: column;
}

.photo {
  flex: 1;
  width: 100%;
  min-height: 60vh;
}

.fallback {
  flex: 1;
  min-height: 60vh;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  background: #f7f0e1;
}

.fallback-text {
  font-size: 36rpx;
  color: #6b5a45;
}

.fallback-hint {
  margin-top: 12rpx;
  font-size: 32rpx;
  color: #8b7a5b;
}

.bar {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 24rpx 32rpx;
  background: rgba(247, 240, 225, 0.96);
}

.bar-info {
  flex: 1;
  min-width: 0;
}

.bar-name {
  display: block;
  font-size: 36rpx;
  font-weight: 600;
  color: #2d241a;
}

.bar-cuisine {
  display: block;
  margin-top: 6rpx;
  font-size: 32rpx;
  color: #8b5a2b;
}

/* 点击区 88rpx 起 */
.bar-btn {
  min-width: 120rpx;
  min-height: 88rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-left: 24rpx;
  font-size: 36rpx;
  color: #ffffff;
  background: #3f7a45;
  border-radius: 12rpx;
}

.hint {
  padding: 0 32rpx 32rpx;
  font-size: 32rpx;
  color: rgba(247, 240, 225, 0.7);
  text-align: center;
}