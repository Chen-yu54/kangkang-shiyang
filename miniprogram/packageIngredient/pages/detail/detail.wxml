<view class="page">
  <view class="content">

    <!-- 没档案：如实说，不编内容 -->
    <block wx:if="{{!found}}">
      <view class="empty">
        <text class="empty-text">{{emptyText}}</text>
        <view class="btn" hover-class="tap-hover" bindtap="onBack">返回</view>
      </view>
    </block>

    <block wx:else>
      <view class="head">
        <view class="head-row">
          <text class="head-name">{{name}}</text>
          <text wx:if="{{typeText}}" class="head-tag">{{typeText}}</text>
        </view>
        <text wx:if="{{oneLine}}" class="head-line">{{oneLine}}</text>
      </view>

      <view
        class="sec {{item.important ? 'sec-strong' : ''}}"
        wx:for="{{sections}}"
        wx:key="label"
      >
        <text class="sec-label">{{item.label}}</text>
        <text class="sec-text">{{item.text}}</text>
      </view>

      <view wx:if="{{basis}}" class="basis">
        <text class="basis-label">资料依据</text>
        <text class="basis-text">{{basis}}</text>
      </view>

      <view class="src">
        <text class="src-text">资料来自《岭南食材主料知识库 v0.2》，已剔除功效性表述；仅作食材科普，不构成膳食指导。</text>
      </view>
    </block>

    <disclaimer />
  </view>
</view>