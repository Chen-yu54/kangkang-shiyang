/* 食材档案页：米黄纸感底，正文 36rpx，区块用左侧色条区分。
   「质量与安全」块加重，因为这是用户最需要确认的一块。 */
.page {
  min-height: 100vh;
  background: #f7f0e1;
}

.content {
  padding: 32rpx 32rpx 120rpx;
}

.head {
  padding: 8rpx 0 24rpx;
  border-bottom: 2rpx solid rgba(139, 90, 43, 0.16);
}

.head-row {
  display: flex;
  align-items: baseline;
  flex-wrap: wrap;
}

.head-name {
  font-size: 52rpx;
  font-weight: 700;
  color: #2d241a;
  letter-spacing: 2rpx;
}

.head-tag {
  margin-left: 16rpx;
  padding: 6rpx 18rpx;
  font-size: 30rpx;
  color: #3f7a45;
  background: #ecf2e6;
  border-radius: 8rpx;
}

.head-line {
  display: block;
  margin-top: 14rpx;
  font-size: 36rpx;
  line-height: 1.6;
  color: #6b5a45;
}

.sec {
  margin-top: 24rpx;
  padding: 24rpx 24rpx 24rpx 26rpx;
  background: #fdf8ee;
  border-left: 8rpx solid rgba(139, 90, 43, 0.35);
  border-radius: 12rpx;
}

/* 质量与安全：墨绿边 + 略深底色，视觉上更重 */
.sec-strong {
  border-left-color: #3f7a45;
  background: #f6faf2;
}

.sec-label {
  display: block;
  font-size: 34rpx;
  font-weight: 600;
  color: #8b5a2b;
  margin-bottom: 10rpx;
}

.sec-strong .sec-label {
  color: #3f7a45;
}

.sec-text {
  display: block;
  font-size: 36rpx;
  line-height: 1.75;
  color: #3f3a30;
}

.basis {
  margin-top: 32rpx;
  padding-top: 20rpx;
  border-top: 2rpx dashed rgba(139, 90, 43, 0.2);
}

.basis-label {
  display: block;
  font-size: 32rpx;
  color: #8b7a5b;
  margin-bottom: 8rpx;
}

.basis-text {
  display: block;
  font-size: 30rpx;
  line-height: 1.6;
  color: #8b7a5b;
}

.src {
  margin-top: 24rpx;
}

.src-text {
  display: block;
  font-size: 30rpx;
  line-height: 1.7;
  color: #9b8a72;
}

.empty {
  padding: 80rpx 24rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
}

.empty-text {
  font-size: 36rpx;
  line-height: 1.8;
  color: #6b5a45;
  text-align: center;
  white-space: pre-wrap;
}

.btn {
  margin-top: 40rpx;
  min-width: 240rpx;
  min-height: 96rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 36rpx;
  font-weight: 600;
  color: #ffffff;
  background: #3f7a45;
  border-radius: 16rpx;
}