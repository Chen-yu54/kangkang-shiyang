/* 食材档案页：米黄纸感底，正文 36rpx，区块用左侧色条区分。
   「质量与安全」块加重，因为这是用户最需要确认的一块。
   每块标题配一张手绘小图，把长篇文字分区，方便扫读。 */
.page {
  min-height: 100vh;
  background: #FBF8F2;
}

.content {
  padding: 32rpx 32rpx 120rpx;
}

.head {
  padding: 8rpx 0 24rpx;
  border-bottom: 2rpx solid rgba(181, 72, 42, 0.16);
}

/* 「食材档案」小标：字距拉开，像档案袋上的铅字，不抢食材名 */
.head-kicker {
  display: block;
  margin-bottom: 10rpx;
  font-size: var(--font-caption);
  letter-spacing: var(--tracking-caps, 0.24em);
  color: #b5482a;
}

.head-row {
  display: flex;
  align-items: baseline;
  flex-wrap: wrap;
}

.head-name {
  font-size: 52rpx;
  font-weight: 700;
  color: #1E1E1A;
  letter-spacing: 2rpx;
}

.head-tag {
  margin-left: 16rpx;
  padding: 6rpx 18rpx;
  font-size: var(--font-btn);
  color: #B5482A;
  background: #F3E4DE;
  border-radius: 8rpx;
}

.head-line {
  display: block;
  margin-top: 14rpx;
  font-size: var(--font-base);
  line-height: 1.6;
  color: #4A463C;
}

.sec {
  margin-top: 24rpx;
  padding: 24rpx 24rpx 24rpx 26rpx;
  background: #FFFFFF;
  border-left: 8rpx solid rgba(31, 74, 54, 0.35);
  border-radius: 12rpx;
}

/* 质量与安全：墨绿边 + 略深底色，视觉上更重 */
.sec-strong {
  border-left-color: #B5482A;
  background: #f6faf2;
}

/* 标题行：小图 + 栏名。图 52rpx，与 34rpx 的字对齐到视觉中线 */
.sec-head {
  display: flex;
  align-items: center;
  margin-bottom: 10rpx;
}

.sec-ico {
  flex: none;
  width: 52rpx;
  height: 52rpx;
  margin-right: 12rpx;
}

.sec-label {
  display: block;
  font-size: var(--font-base);
  font-weight: 600;
  color: #B5482A;
}

.sec-strong .sec-label {
  color: #B5482A;
}

.sec-text {
  display: block;
  font-size: var(--font-base);
  line-height: 1.75;
  color: #3f3a30;
}

.basis {
  margin-top: 32rpx;
  padding-top: 20rpx;
  border-top: 2rpx dashed rgba(31, 74, 54, 0.2);
}

.basis-head {
  display: flex;
  align-items: center;
  margin-bottom: 8rpx;
}

.basis-ico {
  flex: none;
  width: 40rpx;
  height: 40rpx;
  margin-right: 10rpx;
  opacity: 0.85;
}

.basis-label {
  display: block;
  font-size: var(--font-btn);
  color: #6E6A5E;
}

.basis-text {
  display: block;
  font-size: var(--font-btn);
  line-height: 1.6;
  color: #6E6A5E;
}

.src {
  margin-top: 24rpx;
}

.src-text {
  display: block;
  font-size: var(--font-btn);
  line-height: 1.7;
  color: #9b8a72;
}

.empty {
  padding: 80rpx 24rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
}

.empty-text {
  font-size: var(--font-base);
  line-height: 1.8;
  color: #4A463C;
  text-align: center;
  white-space: pre-wrap;
}

.btn {
  margin-top: 40rpx;
  min-width: 240rpx;
  min-height: 96rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: var(--font-base);
  font-weight: 600;
  color: #ffffff;
  background: #B5482A;
  border-radius: 16rpx;
}