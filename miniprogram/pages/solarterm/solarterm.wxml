<!-- page-meta 必须是页面第一个节点，页面上只能有一个 -->
<page-meta page-style="{{pageStyle}}" />

<view class="page">
  <view class="content">

    <block wx:if="{{view === 'list'}}">
      <loading wx:if="{{status === 'loading'}}" type="skeleton" />

      <empty-state wx:elif="{{status === 'empty'}}" text="{{copy.empty}}" />

      <view wx:elif="{{status === 'error'}}" class="state-box">
        <image class="state-icon" src="/images/icons/state-error.png" mode="aspectFit" />
        <text class="state-text">{{copy.error}}</text>
        <!-- 具体原因单独一行，便于定位是数据问题还是渲染问题 -->
        <text wx:if="{{loadError}}" class="state-detail">{{loadError}}</text>
        <view class="btn" hover-class="tap-hover" bindtap="onRetry">{{copy.retry}}</view>
      </view>

      <block wx:else>
        <term-card
          wx:for="{{terms}}"
          wx:key="name"
          term="{{item}}"
          active="{{item.name === currentName}}"
          bind:termtap="onTapTerm"
        />
      </block>
    </block>

    <block wx:else>
      <!-- 节气动态背景（来自节气材料包）：天空渐变 + 纹理 + 漂浮元素 + 粒子 + 覆盖层。
           只铺在详情视图，列表视图不动；光晕并进 style 里，少一层节点。 -->
      <view wx:if="{{bg}}" class="term-bg" style="{{bg.style}}" aria-hidden="true">
        <view wx:if="{{bg.texture}}" class="term-bg-texture" style="background-image: url('{{bg.texture}}')"></view>
        <view class="term-bg-elements">
          <view
            wx:for="{{bg.elements}}"
            wx:key="index"
            class="term-bg-element term-bg-element--{{item.type}}"
            style="left: {{item.left}}%; top: {{item.top}}%; width: {{item.size}}rpx; height: {{item.size}}rpx; background: {{item.color}}; transform: rotate({{item.rotation}}deg); animation-duration: {{item.duration}}s; animation-delay: {{item.delay}}s;"
          ></view>
        </view>
        <view class="term-bg-particles">
          <view
            wx:for="{{bg.particles}}"
            wx:key="index"
            class="term-bg-particle term-bg-particle--{{item.type}}"
            style="left: {{item.left}}%; width: {{item.width}}rpx; height: {{item.height}}rpx; opacity: {{item.opacity}}; animation-duration: {{item.duration}}ms; animation-delay: {{item.delay}}s; background: {{item.color || ''}};"
          ></view>
        </view>
        <view class="term-bg-overlay" style="{{bg.overlayStyle}}"></view>
        <!-- 纸色薄纱：材料包的季节色是冷调（立冬偏黛蓝），直接铺满会让这一页发冷。
             压一层米黄薄纱后，气韵还在，但整页仍是暖纸底，跟全站一个调子。 -->
        <view class="term-bg-veil"></view>
      </view>

      <view wx:if="{{detail}}">
        <!-- 节气海报：与首页主视觉同源（AI 生成水墨图，24 节气各一张） -->
        <image
          wx:if="{{detailPoster}}"
          class="detail-poster"
          src="{{detailPoster}}"
          mode="aspectFill"
          lazy-load
        />
        <view class="detail-head">
          <view class="detail-head-main">
            <text class="detail-name">{{detail.name}}</text>
            <text wx:if="{{detail.windowText}}" class="detail-window">{{detail.windowText}}</text>
          </view>
          <!-- 详情默认打开，看别的节气从这里切回列表 -->
          <view class="detail-back" hover-class="tap-hover" bindtap="onBackList">
            <text class="detail-back-text">{{copy.all}} ›</text>
          </view>
        </view>

        <!-- 节气文化简介：来自知识库节气卡的「节气简介」栏，已剔掉功效性表述 -->
        <view wx:if="{{detail.intro}}" class="intro-card">
          <image class="intro-figure" src="/images/ingredients/term-poetry.png" mode="aspectFit" />
          <text class="intro-label">{{copy.intro}}</text>
          <text class="intro-text">{{detail.intro}}</text>
        </view>

        <!-- 节气文化：标语 + 氛围词 + 诗词 + 三候 + 民俗。
             卡底色随节气渐变（极淡，压不住字）；民俗一律标「民间流传」，不含功效表述。 -->
        <view
          wx:if="{{detail.slogan || detail.poem || detail.phenologyList.length || detail.folk.length}}"
          class="culture-card"
        >
          <view wx:if="{{detail.slogan || detail.aura}}" class="culture-head">
            <text wx:if="{{detail.slogan}}" class="culture-slogan">{{detail.slogan}}</text>
            <text wx:if="{{detail.aura}}" class="culture-aura">{{detail.aura}}</text>
          </view>

          <view wx:if="{{detail.poem}}" class="culture-poem">
            <text class="poem-text">{{detail.poem.text}}</text>
            <text wx:if="{{detail.poem.author}}" class="poem-author">{{detail.poem.author}}</text>
          </view>

          <view wx:if="{{detail.phenologyList.length}}" class="culture-block">
            <text class="culture-label">{{copy.phenology}}</text>
            <text class="culture-hint">{{copy.phenologyHint}}</text>
            <view class="pheno-row">
              <view class="pheno-item" wx:for="{{detail.phenologyList}}" wx:key="no">
                <text class="pheno-idx">{{item.label}}</text>
                <text class="pheno-text">{{item.text}}</text>
              </view>
            </view>
          </view>

          <view wx:if="{{detail.folk.length}}" class="culture-block">
            <view class="culture-label-row">
              <text class="culture-label">{{copy.folk}}</text>
              <text class="confidence-tag">{{copy.folkConfidence}}</text>
            </view>
            <view class="folk-item" wx:for="{{detail.folk}}" wx:key="title">
              <text class="folk-icon">{{item.icon}}</text>
              <view class="folk-body">
                <text class="folk-title">{{item.title}}</text>
                <text class="folk-desc">{{item.desc}}</text>
                <text wx:if="{{item.detail}}" class="folk-detail">{{item.detail}}</text>
              </view>
            </view>

            <!-- 文化区内部单独标一次「仅供参考」。
                 页面底部有固定声明条，但详情页很长，滑到这里时底部根本看不见，
                 所以文化内容旁边再标一句，口径不弱于底部那条。 -->
            <text class="culture-note">{{copy.cultureNote}}</text>
          </view>
        </view>

        <!-- 养生建议：来自节气材料包，只写节气习俗与起居经验，已剔功效性表述 -->
        <view wx:if="{{health}}" class="health-card">
          <text class="health-label">{{copy.healthTitle}}</text>
          <text wx:if="{{health.climate}}" class="health-text">{{health.climate}}</text>
          <view class="health-row" wx:for="{{health.items}}" wx:key="k">
            <text class="health-row-k">{{item.k}}</text>
            <text class="health-row-v">{{item.v}}</text>
          </view>
          <text class="health-note">{{copy.healthNote}}</text>
        </view>

        <!-- 当令食材：带性味与价格档次（来自知识库节气卡的食材表，功效列不上界） -->
        <view wx:if="{{detail.ingredientDetails.length || detail.ingredients.length}}" class="section">
          <text class="section-label">{{copy.ingredients}}</text>
          <text class="ingredient-hint">{{copy.ingredientHint}}</text>

          <view wx:if="{{detail.ingredientDetails.length}}" class="ingredient-list">
            <view class="ingredient-row" wx:for="{{detail.ingredientDetails}}" wx:key="name">
              <text class="ingredient-name">{{item.name}}</text>
              <text class="ingredient-nature" wx:if="{{item.nature}}">{{item.nature}}</text>
              <!-- 价格档次：压印五角星 ×N（原为字体符号 ★，跨平台字形不一） -->
              <view class="ingredient-price" wx:if="{{item.priceLevel}}">
                <block wx:for="{{[1, 2, 3]}}" wx:for-item="n" wx:key="*this">
                  <image wx:if="{{n <= item.priceLevel}}" class="price-star" src="/images/icons/yayin-wujiaoxing.png" mode="aspectFit" />
                </block>
              </view>
            </view>
          </view>

          <view wx:else class="chip-row">
            <text class="chip" wx:for="{{detail.ingredients}}" wx:key="*this">{{item}}</text>
          </view>
        </view>

        <view class="section">
          <view class="section-head">
            <text class="section-label">{{copy.dishes}}</text>
          </view>

          <!-- 餐次筛选：全部 / 早餐 / 午餐 / 晚餐 -->
          <view class="meal-tabs">
            <view
              class="meal-tab {{mealFilter === item.key ? 'meal-tab-on' : ''}}"
              wx:for="{{mealTabs}}"
              wx:key="key"
              data-key="{{item.key}}"
              hover-class="tap-hover"
              bindtap="onTapMeal"
            >
              <text class="meal-tab-text">{{item.label}}</text>
            </view>
          </view>
          <text class="meal-hint">{{copy.mealHint}}</text>

          <loading wx:if="{{dishStatus === 'loading'}}" type="spinner" />

          <view wx:elif="{{dishStatus === 'error'}}" class="state-box">
            <text class="state-text">{{copy.error}}</text>
            <view class="btn" hover-class="tap-hover" bindtap="onRetry">{{copy.retry}}</view>
          </view>

          <block wx:else>
            <empty-state wx:if="{{dishes.length === 0}}" compact="{{true}}" text="{{emptyMealText || copy.detailEmpty}}" />

            <dish-card
              wx:for="{{dishes}}"
              wx:key="id"
              dish="{{item}}"
              showTerm="{{false}}"
              faved="{{item.faved}}"
              bind:cardtap="onTapDish"
              bind:favoritetap="onFavoriteTap"
            />
          </block>
        </view>

        <view wx:if="{{allDishes.length}}" class="share-section">
          <view class="btn" hover-class="tap-hover" bindtap="onShareLongImage">{{copy.shareLongImage}}</view>
        </view>
      </view>

      <empty-state wx:else text="{{copy.detailEmpty}}" />
    </block>
  </view>

  <disclaimer />

  <!-- 长图画布：移出可视区域，但仍参与渲染（canvas 不能用 display:none） -->
  <canvas type="2d" id="shareCanvas" class="share-canvas"></canvas>
</view>
