/* pages/qa/qa.wxss —— 适老化：正文 32rpx 起，长者模式 36rpx，按钮 ≥88rpx */

.page {
  display: flex;
  flex-direction: column;
  height: 100vh;
  background: #faf7f2;
  font-size: var(--font-btn);
  color: #2f2a24;
  box-sizing: border-box;
}

/* 顶部条 */
.topbar {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 16rpx 28rpx;
  background: #fff;
  border-bottom: 1rpx solid #efe7dc;
}
.topbar-tip {
  font-size: var(--font-micro);
  color: #9a8f80;
}
.topbar-clear {
  font-size: var(--font-caption);
  color: #c8912f;
  padding: 8rpx 16rpx;
}

/* 消息区 */
.msg-list {
  flex: 1;
  padding: 24rpx 24rpx 0;
  box-sizing: border-box;
}
.bottom-pad {
  height: 24rpx;
}

.msg-row {
  display: flex;
  margin-bottom: 24rpx;
}
.msg-row.user {
  justify-content: flex-end;
}
.msg-row.assistant {
  justify-content: flex-start;
}

.bubble {
  max-width: 86%;
  padding: 22rpx 26rpx;
  border-radius: 24rpx;
  line-height: 1.6;
  word-break: break-all;
}
.user-bubble {
  background: #e07b39;
  color: #fff;
  border-top-right-radius: 8rpx;
  font-size: var(--font-btn);
}
.bot-bubble {
  background: #fff;
  border: 1rpx solid #efe7dc;
  border-top-left-radius: 8rpx;
  box-shadow: 0 2rpx 12rpx rgba(160, 130, 90, 0.06);
}
.bot-bubble.loading {
  color: #9a8f80;
}
.reply {
  display: block;
  font-size: var(--font-btn);
  line-height: 1.6;
}

/* 降级提示 */
.degrade-tag {
  margin-top: 14rpx;
  padding: 10rpx 16rpx;
  background: #fdf3e3;
  border-radius: 12rpx;
  color: #b07b24;
  font-size: var(--font-micro);
}

/* 菜品卡 */
.dish-list {
  margin-top: 18rpx;
}
.dish-card {
  margin-top: 16rpx;
  padding: 20rpx;
  background: #fbf8f3;
  border: 1rpx solid #f0e6d8;
  border-radius: 16rpx;
}
.dish-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
}
.dish-name {
  font-size: var(--font-base);
  font-weight: 600;
  color: #2f2a24;
}
.dish-cuisine {
  font-size: var(--font-tiny);
  color: #8b7c68;
  background: #f2e9dc;
  padding: 4rpx 12rpx;
  border-radius: 20rpx;
}
.dish-reason {
  display: block;
  margin-top: 10rpx;
  font-size: var(--font-caption);
  color: #6b5f50;
  line-height: 1.6;
}
.dish-actions {
  display: flex;
  margin-top: 16rpx;
}
.btn-mini {
  min-width: 140rpx;
  height: 64rpx;
  line-height: 64rpx;
  text-align: center;
  font-size: var(--font-caption);
  color: #c8912f;
  background: #fff;
  border: 1rpx solid #e6d6bd;
  border-radius: 32rpx;
  margin-right: 16rpx;
  padding: 0 20rpx;
}
.btn-mini-on {
  color: #fff;
  background: #c8912f;
  border-color: #c8912f;
}

/* chips */
.chips-inline {
  display: flex;
  flex-wrap: wrap;
  margin-top: 18rpx;
}
.chips {
  display: flex;
  flex-wrap: wrap;
  padding: 0 24rpx 8rpx;
}
.chip {
  font-size: var(--font-caption);
  color: #7a6a55;
  background: #fff;
  border: 1rpx solid #ecdfcc;
  border-radius: 32rpx;
  padding: 12rpx 24rpx;
  margin: 0 16rpx 16rpx 0;
  line-height: 1.4;
}
.chip-sm {
  font-size: var(--font-caption);
  padding: 8rpx 20rpx;
  margin-right: 12rpx;
}

/* 来源 */
.sources {
  margin-top: 16rpx;
}
.source-toggle {
  font-size: var(--font-micro);
  color: #8b7c68;
  text-decoration: underline;
}
.source-list {
  margin-top: 12rpx;
}
.source-item {
  margin-bottom: 10rpx;
}
.source-title {
  font-size: var(--font-micro);
  color: #4a7ab5;
  word-break: break-all;
}
.disclaimer {
  display: block;
  margin-top: 16rpx;
  font-size: var(--font-tiny);
  color: #a99c8b;
  line-height: 1.6;
}

/* 输入栏 */
.input-bar {
  display: flex;
  align-items: center;
  padding: 16rpx 24rpx calc(16rpx + env(safe-area-inset-bottom));
  background: #fff;
  border-top: 1rpx solid #efe7dc;
}
.input {
  flex: 1;
  height: 88rpx;
  padding: 0 24rpx;
  background: #f7f3ec;
  border-radius: 44rpx;
  font-size: var(--font-btn);
}
.ph {
  color: #b3a794;
}
.send-btn {
  width: 160rpx;
  height: 88rpx;
  line-height: 88rpx;
  margin-left: 16rpx;
  padding: 0;
  font-size: var(--font-btn);
  color: #fff;
  background: #e07b39;
  border-radius: 44rpx;
}
.send-btn[disabled] {
  background: #e6c4ac;
  color: #fff;
}

/* 说明遮罩 */
.mask {
  position: fixed;
  left: 0;
  right: 0;
  top: 0;
  bottom: 0;
  background: rgba(0, 0, 0, 0.45);
  display: flex;
  align-items: center;
  justify-content: center;
  z-index: 99;
}
.intro-card {
  width: 600rpx;
  background: #fff;
  border-radius: 24rpx;
  padding: 40rpx 36rpx 28rpx;
  box-sizing: border-box;
}
.intro-title {
  display: block;
  font-size: var(--font-base);
  font-weight: 600;
  margin-bottom: 24rpx;
  text-align: center;
}
.intro-text {
  display: block;
  font-size: var(--font-caption);
  color: #5b5145;
  line-height: 1.6;
  margin-bottom: 16rpx;
}
.intro-actions {
  display: flex;
  margin-top: 24rpx;
}
.intro-cancel {
  flex: 1;
  height: 88rpx;
  line-height: 88rpx;
  text-align: center;
  font-size: var(--font-btn);
  color: #8b7c68;
}
.intro-ok {
  flex: 1;
  height: 88rpx;
  line-height: 88rpx;
  text-align: center;
  font-size: var(--font-btn);
  color: #fff;
  background: #e07b39;
  border-radius: 44rpx;
}

/* ===== 长者模式：字号放大、按钮加大 ===== */
.elder .reply,
.elder .user-bubble {
  font-size: var(--font-subtitle);
  line-height: 1.85;
}
.elder .dish-name {
  font-size: var(--font-subtitle);
}
.elder .dish-reason {
  font-size: var(--font-btn);
}
.elder .btn-mini {
  height: 80rpx;
  line-height: 80rpx;
  font-size: var(--font-btn);
  min-width: 170rpx;
}
.elder .input {
  height: 96rpx;
  font-size: var(--font-base);
}
.elder .send-btn {
  height: 96rpx;
  line-height: 96rpx;
  font-size: var(--font-base);
  width: 176rpx;
}
.elder .chip {
  font-size: var(--font-btn);
  padding: 16rpx 28rpx;
}
.elder .bubble {
  max-width: 92%;
}

/* ===== C 主题 · 问答 ===== */
.user-bubble { background: var(--color-green); }
.send-btn { background: var(--color-green); }
.send-btn[disabled] { background: #C9D6CE; }
.bot-bubble {
  border: 1rpx solid var(--color-border);
  box-shadow: 0 4rpx 14rpx rgba(30, 30, 26, 0.05);
}
.input { background: #F6F2EA; }

/* ============================================================
   C 主题 · AI 问答
   ============================================================ */
.topbar {
  padding: 14rpx 20rpx;
  background: #FBF8F2;
  border-bottom: 1rpx solid var(--color-border);
}

.topbar-tip { font-size: var(--font-micro); color: var(--color-ink-3); }
.topbar-clear { font-size: var(--font-micro); color: var(--color-green); }

.msg-list { padding: 20rpx 20rpx 0; }

.user-bubble {
  border-radius: 20rpx 20rpx 6rpx 20rpx;
  background: var(--color-green);
  color: #FFFFFF;
  font-size: var(--font-btn);
  line-height: 1.6;
}

.bot-bubble {
  border: 1rpx solid var(--color-border);
  border-radius: 20rpx 20rpx 20rpx 6rpx;
  background: #FFFFFF;
  box-shadow: 0 4rpx 14rpx rgba(30, 30, 26, 0.04);
  font-size: var(--font-btn);
  line-height: 1.6;
}

.dish-card {
  padding: 14rpx;
  border-radius: 16rpx;
  background: #F6F2EA;
}

.dish-name { font-size: var(--font-caption); font-weight: 600; }
.dish-reason { font-size: var(--font-micro); color: var(--color-ink-3); }
.btn-mini { border-radius: 999rpx; }

.chips { display: flex; flex-wrap: wrap; gap: 8rpx; padding: 8rpx 20rpx; }
.chip {
  display: inline-flex;
  align-items: center;
  min-height: 64rpx;
  padding: 0 18rpx;
  border: 1rpx solid var(--color-border);
  border-radius: 999rpx;
  background: #FFFFFF;
  font-size: var(--font-micro);
  color: var(--color-ink-2);
}

.input-bar {
  padding: 10rpx 20rpx 14rpx;
  background: #FBF8F2;
  border-top: 1rpx solid var(--color-border);
}

.input {
  height: 88rpx;
  border: 1rpx solid var(--color-border);
  background: #FFFFFF;
  border-radius: 999rpx;
  font-size: var(--font-btn);
}

.send-btn {
  width: 128rpx;
  height: 80rpx;
  line-height: 80rpx;
  border-radius: 999rpx;
  background: var(--color-green);
  font-size: var(--font-caption);
}

.intro-card {
  border-radius: 28rpx;
  background: #FFFFFF;
  padding: 24rpx;
}

.intro-title { font-size: var(--font-base); font-weight: 600; }
.intro-ok {
  padding: 12rpx 24rpx;
  border-radius: 999rpx;
  background: var(--color-green);
  color: #FFFFFF;
}
