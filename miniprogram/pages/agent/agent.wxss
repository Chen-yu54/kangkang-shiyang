/* 问问康康 —— 对话页。米黄纸感 + 墨绿气泡，正文 36rpx 起，选项点击区 88rpx。 */
.page {
  min-height: 100vh;
  background: #FBF8F2;
  display: flex;
  flex-direction: column;
}

/* 顶部身份条 */
.head {
  position: sticky;
  top: 0;
  z-index: 10;
  display: flex;
  align-items: center;
  padding: 24rpx 28rpx;
  background: rgba(251, 248, 242, 0.97);
  border-bottom: 2rpx solid rgba(31, 74, 54, 0.14);
}

.head-back {
  width: 88rpx;
  height: 88rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: var(--font-title);
  color: #B5482A;
  margin-right: 8rpx;
}

.head-ava {
  width: 76rpx;
  height: 76rpx;
  border-radius: 24rpx;
  background: #B5482A;
  color: #ffffff;
  font-size: var(--font-base);
  font-weight: 700;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-right: 18rpx;
}

.head-info {
  flex: 1;
  min-width: 0;
}

.head-title {
  display: block;
  font-size: var(--font-subtitle);
  font-weight: 700;
  color: #1E1E1A;
}

.head-sub {
  display: block;
  margin-top: 4rpx;
  font-size: var(--font-btn);
  color: #6E6A5E;
}

.head-restart {
  min-height: 88rpx;
  padding: 0 24rpx;
  display: flex;
  align-items: center;
  font-size: var(--font-btn);
  color: #B5482A;
  border: 2rpx solid rgba(31, 74, 54, 0.3);
  border-radius: 12rpx;
}

/* 对话区 */
.chat {
  flex: 1;
  padding: 24rpx 24rpx 0;
  min-height: 0;
}

.chat-bottom {
  height: 24rpx;
}

.msg {
  display: flex;
  align-items: flex-start;
  margin-bottom: 28rpx;
}

.msg-me {
  flex-direction: row-reverse;
}

.msg-ava {
  width: 68rpx;
  height: 68rpx;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: var(--font-caption);
  font-weight: 700;
  flex: none;
  background: #B5482A;
  color: #ffffff;
  margin-right: 16rpx;
}

.msg-me .msg-ava {
  background: #E8E3D8;
  color: #4A463C;
  margin-right: 0;
  margin-left: 16rpx;
}

.msg-body {
  max-width: 78%;
}

.bubble {
  padding: 22rpx 24rpx;
  background: #ffffff;
  border: 2rpx solid rgba(31, 74, 54, 0.14);
  border-radius: 20rpx 20rpx 20rpx 6rpx;
}

.msg-me .bubble {
  background: #B5482A;
  border-color: #B5482A;
  border-radius: 20rpx 20rpx 6rpx 20rpx;
}

.bubble-text {
  display: block;
  font-size: var(--font-base);
  line-height: 1.7;
  color: #1E1E1A;
}

.msg-me .bubble-text {
  color: #ffffff;
}

.msg-meta {
  display: block;
  margin-top: 8rpx;
  font-size: var(--font-caption);
  color: #a79b8b;
  text-align: right;
}

/* 选项 */
.opts {
  margin-top: 20rpx;
  display: flex;
  flex-direction: column;
}

.opt {
  min-height: 88rpx;
  display: flex;
  align-items: center;
  padding: 0 24rpx;
  margin-bottom: 14rpx;
  font-size: var(--font-base);
  color: #3f3a30;
  background: #FFFFFF;
  border: 2rpx solid rgba(181, 72, 42, 0.18);
  border-radius: 14rpx;
}

.opt-on {
  color: #B5482A;
  background: #F3E4DE;
  border-color: #B5482A;
  font-weight: 600;
}

/* 菜品卡 */
.cards {
  margin-top: 20rpx;
}

.card {
  padding: 22rpx 24rpx;
  margin-bottom: 18rpx;
  background: #FFFFFF;
  border: 2rpx solid rgba(181, 72, 42, 0.16);
  border-left: 8rpx solid #B5482A;
  border-radius: 14rpx;
}

.card-head {
  display: flex;
  align-items: baseline;
  justify-content: space-between;
}

.card-name {
  font-size: var(--font-subtitle);
  font-weight: 700;
  color: #1E1E1A;
}

.card-tag {
  font-size: var(--font-caption);
  color: #6E6A5E;
  background: rgba(181, 72, 42, 0.08);
  padding: 4rpx 12rpx;
  border-radius: 8rpx;
}

.card-meta {
  display: block;
  margin-top: 6rpx;
  font-size: var(--font-btn);
  color: #6E6A5E;
}

.card-row {
  display: flex;
  align-items: flex-start;
  margin-top: 12rpx;
  padding-top: 12rpx;
  border-top: 2rpx dashed rgba(31, 74, 54, 0.14);
}

.card-label {
  flex: none;
  width: 84rpx;
  font-size: var(--font-btn);
  color: #6E6A5E;
  line-height: 1.6;
}

.card-text {
  flex: 1;
  font-size: var(--font-base);
  line-height: 1.6;
  color: #3f3a30;
}

/* 打字中 */
.typing {
  display: flex;
  margin-bottom: 12rpx;
}

.dot {
  width: 12rpx;
  height: 12rpx;
  border-radius: 50%;
  background: #b9ab98;
  margin-right: 10rpx;
  animation: bounce 1.1s infinite;
}

.dot:nth-child(2) { animation-delay: 0.15s; }
.dot:nth-child(3) { animation-delay: 0.3s; }

@keyframes bounce {
  0%, 60%, 100% { transform: translateY(0); opacity: 0.5; }
  30% { transform: translateY(-8rpx); opacity: 1; }
}

.typing-text {
  color: #4A463C;
}

/* 底部 */
.foot {
  padding: 16rpx 24rpx 24rpx;
  background: rgba(251, 248, 242, 0.97);
  border-top: 2rpx solid rgba(181, 72, 42, 0.12);
}

.foot-multi {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.foot-hint {
  font-size: var(--font-btn);
  color: #6E6A5E;
  flex: 1;
}

.foot-btn {
  min-width: 200rpx;
  min-height: 88rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: var(--font-base);
  font-weight: 600;
  color: #ffffff;
  background: #B5482A;
  border-radius: 14rpx;
}

.foot-progress {
  padding: 8rpx 0;
}

.foot-progress-text {
  font-size: var(--font-btn);
  color: #6E6A5E;
}

.foot-note {
  padding: 8rpx 0;
}

.foot-note-text {
  font-size: var(--font-btn);
  color: #6E6A5E;
}

/* ===== C 主题 · 智能体卡片 ===== */
.card {
  border: 1rpx solid var(--color-border);
  border-left: 1rpx solid var(--color-border);
  border-radius: 24rpx;
  background: #FFFFFF;
  box-shadow: 0 8rpx 24rpx rgba(30, 30, 26, 0.05);
}

.card-tag {
  background: var(--color-green-bg);
  color: var(--color-green);
  border-radius: 999rpx;
}

.card-row { border-top: 1rpx solid var(--color-border); }

/* ============================================================
   C 主题 · 问问康康（2026-11-20）
   白身份条 + 白卡 bot 气泡 + 深绿用户气泡 + 胶囊选项
   ============================================================ */
.page { background: #FBF8F2; }

.head {
  padding: calc(16rpx + env(safe-area-inset-top)) 20rpx 16rpx;
  background: rgba(251, 248, 242, 0.96);
  border-bottom: 1rpx solid var(--color-border);
}

.head-back { color: var(--color-green); font-size: var(--font-subtitle); }

.head-ava {
  width: 72rpx;
  height: 72rpx;
  border-radius: 50%;
  background: var(--color-green);
  font-size: var(--font-caption);
  margin-right: 16rpx;
}

.head-title { font-size: var(--font-base); font-weight: 600; }
.head-sub { margin-top: 2rpx; font-size: var(--font-micro); color: var(--color-ink-3); }

.head-restart {
  min-height: 64rpx;
  padding: 0 18rpx;
  border: 1rpx solid var(--color-border);
  border-radius: 999rpx;
  font-size: var(--font-micro);
  color: var(--color-green);
}

.chat { padding: 20rpx 20rpx 0; }
.msg { margin-bottom: 24rpx; }

.msg-ava {
  width: 64rpx;
  height: 64rpx;
  font-size: var(--font-micro);
  border-radius: 50%;
}

.msg-me .msg-ava {
  background: var(--color-green-bg);
  color: var(--color-green);
}

.msg .bubble {
  padding: 20rpx 22rpx;
  border: 1rpx solid var(--color-border);
  border-radius: 20rpx 20rpx 20rpx 6rpx;
  background: #FFFFFF;
  box-shadow: 0 4rpx 14rpx rgba(30, 30, 26, 0.04);
}

.msg-me .bubble {
  border-color: var(--color-green);
  border-radius: 20rpx 20rpx 6rpx 20rpx;
  background: var(--color-green);
  box-shadow: none;
}

.bubble-text { font-size: var(--font-btn); line-height: 1.7; color: var(--color-ink); }
.msg-me .bubble-text { color: #FFFFFF; }

.opts { margin-top: 12rpx; }

.opt {
  display: flex;
  align-items: center;
  min-height: 80rpx;
  padding: 12rpx 22rpx;
  margin: 0 0 10rpx;
  border: 1rpx solid var(--color-border);
  border-radius: 999rpx;
  background: #FFFFFF;
  font-size: var(--font-caption);
  line-height: 1.4;
  color: var(--color-ink);
}

.opt-on {
  border-color: var(--color-green);
  background: var(--color-green-bg);
  color: var(--color-green);
  font-weight: 600;
}

.cards { margin-top: 12rpx; }
.cards .card { border-radius: 20rpx; box-shadow: 0 6rpx 18rpx rgba(30, 30, 26, 0.05); }
.card-name { font-size: var(--font-btn); }
.card-meta { font-size: var(--font-micro); }
.card-row { margin-top: 10rpx; padding-top: 10rpx; }
.card-label, .card-text { font-size: var(--font-micro); }

.foot {
  padding: 14rpx 20rpx 20rpx;
  background: #FBF8F2;
  border-top: 1rpx solid var(--color-border);
}

.foot-btn {
  min-height: 80rpx;
  border-radius: 999rpx;
  background: var(--color-green);
  font-size: var(--font-btn);
}

.foot-hint, .foot-progress-text, .foot-note-text { font-size: var(--font-micro); color: var(--color-ink-3); }
