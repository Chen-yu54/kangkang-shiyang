/* 问问康康 —— 对话页。米黄纸感 + 墨绿气泡，正文 36rpx 起，选项点击区 88rpx。 */
.page {
  min-height: 100vh;
  background: #f7f0e1;
  display: flex;
  flex-direction: column;
}

/* 顶部身份条 */
.head {
  position: sticky;
  top: 0;
  z-index: 10;
  display: flex;
  align-items: center;
  padding: 24rpx 28rpx;
  background: rgba(247, 240, 225, 0.97);
  border-bottom: 2rpx solid rgba(139, 90, 43, 0.14);
}

.head-back {
  width: 88rpx;
  height: 88rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 44rpx;
  color: #8b5a2b;
  margin-right: 8rpx;
}

.head-ava {
  width: 76rpx;
  height: 76rpx;
  border-radius: 24rpx;
  background: #3f7a45;
  color: #ffffff;
  font-size: 34rpx;
  font-weight: 700;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-right: 18rpx;
}

.head-info {
  flex: 1;
  min-width: 0;
}

.head-title {
  display: block;
  font-size: 38rpx;
  font-weight: 700;
  color: #2d241a;
}

.head-sub {
  display: block;
  margin-top: 4rpx;
  font-size: 30rpx;
  color: #8b7a5b;
}

.head-restart {
  min-height: 88rpx;
  padding: 0 24rpx;
  display: flex;
  align-items: center;
  font-size: 32rpx;
  color: #8b5a2b;
  border: 2rpx solid rgba(139, 90, 43, 0.3);
  border-radius: 12rpx;
}

/* 对话区 */
.chat {
  flex: 1;
  padding: 24rpx 24rpx 0;
  min-height: 0;
}

.chat-bottom {
  height: 24rpx;
}

.msg {
  display: flex;
  align-items: flex-start;
  margin-bottom: 28rpx;
}

.msg-me {
  flex-direction: row-reverse;
}

.msg-ava {
  width: 68rpx;
  height: 68rpx;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 28rpx;
  font-weight: 700;
  flex: none;
  background: #3f7a45;
  color: #ffffff;
  margin-right: 16rpx;
}

.msg-me .msg-ava {
  background: #eadfce;
  color: #6b5a45;
  margin-right: 0;
  margin-left: 16rpx;
}

.msg-body {
  max-width: 78%;
}

.bubble {
  padding: 22rpx 24rpx;
  background: #ffffff;
  border: 2rpx solid rgba(139, 90, 43, 0.14);
  border-radius: 20rpx 20rpx 20rpx 6rpx;
}

.msg-me .bubble {
  background: #3f7a45;
  border-color: #3f7a45;
  border-radius: 20rpx 20rpx 6rpx 20rpx;
}

.bubble-text {
  display: block;
  font-size: 36rpx;
  line-height: 1.7;
  color: #2d241a;
}

.msg-me .bubble-text {
  color: #ffffff;
}

.msg-meta {
  display: block;
  margin-top: 8rpx;
  font-size: 28rpx;
  color: #a79b8b;
  text-align: right;
}

/* 选项 */
.opts {
  margin-top: 20rpx;
  display: flex;
  flex-direction: column;
}

.opt {
  min-height: 88rpx;
  display: flex;
  align-items: center;
  padding: 0 24rpx;
  margin-bottom: 14rpx;
  font-size: 36rpx;
  color: #3f3a30;
  background: #fdf8ee;
  border: 2rpx solid rgba(139, 90, 43, 0.18);
  border-radius: 14rpx;
}

.opt-on {
  color: #3f7a45;
  background: #ecf2e6;
  border-color: #3f7a45;
  font-weight: 600;
}

/* 菜品卡 */
.cards {
  margin-top: 20rpx;
}

.card {
  padding: 22rpx 24rpx;
  margin-bottom: 18rpx;
  background: #fdf8ee;
  border: 2rpx solid rgba(139, 90, 43, 0.16);
  border-left: 8rpx solid #3f7a45;
  border-radius: 14rpx;
}

.card-head {
  display: flex;
  align-items: baseline;
  justify-content: space-between;
}

.card-name {
  font-size: 38rpx;
  font-weight: 700;
  color: #2d241a;
}

.card-tag {
  font-size: 28rpx;
  color: #8b7a5b;
  background: rgba(139, 90, 43, 0.08);
  padding: 4rpx 12rpx;
  border-radius: 8rpx;
}

.card-meta {
  display: block;
  margin-top: 6rpx;
  font-size: 30rpx;
  color: #8b7a5b;
}

.card-row {
  display: flex;
  align-items: flex-start;
  margin-top: 12rpx;
  padding-top: 12rpx;
  border-top: 2rpx dashed rgba(139, 90, 43, 0.14);
}

.card-label {
  flex: none;
  width: 84rpx;
  font-size: 30rpx;
  color: #8b7a5b;
  line-height: 1.6;
}

.card-text {
  flex: 1;
  font-size: 34rpx;
  line-height: 1.6;
  color: #3f3a30;
}

/* 打字中 */
.typing {
  display: flex;
  margin-bottom: 12rpx;
}

.dot {
  width: 12rpx;
  height: 12rpx;
  border-radius: 50%;
  background: #b9ab98;
  margin-right: 10rpx;
  animation: bounce 1.1s infinite;
}

.dot:nth-child(2) { animation-delay: 0.15s; }
.dot:nth-child(3) { animation-delay: 0.3s; }

@keyframes bounce {
  0%, 60%, 100% { transform: translateY(0); opacity: 0.5; }
  30% { transform: translateY(-8rpx); opacity: 1; }
}

.typing-text {
  color: #6b5a45;
}

/* 底部 */
.foot {
  padding: 16rpx 24rpx 24rpx;
  background: rgba(247, 240, 225, 0.97);
  border-top: 2rpx solid rgba(139, 90, 43, 0.12);
}

.foot-multi {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.foot-hint {
  font-size: 32rpx;
  color: #8b7a5b;
  flex: 1;
}

.foot-btn {
  min-width: 200rpx;
  min-height: 88rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 36rpx;
  font-weight: 600;
  color: #ffffff;
  background: #3f7a45;
  border-radius: 14rpx;
}

.foot-progress {
  padding: 8rpx 0;
}

.foot-progress-text {
  font-size: 30rpx;
  color: #8b7a5b;
}

.foot-note {
  padding: 8rpx 0;
}

.foot-note-text {
  font-size: 30rpx;
  color: #8b7a5b;
}