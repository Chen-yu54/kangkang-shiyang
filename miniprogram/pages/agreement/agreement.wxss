/* pages/agreement/agreement.wxss —— 协议页排版，取 app.wxss 变量 */

.doc-title {
  display: block;
  padding: 8rpx 0 12rpx;
  font-family: var(--font-sans);
  font-size: var(--font-title);
  color: var(--color-ink);
}

.doc-meta {
  display: flex;
  flex-wrap: wrap;
  padding-bottom: 24rpx;
  border-bottom: 2rpx solid var(--color-border-hair);
}

.doc-meta-text {
  margin-right: 24rpx;
  font-size: var(--font-btn);
  color: var(--color-ink-3);
}

.doc-sec {
  margin-top: 32rpx;
}

.doc-h {
  display: block;
  margin-bottom: 12rpx;
  font-size: var(--font-base);
  font-weight: 600;
  color: var(--color-ink);
}

.doc-p {
  display: block;
  margin-bottom: 12rpx;
  font-size: var(--font-base);
  line-height: 1.85;
  color: var(--color-ink-2);
  text-align: justify;
}

.doc-end {
  margin-top: 48rpx;
  padding-top: 24rpx;
  border-top: 2rpx solid var(--color-border-hair);
}

.doc-end-text {
  font-size: var(--font-btn);
  color: var(--color-ink-3);
}
