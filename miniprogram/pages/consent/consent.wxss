/* 数据分享说明页：米黄纸感底 + 大字号 + 88rpx 点击区。
   两个操作按钮同尺寸，拒绝不做小字弱化。 */
.page {
  min-height: 100vh;
  background: #FBF8F2;
}

.content {
  padding: 40rpx 32rpx 120rpx;
}

.doc-title {
  display: block;
  font-size: var(--font-title);
  font-weight: 600;
  color: #1E1E1A;
  letter-spacing: 0.02em;
}

.doc-lead {
  display: block;
  margin-top: 16rpx;
  font-size: var(--font-base);
  line-height: 1.6;
  color: #4A463C;
}

/* 说明卡：同意项用墨绿边，不分享项用棕色边，颜色 + 文字双通道 */
.ex-card {
  margin-top: 24rpx;
  padding: 24rpx 26rpx;
  background: #FFFFFF;
  border-radius: 16rpx;
  border-left: 8rpx solid #1F4A36;
}

.ex-card.ex-yes {
  border-left-color: #1F4A36;
}

.ex-card.ex-no {
  border-left-color: #1F4A36;
}

.ex-label {
  display: block;
  font-size: var(--font-base);
  font-weight: 600;
  color: #1E1E1A;
  margin-bottom: 10rpx;
}

.ex-body {
  display: block;
  font-size: var(--font-base);
  line-height: 1.6;
  color: #4A463C;
}

.region {
  margin-top: 40rpx;
  padding: 26rpx;
  background: #FFFFFF;
  border: 2rpx solid rgba(31, 74, 54, 0.16);
  border-radius: 16rpx;
}

.region-title {
  display: block;
  font-size: var(--font-base);
  font-weight: 600;
  color: #1F4A36;
  margin-bottom: 16rpx;
}

.region-label {
  display: block;
  font-size: var(--font-btn);
  color: #6E6A5E;
  margin: 16rpx 0 12rpx;
}

.chip-row {
  display: flex;
  flex-wrap: wrap;
}

/* 社区名单还没补齐时的说明，不做假选项 */
.region-note {
  display: block;
  margin-top: 12rpx;
  font-size: var(--font-caption);
  line-height: 1.6;
  color: #6E6A5E;
}

/* 点击区 ≥88rpx 高 */
.chip {
  min-height: 88rpx;
  display: flex;
  align-items: center;
  padding: 0 28rpx;
  margin: 0 16rpx 16rpx 0;
  font-size: var(--font-base);
  color: #4A463C;
  background: rgba(31, 74, 54, 0.08);
  border: 2rpx solid transparent;
  border-radius: 12rpx;
}

.chip-on {
  color: #1F4A36;
  background: #FAF1ED;
  border-color: #1F4A36;
  font-weight: 600;
}

/* 共享给谁：两个开关，整行可点，高 96rpx */
.scope {
  margin-top: 24rpx;
  padding: 26rpx;
  background: #FFFFFF;
  border: 2rpx solid rgba(31, 74, 54, 0.16);
  border-radius: 16rpx;
}

.scope-title {
  display: block;
  font-size: var(--font-base);
  font-weight: 600;
  color: #1F4A36;
}

.scope-hint {
  display: block;
  margin-top: 8rpx;
  font-size: var(--font-btn);
  line-height: 1.6;
  color: #6E6A5E;
}

.sw {
  display: flex;
  align-items: center;
  min-height: 96rpx;
  margin-top: 16rpx;
  padding: 16rpx 20rpx;
  box-sizing: border-box;
  background: #FAF8F3;
  border: 2rpx solid rgba(31, 74, 54, 0.12);
  border-radius: 14rpx;
}

.sw-on {
  background: rgba(31, 74, 54, 0.06);
  border-color: rgba(31, 74, 54, 0.4);
}

/* 方形勾选框：40rpx 视觉框 + 勾，靠整行点击区保证好按 */
.sw-box {
  flex: none;
  width: 44rpx;
  height: 44rpx;
  margin-right: 20rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  box-sizing: border-box;
  background: #FFFFFF;
  border: 3rpx solid rgba(31, 74, 54, 0.35);
  border-radius: 10rpx;
}

.sw-on .sw-box {
  background: #1F4A36;
  border-color: #1F4A36;
}

.sw-tick {
  font-size: 28rpx;
  line-height: 1;
  color: #FFFFFF;
}

.sw-main {
  flex: 1;
  min-width: 0;
}

.sw-name {
  display: block;
  font-size: var(--font-base);
  font-weight: 600;
  color: #1E1E1A;
}

.sw-sub {
  display: block;
  margin-top: 4rpx;
  font-size: var(--font-caption);
  line-height: 1.5;
  color: #6E6A5E;
}

.sw-state {
  flex: none;
  margin-left: 16rpx;
  font-size: var(--font-caption);
  color: #6E6A5E;
}

.sw-on .sw-state {
  color: #1F4A36;
  font-weight: 600;
}

.actions {
  margin-top: 40rpx;
}.btn {
  min-height: 96rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 16rpx;
  font-size: var(--font-base);
  font-weight: 600;
}

/* 主按钮：深色底 + 白字（唯一满足 4.5:1 的组合） */
.btn-primary {
  background: #1F4A36;
  color: #ffffff;
}

/* 拒绝按钮：同样尺寸，只换底色，不弱化 */
.btn-quiet {
  margin-top: 20rpx;
  background: #ffffff;
  color: #1F4A36;
  border: 2rpx solid rgba(31, 74, 54, 0.4);
}

.actions-hint {
  display: block;
  margin-top: 16rpx;
  font-size: var(--font-btn);
  line-height: 1.6;
  color: #6E6A5E;
  text-align: center;
}

.state-box {
  margin-top: 40rpx;
  padding: 32rpx 26rpx;
  background: #FFFFFF;
  border: 2rpx solid rgba(31, 74, 54, 0.16);
  border-radius: 16rpx;
}

.state-text {
  display: block;
  font-size: var(--font-base);
  line-height: 1.6;
  color: #1E1E1A;
}

.state-sub {
  display: block;
  margin-top: 8rpx;
  font-size: var(--font-btn);
  line-height: 1.6;
  color: #1F4A36;
}