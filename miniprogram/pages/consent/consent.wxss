/* 数据分享说明页：米黄纸感底 + 大字号 + 88rpx 点击区。
   两个操作按钮同尺寸，拒绝不做小字弱化。 */
.page {
  min-height: 100vh;
  background: #FBF8F2;
}

.content {
  padding: 40rpx 32rpx 120rpx;
}

.doc-title {
  display: block;
  font-size: var(--font-title);
  font-weight: 700;
  color: #1E1E1A;
  letter-spacing: 2rpx;
}

.doc-lead {
  display: block;
  margin-top: 16rpx;
  font-size: var(--font-base);
  line-height: 1.7;
  color: #4A463C;
}

/* 说明卡：同意项用墨绿边，不分享项用棕色边，颜色 + 文字双通道 */
.ex-card {
  margin-top: 24rpx;
  padding: 24rpx 26rpx;
  background: #FFFFFF;
  border-radius: 16rpx;
  border-left: 8rpx solid #B5482A;
}

.ex-card.ex-yes {
  border-left-color: #B5482A;
}

.ex-card.ex-no {
  border-left-color: #B5482A;
}

.ex-label {
  display: block;
  font-size: var(--font-base);
  font-weight: 600;
  color: #1E1E1A;
  margin-bottom: 10rpx;
}

.ex-body {
  display: block;
  font-size: var(--font-base);
  line-height: 1.7;
  color: #4A463C;
}

.region {
  margin-top: 40rpx;
  padding: 26rpx;
  background: #FFFFFF;
  border: 2rpx solid rgba(181, 72, 42, 0.16);
  border-radius: 16rpx;
}

.region-title {
  display: block;
  font-size: var(--font-base);
  font-weight: 600;
  color: #B5482A;
  margin-bottom: 16rpx;
}

.region-label {
  display: block;
  font-size: var(--font-btn);
  color: #6E6A5E;
  margin: 16rpx 0 12rpx;
}

.chip-row {
  display: flex;
  flex-wrap: wrap;
}

/* 点击区 ≥88rpx 高 */
.chip {
  min-height: 88rpx;
  display: flex;
  align-items: center;
  padding: 0 28rpx;
  margin: 0 16rpx 16rpx 0;
  font-size: var(--font-base);
  color: #4A463C;
  background: rgba(181, 72, 42, 0.08);
  border: 2rpx solid transparent;
  border-radius: 12rpx;
}

.chip-on {
  color: #B5482A;
  background: #FAF1ED;
  border-color: #B5482A;
  font-weight: 600;
}

.actions {
  margin-top: 40rpx;
}

.btn {
  min-height: 96rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 16rpx;
  font-size: var(--font-base);
  font-weight: 600;
}

/* 主按钮：深色底 + 白字（唯一满足 4.5:1 的组合） */
.btn-primary {
  background: #B5482A;
  color: #ffffff;
}

/* 拒绝按钮：同样尺寸，只换底色，不弱化 */
.btn-quiet {
  margin-top: 20rpx;
  background: #ffffff;
  color: #B5482A;
  border: 2rpx solid rgba(31, 74, 54, 0.4);
}

.actions-hint {
  display: block;
  margin-top: 16rpx;
  font-size: var(--font-btn);
  line-height: 1.6;
  color: #6E6A5E;
  text-align: center;
}

.state-box {
  margin-top: 40rpx;
  padding: 32rpx 26rpx;
  background: #FFFFFF;
  border: 2rpx solid rgba(181, 72, 42, 0.16);
  border-radius: 16rpx;
}

.state-text {
  display: block;
  font-size: var(--font-base);
  line-height: 1.7;
  color: #1E1E1A;
}