<!-- page-meta 必须是页面第一个节点，一页只能有一个 -->
<page-meta page-style="{{pageStyle}}" />

<view class="page">
  <view class="content">

    <!-- ① 前置同意页：三个开关默认全关 -->
    <block wx:if="{{showIntro}}">
      <view class="intro-head">
        <text class="intro-title">{{copy.introTitle}}</text>
        <text class="intro-desc">{{copy.introDesc}}</text>
      </view>

      <view class="switch-list">
        <view class="switch-row">
          <view class="switch-text">
            <text class="switch-title">{{copy.switchRecord}}</text>
            <text class="switch-desc">{{copy.switchRecordDesc}}</text>
          </view>
          <switch checked="{{switches.record}}" data-key="record" bindchange="onSwitchChange" />
        </view>

        <view class="switch-row">
          <view class="switch-text">
            <text class="switch-title">{{copy.switchRecommend}}</text>
            <text class="switch-desc">{{copy.switchRecommendDesc}}</text>
          </view>
          <switch checked="{{switches.recommend}}" data-key="recommend" bindchange="onSwitchChange" />
        </view>

        <view class="switch-row switch-row-off">
          <view class="switch-text">
            <text class="switch-title">{{copy.switchRemind}}</text>
            <text class="switch-desc">{{copy.switchRemindDesc}}</text>
          </view>
          <switch checked="{{false}}" disabled />
        </view>
      </view>

      <text class="switch-hint">{{copy.switchHint}}</text>

      <view class="btn-primary" hover-class="tap-hover" bindtap="onStart">{{copy.start}}</view>
    </block>

    <!-- ② 答题 -->
    <block wx:else>
      <view class="intro" wx:if="{{step === 0}}">
        <text class="intro-text">{{copy.intro}}</text>
      </view>

      <!-- 进度：1 / 5 -->
      <view class="progress">
        <text class="progress-text">{{progressText}}</text>
        <view class="progress-bar">
          <view class="progress-fill" style="width: {{(step + 1) * 100 / total}}%"></view>
        </view>
      </view>

      <view wx:if="{{questions[step]}}" class="question">
        <text class="question-title">{{questions[step].title}}</text>
        <text wx:if="{{questions[step].multiple}}" class="question-hint">{{questions[step].multipleHint}}</text>

        <view
          class="option {{item.on ? 'option-active' : ''}}"
          wx:for="{{curOptions}}"
          wx:key="value"
          data-value="{{item.value}}"
          hover-class="tap-hover"
          bindtap="onSelect"
        >
          <text class="option-text">{{item.label}}</text>
          <!-- 多选回显：勾选标记，不只靠底色区分（色觉异常也能看出选中） -->
          <text wx:if="{{questions[step].multiple && item.on}}" class="option-check">已选</text>
        </view>
      </view>

      <view class="actions">
        <view wx:if="{{step > 0}}" class="prev-btn" hover-class="tap-hover" bindtap="onPrev">
          <text class="prev-text">{{copy.prev}}</text>
        </view>
        <!-- 多选题不自动跳题，给一个明确的推进按钮；
             未选时按钮常显但置灰，点一下给「至少选一项」提示，避免按钮忽隐忽现把握不住 -->
        <view
          wx:if="{{questions[step].multiple}}"
          class="next-btn {{selected.length ? '' : 'next-btn-off'}}"
          hover-class="tap-hover"
          bindtap="onNext"
        >
          <text class="next-text">{{step === total - 1 ? copy.finish : copy.next}}</text>
        </view>
      </view>
    </block>
  </view>

  <disclaimer text="{{copy.disclaimer}}" />
</view>
