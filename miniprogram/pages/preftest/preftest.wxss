/* pages/preftest/preftest.wxss —— 偏好测试页样式，全部取 app.wxss 的 CSS 变量 */

.intro {
  padding: 16rpx 0 24rpx;
}

.intro-text {
  font-size: var(--font-base);
  line-height: 1.6;
  color: var(--color-ink);
}

.progress {
  margin-bottom: 32rpx;
}

.progress-text {
  display: block;
  margin-bottom: 12rpx;
  font-size: var(--font-base);
  color: var(--color-ink);
}

.progress-bar {
  width: 100%;
  height: 16rpx;
  border-radius: var(--radius-card);
  background-color: var(--color-skeleton);
  overflow: hidden;
}

.progress-fill {
  height: 100%;
  background-color: var(--color-brand);
  transition: width 0.2s ease;
}

.question-title {
  display: block;
  margin-bottom: 24rpx;
  font-size: var(--font-title);
  line-height: 1.5;
  color: var(--color-ink);
}

.option {
  display: flex;
  align-items: center;
  min-height: var(--tap-min);
  padding: 20rpx 28rpx;
  margin-bottom: 20rpx;
  border: 2rpx solid var(--color-border);
  border-radius: var(--radius-card);
  background-color: var(--color-card);
  box-shadow: var(--shadow-card);
  box-sizing: border-box;
}

.option-active {
  border-color: var(--color-brand);
}

.option-active .option-text {
  font-weight: 600;
}

.option-text {
  font-size: var(--font-base);
  color: var(--color-ink);
}



.prev-btn {
  display: flex;
  align-items: center;
  justify-content: center;
  min-height: var(--tap-min);
  padding: 0 32rpx;
  border: 2rpx solid var(--color-border);
  border-radius: var(--radius-card);
  background-color: var(--color-card);
  box-sizing: border-box;
}

.prev-text {
  font-size: var(--font-base);
  color: var(--color-ink);
}

.tap-hover {
  opacity: 0.82;
}

/* —— 前置同意页 —— */
.intro-head {
  padding: 8rpx 0 32rpx;
}

/* 问卷引导配图：放在标题上方，尺寸收着，别抢标题 */
.intro-art {
  display: block;
  width: 120rpx;
  height: 120rpx;
  margin-bottom: 20rpx;
  opacity: 0.9;
}

.intro-title {
  display: block;
  font-family: var(--font-sans);
  font-size: var(--font-title);
  color: var(--color-ink);
}

.intro-desc {
  display: block;
  margin-top: 12rpx;
  font-size: var(--font-base);
  line-height: 1.6;
  color: var(--color-ink-3);
}

.switch-list {
  border-top: 2rpx solid var(--color-border-hair);
}

/* 整行高度 112rpx，热区达标；右侧是原生 switch */
.switch-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  min-height: 112rpx;
  padding: 12rpx 0;
  border-bottom: 2rpx solid var(--color-border-hair);
  box-sizing: border-box;
}

.switch-row-off {
  opacity: 0.6;
}

.switch-text {
  flex: 1;
  margin-right: 16rpx;
}

.switch-title {
  display: block;
  font-size: var(--font-base);
  color: var(--color-ink);
}

.switch-desc {
  display: block;
  margin-top: 6rpx;
  font-size: var(--font-base);
  line-height: 1.5;
  color: var(--color-ink-3);
}

.switch-hint {
  display: block;
  margin-top: 24rpx;
  font-size: var(--font-base);
  line-height: 1.6;
  color: var(--color-ink-3);
}

/* 主按钮：实心，反白文字 */
.btn-primary {
  display: flex;
  align-items: center;
  justify-content: center;
  min-height: var(--tap-min);
  margin-top: 32rpx;
  border-radius: var(--radius-pill);
  background-color: var(--color-brand);
  font-size: var(--font-btn);
  color: var(--color-on-brand);
  box-sizing: border-box;
}
/* —— 多选支持：题型提示 / 选中勾标 / 推进按钮 ——
   选中态不能只靠底色（色觉异常看不出），额外给「已选」文字标记。 */

.question-hint {
  display: block;
  margin: -12rpx 0 20rpx;
  font-size: var(--font-btn);
  color: var(--color-ink-3);
}

.option-check {
  flex-shrink: 0;
  margin-left: 16rpx;
  padding: 4rpx 14rpx;
  border-radius: var(--radius-pill);
  background-color: var(--color-green-bg);
  font-size: var(--font-btn);
  color: var(--color-green-ink);
}

/* 上一题 + 下一题并排，各占一半，点击区都不小于 88rpx */
.actions {
  display: flex;
  margin-top: 16rpx;
}

.prev-btn + .next-btn {
  margin-left: 20rpx;
}

.next-btn {
  flex: 1;
  display: flex;
  align-items: center;
  justify-content: center;
  min-height: var(--tap-min);
  padding: 0 32rpx;
  border-radius: var(--radius-card);
  background-color: var(--color-green-deep);
  box-sizing: border-box;
}

.next-text {
  font-size: var(--font-base);
  font-weight: 600;
  color: var(--color-on-brand);
}

/* 未选任何项：按钮仍占位，只降不透明度，点击给提示 */
.next-btn-off {
  opacity: 0.42;
}

/* ===== C 主题 · 偏好测试 ===== */
.option {
  border: 1rpx solid var(--color-border);
  border-radius: 24rpx;
  background: #FFFFFF;
  box-shadow: 0 6rpx 18rpx rgba(30, 30, 26, 0.05);
}

.option-active {
  border-color: var(--color-green);
  background: var(--color-green-bg);
}

.progress-fill { background: var(--color-green); }

/* ============================================================
   C 主题 · 饮食偏好测试（2026-11-20）
   白卡同意区 + 绿色进度 + 单选圆点卡片 + 胶囊按钮
   ============================================================ */
.intro-head { padding: 16rpx 4rpx 28rpx; }

.intro-title {
  font-family: var(--font-sans);
  font-size: var(--font-title);
  font-weight: 600;
  line-height: 1.3;
  letter-spacing: 0.01em;
}

.intro-desc {
  margin-top: 12rpx;
  font-size: var(--font-caption);
  line-height: 1.65;
  color: var(--color-ink-2);
}

.switch-list {
  padding: 0 24rpx;
  border: none;
  border-radius: 28rpx;
  background: #FFFFFF;
  box-shadow: 0 8rpx 24rpx rgba(30, 30, 26, 0.05);
}

.switch-row {
  min-height: 120rpx;
  padding: 16rpx 0;
  border-bottom: 1rpx solid var(--color-border);
}

.switch-row:last-child { border-bottom: none; }

.switch-title { font-size: var(--font-btn); font-weight: 500; color: var(--color-ink); }
.switch-desc { margin-top: 6rpx; font-size: var(--font-micro); line-height: 1.5; color: var(--color-ink-3); }
.switch-hint { margin-top: 18rpx; font-size: var(--font-micro); color: var(--color-ink-3); }

.btn-primary {
  min-height: 96rpx;
  margin-top: 28rpx;
  border-radius: 999rpx;
  background-color: var(--color-green);
  font-size: var(--font-btn);
  font-weight: 500;
  box-shadow: 0 10rpx 24rpx rgba(31, 74, 54, 0.20);
}

.progress { margin: 8rpx 0 28rpx; }

.progress-text {
  margin-bottom: 10rpx;
  font-family: var(--font-sans);
  font-size: var(--font-micro);
  font-weight: 600;
  letter-spacing: 0.08em;
  color: var(--color-green);
}

.progress-bar {
  height: 8rpx;
  border-radius: 4rpx;
  background-color: #E8E3D8;
}

.progress-fill { border-radius: 4rpx; background-color: var(--color-green); }

.question-title {
  margin-bottom: 24rpx;
  font-size: var(--font-title);
  font-weight: 600;
  line-height: 1.35;
  letter-spacing: 0.01em;
}

.question-hint { margin: -12rpx 0 20rpx; font-size: var(--font-micro); }

.option {
  position: relative;
  min-height: 104rpx;
  padding: 22rpx 24rpx 22rpx 72rpx;
  margin-bottom: 12rpx;
  border: 1rpx solid var(--color-border);
  border-radius: 20rpx;
  background: #FFFFFF;
  box-shadow: none;
}

.option::before {
  content: '';
  position: absolute;
  left: 24rpx;
  top: 50%;
  width: 32rpx;
  height: 32rpx;
  margin-top: -16rpx;
  border: 2rpx solid var(--color-border);
  border-radius: 50%;
  background: #FFFFFF;
  box-sizing: border-box;
}

.option-active {
  border-color: var(--color-green);
  background: var(--color-green-bg);
}

.option-active::before {
  border-color: var(--color-green);
  background: var(--color-green);
  box-shadow: inset 0 0 0 8rpx #FFFFFF;
}

.option-text { font-size: var(--font-btn); line-height: 1.5; }
.option-active .option-text { font-weight: 600; color: var(--color-green); }

.option-check {
  padding: 3rpx 12rpx;
  border: 1rpx solid var(--color-green);
  border-radius: 999rpx;
  background: #FFFFFF;
  color: var(--color-green);
}

.prev-btn {
  border: 1rpx solid var(--color-border);
  border-radius: 999rpx;
  background: #FFFFFF;
  min-height: 88rpx;
}

.prev-text { font-size: var(--font-caption); color: var(--color-ink); }

.next-btn {
  border-radius: 999rpx;
  background-color: var(--color-green);
  min-height: 88rpx;
}

.next-text { font-size: var(--font-btn); }
.next-btn-off { background-color: #C9D6CE; }

