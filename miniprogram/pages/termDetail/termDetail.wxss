@import "../solarterm/solarterm.wxss";

/* pages/termDetail/termDetail.wxss —— 节气详情二级页
   五个板块（三候 / 习俗 / 养生 / 食材 / 菜品）直接复用节气页样式，
   保证两页视觉一套；这里只补本页独有的头部。 */

.td-head {
  padding: 8rpx 4rpx 4rpx;
  margin-bottom: 8rpx;
}

.td-kicker {
  display: inline-block;
  padding: 6rpx 20rpx;
  border-radius: 999rpx;
  background-color: var(--color-green-bg);
  color: var(--color-green);
  font-size: var(--font-micro);
  letter-spacing: 0.04em;
}

.td-title-row {
  display: flex;
  flex-wrap: wrap;
  align-items: baseline;
  margin-top: 16rpx;
}

.td-name {
  font-family: var(--font-sans);
  font-size: var(--font-title);
  font-weight: 600;
  color: var(--color-ink);
}

.td-window {
  margin-left: 16rpx;
  font-size: var(--font-base);
  color: var(--color-ink-2);
}

.td-sub {
  display: block;
  margin-top: 10rpx;
  font-size: var(--font-caption);
  line-height: 1.6;
  color: var(--color-ink-3);
}
