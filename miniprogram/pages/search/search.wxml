<!-- page-meta 必须是页面第一个节点，一页只能有一个 -->
<page-meta page-style="{{pageStyle}}" />

<view class="page">
  <view class="content">

    <view class="masthead">
      <text class="masthead-title">{{copy.masthead}}</text>
      <text class="masthead-no">{{copy.mastheadNo}}</text>
    </view>

    <!-- 搜索框 -->
    <view class="search-bar">
      <input
        class="search-input"
        value="{{keyword}}"
        placeholder="{{copy.placeholder}}"
        placeholder-class="search-placeholder"
        confirm-type="search"
        bindinput="onInput"
        bindconfirm="onConfirm"
      />
      <view wx:if="{{keyword}}" class="search-clear" hover-class="tap-hover" bindtap="onClear">
        <image class="search-clear-ico" src="/images/icons/mutong-jiancha.png" mode="aspectFit" />
      </view>
      <view class="voice-btn" hover-class="tap-hover" catchtap="onVoiceTap">
        <text class="voice-text">{{copy.voice}}</text>
      </view>
      <view class="search-btn" hover-class="tap-hover" bindtap="search">
        <text class="search-btn-text">{{copy.action}}</text>
      </view>
    </view>

    <!-- 未搜索：历史 + 当令推荐词 -->
    <block wx:if="{{!submitted}}">
      <view wx:if="{{history.length}}" class="section">
        <view class="section-head">
          <text class="section-label">{{copy.history}}</text>
          <text class="section-action" bindtap="onClearHistory">{{copy.clearHistory}}</text>
        </view>
        <view class="chip-row">
          <text
            class="chip"
            wx:for="{{history}}"
            wx:key="*this"
            data-word="{{item}}"
            hover-class="tap-hover"
            bindtap="onTapWord"
          >{{item}}</text>
        </view>
      </view>

      <view wx:if="{{hotWords.length}}" class="section">
        <text class="section-label">{{copy.hot}}</text>
        <view class="chip-row">
          <text
            class="chip"
            wx:for="{{hotWords}}"
            wx:key="*this"
            data-word="{{item}}"
            hover-class="tap-hover"
            bindtap="onTapWord"
          >{{item}}</text>
        </view>
      </view>

      <view wx:if="{{!history.length && !hotWords.length}}" class="state-box">
        <text class="state-text">{{copy.emptyKeyword}}</text>
      </view>
    </block>

    <!-- 已搜索：结果三态 -->
    <block wx:else>
      <loading wx:if="{{status === 'loading'}}" type="skeleton" />

      <empty-state wx:elif="{{status === 'empty'}}" text="{{copy.empty}}" />

      <view wx:elif="{{status === 'error'}}" class="state-box">
        <image class="state-icon" src="/images/icons/state-error.png" mode="aspectFit" />
        <text class="state-text">{{copy.failed}}</text>
        <view class="btn" hover-class="tap-hover" bindtap="onRetry">{{copy.retry}}</view>
      </view>

      <block wx:else>
        <text class="count-text">{{countText}}</text>
        <dish-card
          wx:for="{{results}}"
          wx:key="id"
          dish="{{item}}"
          faved="{{item.faved}}"
          bind:cardtap="onTapDish"
          bind:favoritetap="onFavoriteTap"
        />
      </block>
    </block>
  </view>

  <disclaimer />
</view>
