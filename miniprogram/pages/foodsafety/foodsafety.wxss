/* pages/foodsafety/foodsafety.wxss —— 食品安全
 *
 * 改版说明：这一页从「报告数据」改成「教人怎么买」，
 * 首屏加 hero 卡片，食材从条形换成带要点的卡，新增三句话与避雷清单。
 *
 * 视觉基线沿用「食材档案」：米黄纸底、宋体标题、细描边卡片，
 * 图标直接用 images/ingredients 那套插画，不新画一套笔触。
 *
 * ── 两条收敛纪律 ──
 * 1. 字号只用 8 档，全部有来源，不再临时取值：
 *      64rpx  --font-display   页头主标题
 *      56rpx  数据大字         概览四格（页面唯一专属档）
 *      48rpx  --font-title     栏目标题
 *      40rpx  --font-subtitle  首屏标题、序号大字
 *      36rpx  --font-base      正文
 *      32rpx  --font-btn       按钮、二级标题
 *      28rpx  --font-caption   辅助说明、标签
 *      24rpx  极小标           序号圆圈、日期、刻度
 * 2. 颜色只用 app.wxss 的变量，页面内不写任何十六进制或 rgba。
 *    层级靠「字号 + 字重 + 墨色深浅」区分，不靠加新颜色。
 */

.page {
  min-height: 100vh;
  background: var(--color-bg);
}

.content {
  padding: 40rpx 32rpx 120rpx;
}

/* ─────────── 页头 ─────────── */
.head {
  padding: 8rpx 0 32rpx;
  border-bottom: 2rpx solid var(--color-border-hair);
}

.head-kicker {
  display: inline-block;
  font-size: var(--font-caption);
  letter-spacing: 0.02em;
  color: var(--color-ink-2);
  background: var(--color-border-hair);
  padding: 6rpx 20rpx;
  border-radius: 8rpx;
}

.head-title {
  display: block;
  margin-top: 24rpx;
  font-family: var(--font-sans);
  font-size: var(--font-display);
  letter-spacing: 0.08em;
  line-height: 1.1;
  color: var(--color-ink);
}

.head-lead {
  display: block;
  margin-top: 24rpx;
  font-size: var(--font-base);
  line-height: 1.6;
  color: var(--color-ink-2);
}

.head-meta {
  display: flex;
  align-items: center;
  margin-top: 24rpx;
}

.head-meta-item {
  font-size: var(--font-caption);
  color: var(--color-ink-3);
}

.head-meta-dot {
  width: 6rpx;
  height: 6rpx;
  border-radius: 50%;
  background: var(--color-ink-3);
  margin: 0 16rpx;
}

/* ─────────── 首屏：一餐安心饭 ─────────── */
.hero {
  margin-top: 36rpx;
  padding: 32rpx;
  background: var(--color-card);
  border: 2rpx solid var(--color-border-hair);
  border-radius: var(--radius-card);
  box-shadow: var(--shadow-card);
}

.hero-kicker {
  display: block;
  font-size: var(--font-caption);
  letter-spacing: 0.02em;
  color: var(--color-flame);
}

.hero-title {
  display: block;
  margin-top: 12rpx;
  font-family: var(--font-sans);
  font-size: var(--font-subtitle);
  letter-spacing: 0.02em;
  color: var(--color-ink);
}

.hero-text {
  display: block;
  margin-top: 12rpx;
  font-size: var(--font-base);
  line-height: 1.6;
  color: var(--color-ink-2);
}

.steps {
  display: flex;
  margin-top: 28rpx;
}

.step {
  flex: 1;
  padding: 20rpx 12rpx;
  text-align: center;
  background: var(--color-border-hair);
  border-radius: var(--radius-small);
  margin-right: 16rpx;
}

.step:last-child {
  margin-right: 0;
}

.step-n {
  display: inline-block;
  width: 36rpx;
  height: 36rpx;
  line-height: 36rpx;
  text-align: center;
  border-radius: 50%;
  background: var(--color-flame);
  color: var(--color-on-brand);
  font-size: var(--font-micro);
}

.step-t {
  display: block;
  margin-top: 10rpx;
  font-size: var(--font-btn);
  font-weight: 600;
  color: var(--color-ink);
}

.step-d {
  display: block;
  margin-top: 4rpx;
  font-size: var(--font-caption);
  line-height: 1.6;
  color: var(--color-ink-3);
}

/* 主按钮：深底白字，点击区 96rpx */
.hero-cta {
  display: flex;
  align-items: center;
  justify-content: center;
  min-height: 96rpx;
  margin-top: 28rpx;
  background: var(--color-flame);
  color: var(--color-on-brand);
  font-size: var(--font-btn);
  letter-spacing: 0.02em;
  border-radius: var(--radius-small);
}

.hero-sub {
  display: block;
  margin-top: 16rpx;
  text-align: center;
  font-size: var(--font-caption);
  line-height: 1.6;
  color: var(--color-ink-3);
}

/* ─────────── 区块通用 ─────────── */
.sec {
  margin-top: 64rpx;
}

.sec-head {
  display: flex;
  align-items: center;
  margin-bottom: 24rpx;
}

.sec-ico {
  width: 56rpx;
  height: 56rpx;
  margin-right: 18rpx;
  flex: none;
}

.sec-main {
  display: flex;
  align-items: baseline;
}

.sec-no {
  font-family: var(--font-sans);
  font-size: var(--font-caption);
  color: var(--color-on-brand);
  background: var(--color-flame);
  border-radius: 8rpx;
  padding: 4rpx 16rpx;
  margin-right: 16rpx;
}

.sec-title {
  font-family: var(--font-sans);
  font-size: var(--font-title);
  letter-spacing: 0.04em;
  color: var(--color-ink);
}

.sec-intro {
  display: block;
  margin-bottom: 28rpx;
  font-size: var(--font-base);
  line-height: 1.6;
  color: var(--color-ink-2);
}

.sec-foot {
  display: block;
  margin-top: 20rpx;
  font-size: var(--font-caption);
  line-height: 1.6;
  color: var(--color-ink-3);
}

/* 二级小标题：靠宋体 + 字重区分，不靠放大 */
.subhead {
  display: block;
  margin: 40rpx 0 20rpx;
  font-family: var(--font-sans);
  font-size: var(--font-btn);
  font-weight: 600;
  letter-spacing: 0.02em;
  color: var(--color-ink);
}

.subhead-row {
  margin: 40rpx 0 20rpx;
}

.subhead-row .subhead {
  margin: 0 0 6rpx;
}

.sub-note {
  display: block;
  font-size: var(--font-caption);
  letter-spacing: 0;
  color: var(--color-ink-3);
}

/* 一句话结论：加深边框和字色以示强调，不引新底色 */
.oneline {
  margin-bottom: 32rpx;
  padding: 24rpx 28rpx;
  background: var(--color-card);
  border: 2rpx solid var(--color-border);
  border-left: 6rpx solid var(--color-flame);
  border-radius: var(--radius-small);
}

.oneline-t {
  font-size: var(--font-base);
  font-weight: 600;
  color: var(--color-flame);
}

.oneline-b {
  font-size: var(--font-base);
  line-height: 1.6;
  color: var(--color-ink);
}

/* ─────────── 概览四格：两列 ─────────── */
/* 与食材卡同一个坑：宽度顶满 100% 再叠加右边距会被挤成一行一个，
   改用 space-between 分配间距，宽度留一点余量 */
.ov {
  display: flex;
  flex-wrap: wrap;
  justify-content: space-between;
}

.ov-item {
  width: calc(50% - 12rpx);
  padding: 24rpx 28rpx 22rpx;
  box-sizing: border-box;
  background: var(--color-card);
  border: 2rpx solid var(--color-border-hair);
  border-radius: var(--radius-small);
  margin-bottom: 16rpx;
}

.ov-num-row {
  display: flex;
  align-items: baseline;
}

.ov-num {
  font-family: var(--font-sans);
  font-size: 56rpx;
  line-height: 1.1;
  color: var(--color-ink);
}

.ov-unit {
  font-size: var(--font-caption);
  color: var(--color-ink-3);
  margin-left: 6rpx;
}

.ov-label {
  display: block;
  margin-top: 8rpx;
  font-size: var(--font-caption);
  color: var(--color-ink-3);
}

/* ─────────── 横向条 ─────────── */
.bar {
  margin-bottom: 24rpx;
}

.bar-top {
  display: flex;
  align-items: baseline;
  justify-content: space-between;
  margin-bottom: 10rpx;
}

.bar-name {
  flex: 1;
  font-size: var(--font-base);
  color: var(--color-ink-2);
}

.bar-val {
  flex: none;
  margin-left: 16rpx;
  font-size: var(--font-caption);
  color: var(--color-ink-3);
}

.bar-track {
  height: 14rpx;
  background: var(--color-border-hair);
  border-radius: 8rpx;
  overflow: hidden;
}

.bar-fill {
  height: 100%;
  background: var(--color-gold);
  border-radius: 8rpx;
}

/* ─────────── 抽检环节 ─────────── */
.chip-row {
  display: flex;
  align-items: baseline;
  justify-content: space-between;
  padding: 20rpx 24rpx;
  margin-bottom: 16rpx;
  background: var(--color-card);
  border: 2rpx solid var(--color-border-hair);
  border-radius: var(--radius-small);
}

.chip {
  font-size: var(--font-base);
  color: var(--color-ink-2);
}

.chip-n {
  font-size: var(--font-caption);
  color: var(--color-ink-3);
}

/* ─────────── 食材卡（带要点）：固定两列 ─────────── */
/* 用 space-between + 略小于 50% 的宽度，避免 rpx→px 取整后两列超出 100%
   而被挤成一行一个（旧写法 calc(50% - 8rpx) 加 16rpx 右边距正好顶满） */
.ingrid {
  display: flex;
  flex-wrap: wrap;
  justify-content: space-between;
}

.ing {
  width: calc(50% - 12rpx);
  padding: 24rpx 24rpx 20rpx;
  margin-bottom: 16rpx;
  box-sizing: border-box;
  background: var(--color-card);
  border: 2rpx solid var(--color-border-hair);
  border-radius: var(--radius-small);
}

.ing-top {
  display: flex;
  align-items: baseline;
  justify-content: space-between;
}

.ing-name {
  font-size: var(--font-base);
  font-weight: 600;
  color: var(--color-ink);
}

.ing-n {
  font-size: var(--font-caption);
  color: var(--color-flame);
  white-space: nowrap;
}

.ing-tip {
  display: block;
  margin-top: 12rpx;
  font-size: var(--font-caption);
  line-height: 1.6;
  color: var(--color-ink-2);
}

.ing-bar {
  height: 8rpx;
  margin-top: 16rpx;
  background: var(--color-border-hair);
  border-radius: 6rpx;
  overflow: hidden;
}

.ing-fill {
  height: 100%;
  background: var(--color-flame);
  border-radius: 6rpx;
}

/* ─────────── 月度分布（折叠）─────────── */
.fold {
  margin-top: 28rpx;
  padding: 0 24rpx;
  background: var(--color-card);
  border: 2rpx solid var(--color-border-hair);
  border-radius: var(--radius-small);
}

.fold-head {
  display: flex;
  align-items: center;
  min-height: 96rpx;
}

.fold-sign {
  font-size: var(--font-caption);
  color: var(--color-ink-3);
  margin-right: 12rpx;
}

.fold-title {
  font-size: var(--font-base);
  color: var(--color-ink-2);
}

.fold-note {
  display: block;
  margin: 4rpx 0 20rpx;
  font-size: var(--font-caption);
  line-height: 1.6;
  color: var(--color-ink-3);
}

.chart {
  display: flex;
  align-items: flex-end;
  height: 264rpx;
  padding: 0 4rpx 24rpx;
}

.col {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  height: 100%;
}

.col-bar-wrap {
  flex: 1;
  width: 100%;
  display: flex;
  align-items: flex-end;
}

.col-bar {
  width: 100%;
  background: var(--color-gold);
  border-radius: 6rpx 6rpx 0 0;
  min-height: 4rpx;
}

.col-n {
  margin-top: 8rpx;
  font-size: var(--font-micro);
  color: var(--color-ink-3);
}

.col-x {
  margin-top: 2rpx;
  font-size: var(--font-micro);
  color: var(--color-ink-3);
}

/* ─────────── 三句话 ─────────── */
.take {
  display: flex;
  align-items: flex-start;
  padding: 28rpx 28rpx 24rpx;
  margin-bottom: 20rpx;
  background: var(--color-card);
  border: 2rpx solid var(--color-border-hair);
  border-radius: var(--radius-small);
}

.take-n {
  flex: none;
  width: 56rpx;
  font-family: var(--font-sans);
  font-size: var(--font-subtitle);
  line-height: 1.1;
  color: var(--color-flame);
}

.take-body {
  flex: 1;
}

.take-t {
  display: block;
  font-size: var(--font-base);
  font-weight: 600;
  line-height: 1.6;
  color: var(--color-ink);
}

.take-d {
  display: block;
  margin-top: 10rpx;
  font-size: var(--font-caption);
  line-height: 1.6;
  color: var(--color-ink-2);
}

/* ─────────── 避雷清单 ─────────── */
.check-item {
  display: flex;
  align-items: flex-start;
  padding: 24rpx 28rpx;
  margin-bottom: 16rpx;
  background: var(--color-card);
  border: 2rpx solid var(--color-border-hair);
  border-radius: var(--radius-small);
}

.check-no {
  flex: none;
  width: 44rpx;
  height: 44rpx;
  line-height: 44rpx;
  margin-right: 20rpx;
  text-align: center;
  border-radius: 50%;
  background: var(--color-flame);
  color: var(--color-on-brand);
  font-size: var(--font-micro);
  font-weight: 600;
}

.check-body {
  flex: 1;
}

.check-t {
  display: block;
  font-size: var(--font-base);
  font-weight: 600;
  color: var(--color-ink);
}

.check-d {
  display: block;
  margin-top: 6rpx;
  font-size: var(--font-caption);
  line-height: 1.6;
  color: var(--color-ink-2);
}

/* ─────────── 通告 ─────────── */
.notice {
  padding: 24rpx 28rpx;
  margin-bottom: 20rpx;
  background: var(--color-card);
  border: 2rpx solid var(--color-border-hair);
  border-left: 6rpx solid var(--color-gold);
  border-radius: var(--radius-small);
}

.notice-top {
  display: flex;
  justify-content: space-between;
  align-items: baseline;
}

.notice-no,
.notice-date {
  font-size: var(--font-caption);
  color: var(--color-ink-3);
}

.notice-title {
  display: block;
  margin-top: 12rpx;
  font-size: var(--font-base);
  line-height: 1.6;
  color: var(--color-ink);
}

.notice-count {
  display: block;
  margin-top: 10rpx;
  font-size: var(--font-caption);
  color: var(--color-flame);
}

/* ─────────── 处罚案例 ─────────── */
.case {
  padding: 28rpx;
  margin-bottom: 24rpx;
  background: var(--color-card);
  border: 2rpx solid var(--color-border-hair);
  border-left: 6rpx solid var(--color-flame);
  border-radius: var(--radius-small);
}

.case-top {
  display: flex;
  align-items: baseline;
  justify-content: space-between;
}

.case-doc {
  flex: 1;
  font-size: var(--font-caption);
  color: var(--color-ink-3);
}

.case-amount {
  flex: none;
  margin-left: 16rpx;
  font-family: var(--font-sans);
  font-size: var(--font-btn);
  color: var(--color-flame);
}

.case-cause {
  display: block;
  margin-top: 16rpx;
  font-size: var(--font-base);
  line-height: 1.6;
  color: var(--color-ink);
}

.case-row {
  display: flex;
  margin-top: 12rpx;
}

.case-k {
  flex: none;
  width: 72rpx;
  font-size: var(--font-caption);
  color: var(--color-ink-3);
}

.case-v {
  flex: 1;
  font-size: var(--font-caption);
  line-height: 1.6;
  color: var(--color-ink-2);
}

.case-foot {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-top: 20rpx;
}

.case-tag {
  font-size: var(--font-micro);
  color: var(--color-flame);
  border: 2rpx solid var(--color-border);
  padding: 2rpx 14rpx;
  border-radius: 8rpx;
}

.case-date {
  font-size: var(--font-micro);
  color: var(--color-ink-3);
}

/* ─────────── 数据说明 ─────────── */
.notes {
  margin-top: 56rpx;
  padding: 32rpx;
  background: var(--color-card);
  border: 2rpx solid var(--color-border);
  border-radius: var(--radius-small);
}

.notes-title {
  display: block;
  font-family: var(--font-sans);
  font-size: var(--font-btn);
  font-weight: 600;
  color: var(--color-ink);
  margin-bottom: 16rpx;
}

.notes-item {
  display: block;
  font-size: var(--font-caption);
  line-height: 1.6;
  color: var(--color-ink-2);
  margin-bottom: 12rpx;
}

.notes-item:last-child {
  margin-bottom: 0;
}

/* ─────────── 长辈模式：整体再提一档，双列改单列 ─────────── */
.elder .head-title {
  font-size: 76rpx;
}

.elder .hero-title,
.elder .take-n {
  font-size: var(--font-title);
}

.elder .hero-text,
.elder .sec-intro,
.elder .oneline-b,
.elder .take-t,
.elder .check-t,
.elder .case-cause,
.elder .bar-name,
.elder .chip,
.elder .ing-name,
.elder .notice-title,
.elder .fold-title {
  font-size: var(--font-subtitle);
}

.elder .take-d,
.elder .check-d,
.elder .ing-tip,
.elder .sec-foot,
.elder .notes-item,
.elder .case-v,
.elder .case-k,
.elder .sub-note {
  font-size: var(--font-base);
}

.elder .ov-num {
  font-size: var(--font-display);
}

.elder .sec-title {
  font-size: 56rpx;
}

.elder .ing,
.elder .ov-item,
.elder .ov-item:nth-child(odd) {
  width: 100%;
  margin-right: 0;
}

/* ===== C 主题 · 食品安全（2026-11-20） ===== */
.head { border-bottom: 1rpx solid var(--color-border); }

.head-kicker {
  background: var(--color-green-bg);
  color: var(--color-green);
  border-radius: 999rpx;
  padding: 6rpx 18rpx;
}

.head-title,
.hero-title,
.sec-title,
.oneline-b,
.ing-name,
.case-cause,
.notice-title,
.notes-title {
  font-family: var(--font-sans);
  font-weight: 600;
  letter-spacing: 0;
  color: var(--color-ink);
}

.hero,
.ov-item,
.ing,
.case,
.notice,
.notes,
.fold {
  border: none;
  border-radius: 28rpx;
  background-color: var(--color-card);
  box-shadow: var(--shadow-card);
}

.hero { box-shadow: var(--shadow-lift); }

.step {
  background: var(--color-green-bg);
  border-radius: 20rpx;
}

.step-n {
  background: var(--color-green);
  color: var(--color-on-brand);
}

.hero-cta {
  background: var(--color-green);
  border-radius: 999rpx;
  box-shadow: var(--shadow-lift);
}

.case { border-left: none; }
.notice { border-left: none; }

