/* pages/foodsafety/foodsafety.wxss —— 食品安全
 *
 * 视觉基线沿用「食材档案」那一页：米黄纸底、宋体标题、细描边卡片，
 * 图标直接用 images/ingredients 那套插画（52/40rpx 两档），不新画一套笔触。
 * 一屏只用一种强调色：朱砂（--color-flame），不复用当令节气的墨绿，
 * 免得「不合格」看起来像「推荐」。
 */

.head {
  padding: 12rpx 4rpx 0;
}

.head-kicker {
  display: block;
  font-size: 26rpx;
  letter-spacing: 0.28em;
  color: var(--color-flame);
}

.head-title {
  display: block;
  margin-top: 10rpx;
  font-family: var(--font-serif);
  font-size: var(--font-display);
  letter-spacing: var(--tracking-title);
  line-height: 1.25;
  color: var(--color-ink);
}

.head-lead {
  display: block;
  margin-top: 14rpx;
  font-size: var(--font-base);
  line-height: 1.75;
  color: var(--color-ink-2);
}

.head-meta {
  display: flex;
  flex-wrap: wrap;
  align-items: center;
  margin-top: 16rpx;
  padding-bottom: 20rpx;
  border-bottom: 2rpx solid var(--color-border-hair);
}

.head-meta-item {
  font-size: var(--font-caption);
  letter-spacing: 0.04em;
  color: var(--color-ink-3);
}

.head-meta-dot {
  width: 8rpx;
  height: 8rpx;
  margin: 0 12rpx;
  border-radius: 50%;
  background-color: var(--color-border);
}

/* ==================== 概览四格 ==================== */

.ov-head {
  display: flex;
  align-items: center;
  margin: 26rpx 4rpx 12rpx;
}

.ov-ico {
  width: 40rpx;
  height: 40rpx;
  margin-right: 10rpx;
}

.ov-kicker {
  font-size: var(--font-caption);
  letter-spacing: 0.2em;
  color: var(--color-ink-3);
}

.ov {
  display: flex;
  flex-wrap: wrap;
  justify-content: space-between;
}

.ov-item {
  width: 48.6%;
  margin-bottom: 14rpx;
  padding: 22rpx 22rpx 20rpx;
  box-sizing: border-box;
  border: 1rpx solid rgba(139, 90, 43, 0.14);
  border-radius: var(--radius-small);
  background-image: linear-gradient(160deg, #fffdf8, #fbf4e3);
}

.ov-num-row {
  display: flex;
  align-items: baseline;
}

.ov-num {
  font-family: var(--font-serif);
  font-size: 60rpx;
  line-height: 1.1;
  color: var(--color-ink);
}

.ov-unit {
  margin-left: 6rpx;
  font-size: 26rpx;
  color: var(--color-ink-3);
}

.ov-label {
  display: block;
  margin-top: 6rpx;
  font-size: 30rpx;
  color: var(--color-ink-2);
}

.ov-note {
  display: block;
  margin-top: 2rpx;
  font-size: 24rpx;
  line-height: 1.5;
  color: var(--color-ink-3);
}

/* ==================== 栏目头 ==================== */

.sec {
  display: flex;
  align-items: center;
  margin: 40rpx 0 8rpx;
  padding-bottom: 12rpx;
  border-bottom: 2rpx solid var(--color-border-hair);
}

.sec-ico {
  flex: none;
  width: 56rpx;
  height: 56rpx;
  margin-right: 14rpx;
}

.sec-main {
  display: flex;
  align-items: baseline;
  min-width: 0;
}

.sec-no {
  flex: none;
  margin-right: 12rpx;
  font-family: var(--font-serif);
  font-size: var(--font-caption);
  letter-spacing: var(--tracking-caps);
  color: var(--color-flame);
}

.sec-title {
  font-family: var(--font-serif);
  font-size: 40rpx;
  letter-spacing: var(--tracking-title);
  color: var(--color-ink);
}

.sec-note {
  display: block;
  margin: 10rpx 2rpx 4rpx;
  font-size: 26rpx;
  line-height: 1.6;
  color: var(--color-ink-3);
}

/* ==================== 卡片 ==================== */

.card {
  margin-top: 18rpx;
  padding: 26rpx 24rpx 22rpx;
  border: 1rpx solid rgba(139, 90, 43, 0.14);
  border-radius: 24rpx;
  background-image: linear-gradient(168deg, #fffdf8, #fbf4e3);
  box-shadow: 0 4rpx 12rpx rgba(90, 60, 30, 0.05);
}

.card-head {
  display: flex;
  align-items: center;
  margin-bottom: 18rpx;
}

.card-ico {
  flex: none;
  width: 40rpx;
  height: 40rpx;
  margin-right: 10rpx;
}

.card-title {
  font-size: 34rpx;
  font-weight: 600;
  color: var(--color-ink);
}

.card-unit {
  margin-left: auto;
  padding-left: 12rpx;
  font-size: 24rpx;
  color: var(--color-ink-3);
}

.card-foot {
  display: block;
  margin-top: 14rpx;
  font-size: 24rpx;
  line-height: 1.65;
  color: var(--color-ink-3);
}

/* ==================== 问题类型条形 ==================== */

.bar {
  margin-bottom: 16rpx;
}

.bar-top {
  display: flex;
  align-items: baseline;
  justify-content: space-between;
}

.bar-name {
  padding-right: 12rpx;
  font-size: 28rpx;
  line-height: 1.4;
  color: var(--color-ink-2);
}

.bar-name-top {
  font-weight: 600;
  color: var(--color-ink);
}

.bar-val {
  flex: none;
  font-size: 24rpx;
  color: var(--color-ink-3);
}

.bar-track {
  height: 14rpx;
  margin-top: 8rpx;
  border-radius: 7rpx;
  background-color: rgba(139, 90, 43, 0.1);
  overflow: hidden;
}

.bar-fill {
  height: 100%;
  border-radius: 7rpx;
  background-color: rgba(181, 72, 42, 0.42);
}

.bar-fill-top {
  background-image: linear-gradient(90deg, #c9603a, #b5482a);
}

/* ==================== 抽样环节 ==================== */

.stages {
  display: flex;
}

.stage {
  flex: 1;
  padding: 6rpx 0;
  text-align: center;
}

.stage + .stage {
  border-left: 1rpx solid var(--color-border-hair);
}

.stage-pct {
  display: block;
  font-family: var(--font-serif);
  font-size: 52rpx;
  line-height: 1.2;
  color: var(--color-ink);
}

.stage-name {
  display: block;
  margin-top: 4rpx;
  font-size: 28rpx;
  color: var(--color-ink-2);
}

.stage-n {
  display: block;
  font-size: 24rpx;
  color: var(--color-ink-3);
}

/* ==================== 食材签 ==================== */

.chips {
  display: flex;
  flex-wrap: wrap;
}

.chip {
  display: flex;
  align-items: baseline;
  margin: 0 12rpx 12rpx 0;
  padding: 8rpx 18rpx;
  border: 1rpx solid var(--color-border-soft);
  border-radius: var(--radius-pill);
  background-color: rgba(255, 253, 248, 0.9);
}

.chip-name {
  font-size: 28rpx;
  color: var(--color-ink-2);
}

.chip-n {
  margin-left: 8rpx;
  font-family: var(--font-serif);
  font-size: 28rpx;
  color: var(--color-flame);
}

/* ==================== 月度柱 ==================== */

.cols {
  display: flex;
  align-items: flex-end;
  justify-content: space-between;
}

.col {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  min-width: 0;
}

.col-n {
  margin-bottom: 6rpx;
  font-size: 20rpx;
  color: var(--color-ink-3);
}

.col-track {
  display: flex;
  align-items: flex-end;
  width: 26rpx;
  height: 140rpx;
  border-radius: 6rpx;
  background-color: rgba(139, 90, 43, 0.08);
  overflow: hidden;
}

.col-bar {
  width: 100%;
  border-radius: 6rpx 6rpx 0 0;
  background-image: linear-gradient(180deg, #c9603a, #b5482a);
}

.col-x {
  margin-top: 8rpx;
  font-size: 20rpx;
  color: var(--color-ink-3);
}

/* ==================== 最近通告 ==================== */

.notice {
  padding: 14rpx 0;
  border-top: 1rpx solid var(--color-border-hair);
}

/* 卡片内第一个元素是 .card-head（同为 view），:first-of-type 不会命中 .notice，
   改用相邻兄弟，保证首条通告不带顶边框 */
.card-head + .notice {
  padding-top: 0;
  border-top: 0;
}

.notice-top {
  display: flex;
  align-items: baseline;
  justify-content: space-between;
}

.notice-no {
  font-size: 24rpx;
  letter-spacing: 0.04em;
  color: var(--color-flame);
}

.notice-date {
  font-size: 24rpx;
  color: var(--color-ink-3);
}

.notice-title {
  display: block;
  margin-top: 6rpx;
  font-size: 30rpx;
  line-height: 1.5;
  color: var(--color-ink-2);
}

.notice-count {
  display: block;
  margin-top: 4rpx;
  font-size: 24rpx;
  color: var(--color-ink-3);
}

/* ==================== 处罚数字 ==================== */

.pens {
  display: flex;
}

.pen {
  flex: 1;
  text-align: center;
}

.pen + .pen {
  border-left: 1rpx solid var(--color-border-hair);
}

.pen-num-row {
  display: flex;
  align-items: baseline;
  justify-content: center;
}

.pen-num {
  font-family: var(--font-serif);
  font-size: 56rpx;
  line-height: 1.2;
  color: var(--color-ink);
}

.pen-unit {
  margin-left: 4rpx;
  font-size: 24rpx;
  color: var(--color-ink-3);
}

.pen-label {
  display: block;
  margin-top: 2rpx;
  font-size: 26rpx;
  color: var(--color-ink-3);
}

/* ==================== 案例 ==================== */

.sub-head {
  display: flex;
  align-items: baseline;
  justify-content: space-between;
  margin: 28rpx 2rpx 6rpx;
}

.sub-title {
  font-family: var(--font-serif);
  font-size: 34rpx;
  color: var(--color-ink);
}

.sub-note {
  font-size: 24rpx;
  color: var(--color-ink-3);
}

.case {
  margin-top: 14rpx;
  padding: 22rpx 24rpx;
  border: 1rpx solid rgba(139, 90, 43, 0.14);
  border-radius: 22rpx;
  background-color: #fffdf8;
}

.case-top {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.case-tag {
  padding: 4rpx 14rpx;
  border-radius: var(--radius-pill);
  background-color: rgba(181, 72, 42, 0.1);
  font-size: 24rpx;
  color: var(--color-flame);
}

.case-date {
  font-size: 24rpx;
  color: var(--color-ink-3);
}

.case-cause {
  display: block;
  margin-top: 12rpx;
  font-size: 32rpx;
  line-height: 1.5;
  color: var(--color-ink);
}

.case-basis {
  display: block;
  margin-top: 6rpx;
  font-size: 26rpx;
  line-height: 1.6;
  color: var(--color-ink-3);
}

.case-foot {
  display: flex;
  flex-wrap: wrap;
  align-items: baseline;
  justify-content: space-between;
  margin-top: 12rpx;
  padding-top: 12rpx;
  border-top: 1rpx solid var(--color-border-hair);
}

.case-action {
  margin-right: 16rpx;
  font-size: 28rpx;
  color: var(--color-flame);
}

.case-doc {
  flex: 1;
  min-width: 0;
  text-align: right;
  font-size: 24rpx;
  color: var(--color-ink-3);
}

/* ==================== 口径 ==================== */

.note {
  margin-top: 30rpx;
  padding: 24rpx;
  border-left: 6rpx solid var(--color-flame);
  border-radius: 8rpx 22rpx 22rpx 8rpx;
  background-color: rgba(139, 90, 43, 0.05);
}

.note-head {
  display: flex;
  align-items: center;
  margin-bottom: 10rpx;
}

.note-ico {
  width: 40rpx;
  height: 40rpx;
  margin-right: 10rpx;
}

.note-title {
  font-size: 28rpx;
  font-weight: 600;
  color: var(--color-ink-2);
}

.note-line {
  display: block;
  font-size: 24rpx;
  line-height: 1.75;
  color: var(--color-ink-3);
}

/* 长辈模式：标题与数字跟着放大，避免出现「字大了、数字没大」的倒挂 */
.elder .head-title {
  font-size: 76rpx;
}

.elder .ov-num {
  font-size: 68rpx;
}

.elder .sec-title {
  font-size: 46rpx;
}

.elder .stage-pct,
.elder .pen-num {
  font-size: 62rpx;
}
