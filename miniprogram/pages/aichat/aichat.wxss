/* 康康对话页：米黄纸感 + 墨绿气泡。
   输入框与发送键点击区都按长者尺寸做（≥88rpx）。 */
.page {
  min-height: 100vh;
  background: #FBF8F2;
  display: flex;
  flex-direction: column;
}

.head {
  position: sticky;
  top: 0;
  z-index: 10;
  display: flex;
  align-items: center;
  padding: 20rpx 24rpx;
  background: rgba(247, 240, 225, 0.97);
  border-bottom: 2rpx solid rgba(139, 90, 43, 0.14);
}

.head-back {
  width: 88rpx;
  height: 88rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 44rpx;
  color: #B5482A;
}

.head-info {
  flex: 1;
  min-width: 0;
}

.head-title {
  display: block;
  font-size: 38rpx;
  font-weight: 700;
  color: #1E1E1A;
}

.head-sub {
  display: block;
  margin-top: 2rpx;
  font-size: 28rpx;
  color: #6E6A5E;
}

.head-clear {
  min-height: 88rpx;
  padding: 0 20rpx;
  display: flex;
  align-items: center;
  font-size: 32rpx;
  color: #B5482A;
}

/* 消息区 */
.chat {
  flex: 1;
  padding: 24rpx 24rpx 0;
  min-height: 0;
}

.chat-bottom {
  height: 20rpx;
}

.msg {
  display: flex;
  align-items: flex-start;
  margin-bottom: 26rpx;
}

.msg-me {
  flex-direction: row-reverse;
}

.msg-ava {
  width: 68rpx;
  height: 68rpx;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 28rpx;
  font-weight: 700;
  flex: none;
  background: #B5482A;
  color: #ffffff;
  margin-right: 16rpx;
}

.msg-me .msg-ava {
  background: #E8E3D8;
  color: #4A463C;
  margin-right: 0;
  margin-left: 16rpx;
}

.bubble {
  max-width: 78%;
  padding: 22rpx 24rpx;
  background: #ffffff;
  border: 2rpx solid rgba(139, 90, 43, 0.14);
  border-radius: 20rpx 20rpx 20rpx 6rpx;
}

.msg-me .bubble {
  background: #B5482A;
  border-color: #B5482A;
  border-radius: 20rpx 20rpx 6rpx 20rpx;
}

/* 失败回复：不伪装成正常回答，用棕色边区分 */
.bubble-err {
  background: #fdf4ec;
  border-color: rgba(196, 112, 58, 0.4);
}

.bubble-text {
  display: block;
  font-size: 36rpx;
  line-height: 1.75;
  color: #1E1E1A;
  word-break: break-word;
  white-space: pre-wrap;
}

.msg-me .bubble-text {
  color: #ffffff;
}

.bubble-err .bubble-text {
  color: #8a4a22;
}

/* 打字中 */
.typing {
  display: flex;
  margin-bottom: 10rpx;
}

.dot {
  width: 12rpx;
  height: 12rpx;
  border-radius: 50%;
  background: #b9ab98;
  margin-right: 10rpx;
  animation: bounce 1.1s infinite;
}

.dot:nth-child(2) { animation-delay: 0.15s; }
.dot:nth-child(3) { animation-delay: 0.3s; }

@keyframes bounce {
  0%, 60%, 100% { transform: translateY(0); opacity: 0.5; }
  30% { transform: translateY(-8rpx); opacity: 1; }
}

.typing-text {
  color: #4A463C;
}

/* 常用问法 */
.quick {
  white-space: nowrap;
  padding: 8rpx 24rpx 12rpx;
}

.quick-item {
  display: inline-flex;
  align-items: center;
  min-height: 72rpx;
  padding: 0 22rpx;
  margin-right: 14rpx;
  font-size: 32rpx;
  color: #4A463C;
  background: #FFFFFF;
  border: 2rpx solid rgba(139, 90, 43, 0.2);
  border-radius: 999rpx;
}

/* 输入区 */
.composer {
  display: flex;
  align-items: center;
  padding: 12rpx 24rpx 16rpx;
  background: rgba(247, 240, 225, 0.97);
  border-top: 2rpx solid rgba(139, 90, 43, 0.12);
}

.input {
  flex: 1;
  min-height: 88rpx;
  padding: 0 24rpx;
  font-size: 36rpx;
  color: #1E1E1A;
  background: #ffffff;
  border: 2rpx solid rgba(139, 90, 43, 0.18);
  border-radius: 999rpx;
}

.input-ph {
  color: #a79b8b;
  font-size: 32rpx;
}

.send {
  min-width: 132rpx;
  min-height: 88rpx;
  margin-left: 16rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 34rpx;
  font-weight: 600;
  color: #ffffff;
  background: #c9c0b0;
  border-radius: 999rpx;
}

.send-on {
  background: #B5482A;
}