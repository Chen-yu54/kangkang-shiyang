/* 康康食养 AI：统一对话页
   纸底米黄 + 白气泡 + 墨绿（用户）/ 品牌绿（AI 强调），
   头像与导航 logo 都走品牌图，不另画图标。 */

page {
  background: #FBF8F2;
}

/* 对话页根容器：全屏纵向弹性，自己定高，不复用 app.wxss 的 .page
   （那个带 24rpx 内边距和 min-height，会把输入区顶出屏幕） */
.kk {
  height: 100vh;
  display: flex;
  flex-direction: column;
  background: #FBF8F2;
}

/* ==================== 导航 ==================== */
.nav {
  flex: none;
  background: rgba(251, 248, 242, 0.98);
  border-bottom: 1rpx solid rgba(31, 74, 54, 0.12);
}

.nav-bar {
  display: flex;
  align-items: center;
  padding: 12rpx 20rpx 14rpx;
}

.nav-back {
  width: 72rpx;
  height: 72rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: var(--font-title);
  color: #1F4A36;
  flex: none;
}

.nav-logo {
  width: 74rpx;
  height: 74rpx;
  border-radius: 50%;
  flex: none;
  margin: 0 16rpx 0 4rpx;
  background: #F6F2EA;
  border: 2rpx solid rgba(31, 74, 54, 0.16);
}

.nav-main {
  flex: 1;
  min-width: 0;
}

.nav-t {
  display: block;
  font-family: var(--font-sans);
  font-size: var(--font-base);
  color: #1E1E1A;
  letter-spacing: 0.02em;
}

.nav-s {
  display: block;
  margin-top: 2rpx;
  font-size: var(--font-micro);
  color: #6E6A5E;
}

.nav-clear {
  flex: none;
  min-height: 72rpx;
  padding: 0 12rpx;
  display: flex;
  align-items: center;
  font-size: var(--font-caption);
  color: #1F4A36;
}

/* ==================== 消息区 ==================== */
.chat {
  flex: 1;
  height: 0;
  box-sizing: border-box;
  padding: 22rpx 24rpx 0;
}

.chat-pad {
  height: 20rpx;
}

.msg {
  display: flex;
  align-items: flex-start;
  margin-bottom: 24rpx;
}

.msg.me {
  flex-direction: row-reverse;
}

.ava {
  width: 66rpx;
  height: 66rpx;
  border-radius: 50%;
  flex: none;
  margin-right: 14rpx;
  background: #F6F2EA;
  border: 2rpx solid rgba(31, 74, 54, 0.14);
}

.msg.me .ava {
  margin-right: 0;
  margin-left: 14rpx;
}

.ava-me {
  display: flex;
  align-items: center;
  justify-content: center;
  background: #1F4A36;
  border-color: #1F4A36;
  color: #FFFFFF;
  font-size: var(--font-caption);
}

.msg-main {
  max-width: 512rpx;
  min-width: 0;
}

.msg.me .msg-main {
  display: flex;
  flex-direction: column;
  align-items: flex-end;
}

.bubble {
  padding: 18rpx 22rpx;
  background: #FFFFFF;
  border: 1rpx solid rgba(31, 74, 54, 0.12);
  border-radius: 6rpx 22rpx 22rpx 22rpx;
  box-shadow: 0 4rpx 14rpx rgba(61, 43, 26, 0.05);
}

.msg.me .bubble {
  background: #1F4A36;
  border-color: #1F4A36;
  border-radius: 22rpx 6rpx 22rpx 22rpx;
}

.bubble-t {
  display: block;
  font-size: var(--font-caption);
  line-height: 1.6;
  color: #1E1E1A;
  white-space: pre-wrap;
  word-break: break-word;
}

.msg.me .bubble-t {
  color: #FFFFFF;
}

.msg-note {
  display: block;
  margin-top: 8rpx;
  font-size: var(--font-tiny);
  color: #6E6A5E;
}

/* 能力卡：挑菜 / 问答 / 陪想 */
.caps {
  display: flex;
  margin-top: 16rpx;
  border-top: 1rpx solid rgba(31, 74, 54, 0.1);
  padding-top: 14rpx;
}

.cap {
  flex: 1;
  min-width: 0;
  padding-right: 10rpx;
}

.cap:last-child {
  padding-right: 0;
}

.cap-t {
  display: block;
  font-size: var(--font-micro);
  font-weight: 600;
  color: #1F4A36;
}

.cap-s {
  display: block;
  margin-top: 2rpx;
  font-size: var(--font-tiny);
  line-height: 1.4;
  color: #9c8c74;
}

/* 菜品卡：一条一条，点进详情 */
.cards {
  margin-top: 14rpx;
}

/* 消息里的动作按钮：补问卷、去补档案这类，只给一个明确出口 */
.bubble-cta {
  display: inline-block;
  margin-top: 16rpx;
  padding: 12rpx 24rpx;
  font-size: var(--font-caption);
  color: #B5482A;
  background: #FAF1ED;
  border: 1rpx solid rgba(31, 74, 54, 0.28);
  border-radius: 999rpx;
}

.card {
  display: flex;
  align-items: center;
  padding: 12rpx;
  margin-top: 10rpx;
  background: #FFFFFF;
  border: 1rpx solid rgba(31, 74, 54, 0.12);
  border-radius: 14rpx;
}

.card-img {
  width: 88rpx;
  height: 88rpx;
  border-radius: 10rpx;
  flex: none;
  background: #efe4cf;
}

.card-img-ph {
  display: flex;
  align-items: center;
  justify-content: center;
  font-family: var(--font-sans);
  font-size: var(--font-base);
  color: #1F4A36;
}

.card-main {
  flex: 1;
  min-width: 0;
  padding: 0 12rpx;
}

.card-n {
  display: block;
  font-size: var(--font-caption);
  font-weight: 600;
  color: #1E1E1A;
}

.card-m {
  display: block;
  margin-top: 3rpx;
  font-size: var(--font-tiny);
  color: #6E6A5E;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.card-go {
  flex: none;
  font-size: var(--font-btn);
  color: #B5482A;
}

/* 正在回：一句轮换的话 + 三个点 */
.typing {
  display: flex;
  align-items: center;
  padding: 4rpx 2rpx;
}

.typing-txt {
  font-size: var(--font-caption);
  line-height: 1.6;
  color: #6E6A5E;
  animation: kkFade 0.45s ease both;
}

.typing-dots {
  display: flex;
  align-items: center;
  flex: none;
  margin-left: 8rpx;
}

.dot {
  width: 12rpx;
  height: 12rpx;
  margin-right: 10rpx;
  border-radius: 50%;
  background: #c0ab8c;
  animation: kcBounce 1s infinite ease-in-out;
}

.dot:nth-child(2) {
  animation-delay: 0.15s;
}

.dot:nth-child(3) {
  animation-delay: 0.3s;
  margin-right: 0;
}

@keyframes kkFade {
  from { opacity: 0; transform: translateY(6rpx); }
  to { opacity: 1; transform: translateY(0); }
}

@keyframes kcBounce {
  0%, 60%, 100% { transform: translateY(0); opacity: 0.55; }
  30% { transform: translateY(-8rpx); opacity: 1; }
}

/* ==================== 常用问法 ==================== */
.quick {
  flex: none;
  white-space: nowrap;
  padding: 0 24rpx 12rpx;
  box-sizing: border-box;
}

.chip {
  display: inline-block;
  padding: 12rpx 22rpx;
  margin-right: 12rpx;
  background: #FFFFFF;
  border: 1rpx solid rgba(31, 74, 54, 0.22);
  border-radius: 40rpx;
  font-size: var(--font-micro);
  color: #6E6A5E;
}

/* ==================== 输入 ==================== */
.composer {
  flex: none;
  display: flex;
  align-items: center;
  padding: 12rpx 24rpx;
  background: rgba(251, 248, 242, 0.98);
  border-top: 1rpx solid rgba(31, 74, 54, 0.1);
}

.input {
  flex: 1;
  height: 84rpx;
  padding: 0 24rpx;
  background: #FFFFFF;
  border: 1rpx solid rgba(31, 74, 54, 0.18);
  border-radius: 42rpx;
  font-size: var(--font-caption);
  color: #1E1E1A;
}

.ph {
  color: #6E6A5E;
}

.send {
  flex: none;
  height: 84rpx;
  padding: 0 30rpx;
  margin-left: 14rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  background: #e6dcc8;
  color: #6E6A5E;
  border-radius: 42rpx;
  font-size: var(--font-caption);
}

.send-on {
  background: #1F4A36;
  color: #FFFFFF;
}

.foot {
  flex: none;
  padding: 0 0 calc(10rpx + env(safe-area-inset-bottom));
  text-align: center;
  font-size: var(--font-tiny);
  color: #b0a08a;
}

/* ============================================================
   C 主题 · 康康食养 AI（自定义导航）
   深绿品牌头 + 白卡 bot 气泡 + 深绿用户气泡
   ============================================================ */
page, .kk { background: #FBF8F2; }

.nav {
  background: var(--color-green);
  border-bottom: none;
}

.nav-bar { padding: 12rpx 20rpx 16rpx; }
.nav-back { color: #FFFFFF; }

.nav-logo {
  width: 76rpx;
  height: 76rpx;
  border: 2rpx solid rgba(255, 255, 255, 0.35);
  background: rgba(255, 255, 255, 0.12);
}

.nav-t {
  font-family: var(--font-sans);
  font-size: var(--font-base);
  font-weight: 600;
  color: #FFFFFF;
}

.nav-s { color: rgba(255, 255, 255, 0.68); }
.nav-clear { color: #FFFFFF; }

.chat { padding: 20rpx 20rpx 0; }
.msg { margin-bottom: 24rpx; }

.bubble {
  padding: 20rpx 22rpx;
  border: 1rpx solid var(--color-border);
  border-radius: 20rpx 20rpx 20rpx 6rpx;
  background: #FFFFFF;
  box-shadow: 0 4rpx 14rpx rgba(30, 30, 26, 0.04);
}

.msg.me .bubble {
  border-color: var(--color-green);
  border-radius: 20rpx 20rpx 6rpx 20rpx;
  background: var(--color-green);
  box-shadow: none;
}

.bubble-t { font-size: var(--font-btn); line-height: 1.6; color: var(--color-ink); }
.msg.me .bubble-t { color: #FFFFFF; }

.ava { width: 64rpx; height: 64rpx; }
.ava-me { background: var(--color-green-bg); color: var(--color-green); }

.cards { margin-top: 12rpx; }
.card {
  border: 1rpx solid var(--color-border);
  border-radius: 20rpx;
  background: #FFFFFF;
  box-shadow: 0 6rpx 18rpx rgba(30, 30, 26, 0.05);
}

.card-n { font-size: var(--font-caption); font-weight: 600; }
.card-m { font-size: var(--font-micro); color: var(--color-ink-3); }

.quick { padding: 8rpx 20rpx 12rpx; }
.quick .chip {
  min-height: 64rpx;
  padding: 0 18rpx;
  border: 1rpx solid var(--color-border);
  border-radius: 999rpx;
  background: #FFFFFF;
  font-size: var(--font-caption);
  color: var(--color-ink-2);
}

.composer {
  padding: 10rpx 20rpx 14rpx;
  background: #FBF8F2;
  border-top: 1rpx solid var(--color-border);
}

.input {
  min-height: 88rpx;
  background: #FFFFFF;
  border: 1rpx solid var(--color-border);
  border-radius: 999rpx;
  font-size: var(--font-btn);
}

.send {
  min-width: 104rpx;
  min-height: 80rpx;
  border-radius: 999rpx;
  background: #C9D6CE;
  font-size: var(--font-caption);
}

.send-on { background: var(--color-green); }
.foot { color: var(--color-ink-3); font-size: var(--font-tiny); }

