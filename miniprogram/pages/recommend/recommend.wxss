/* pages/recommend/recommend.wxss —— 推荐页样式，全部取 app.wxss 的 CSS 变量 */

.term-bar {
  padding: 16rpx 0 24rpx;
}

.term-name {
  font-size: var(--font-title);
  color: var(--color-ink);
}

.degraded {
  padding: 24rpx;
  margin-bottom: 24rpx;
  border: 2rpx solid var(--color-brand);
  border-radius: var(--radius-card);
  background-color: var(--color-card);
  box-shadow: var(--shadow-card);
  box-sizing: border-box;
}

.degraded-text {
  font-size: var(--font-base);
  line-height: 1.6;
  color: var(--color-ink);
}

/* —— 推荐过程折叠区 —— */
.reason-section {
  margin-top: 32rpx;
  border: 2rpx solid var(--color-border);
  border-radius: var(--radius-card);
  background-color: var(--color-card);
  overflow: hidden;
}

.reason-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  min-height: var(--tap-min);
  padding: 0 24rpx;
  box-sizing: border-box;
}

.reason-title {
  font-size: var(--font-base);
  font-weight: 600;
  color: var(--color-ink);
}

.reason-arrow {
  width: 32rpx;
  height: 32rpx;
}

.reason-body {
  padding: 0 24rpx 24rpx;
}

/* 依据链路：四步一行，宽度不够时换行，不缩字号（适老化硬指标） */
.chain {
  display: flex;
  flex-wrap: wrap;
  align-items: center;
  padding: 16rpx 0;
  border-bottom: 2rpx solid var(--color-border-hair);
}

.chain-step {
  font-size: var(--font-btn);
  color: var(--color-ink-2);
}

.chain-dot {
  width: 12rpx;
  height: 12rpx;
  margin: 0 12rpx;
}

/* 生成方式说明：把「AI 在推荐里做了什么」写清楚，也是降级时的诚实交代 */
.gen-note {
  display: block;
  margin-top: 20rpx;
  padding-top: 16rpx;
  border-top: 2rpx solid var(--color-border-hair);
  font-size: var(--font-btn);
  line-height: 1.7;
  color: var(--color-ink-3);
}

.reason-item {
  margin-top: 16rpx;
}

.reason-key {
  display: block;
  margin-bottom: 8rpx;
  font-size: var(--font-base);
  font-weight: 600;
  color: var(--color-ink);
}

.reason-value {
  display: block;
  font-size: var(--font-base);
  line-height: 1.6;
  color: var(--color-ink);
}

.reason-empty {
  display: block;
  margin-top: 16rpx;
  font-size: var(--font-base);
  line-height: 1.6;
  color: var(--color-ink);
}

.chip-row {
  display: flex;
  flex-wrap: wrap;
}

.chip {
  padding: 8rpx 24rpx;
  margin: 0 12rpx 12rpx 0;
  border: 2rpx solid var(--color-border);
  border-radius: var(--radius-card);
  background-color: var(--color-card);
  font-size: var(--font-base);
  color: var(--color-ink);
  box-sizing: border-box;
}

.tap-hover {
  opacity: 0.82;
}

/* —— 紧凑卡：图 240rpx + 菜名 + 一句特点，3 张一屏 —— */
.pack {
  display: flex;
  flex-direction: column;
  margin-bottom: 24rpx;
}

/* 图片位由 dishMedia 渲染：有图显示风味卡，无图显示风味签，两态等高 240rpx */

.pack-body {
  padding-top: 12rpx;
}

.pack-name {
  display: block;
  font-size: var(--font-title);
  color: var(--color-ink);
}

.pack-desc {
  display: block;
  margin-top: 4rpx;
  font-size: var(--font-base);
  line-height: 1.5;
  color: var(--color-ink-3);
}