<!-- page-meta 必须是页面第一个节点，一页只能有一个 -->
<page-meta page-style="{{pageStyle}}" />

<view class="page {{elderMode ? 'elder' : ''}}">
  <view class="content">

    <!-- 刊头：导航栏已经写着「我的」，这里不再重复一行小字，直接上标题 -->
    <view class="mast">
      <text class="mast-title">{{copy.mastTitle}}</text>
    </view>

    <!-- 节气封面条：当前节气海报 + 序位，点开看节气页。
         长辈模式下收起——海报是装饰，这一页要看的是头像、收藏、偏好和字号 -->
    <view wx:if="{{termPoster && !elderMode}}" class="cover" hover-class="tap-hover" bindtap="onTapTerm">
      <image class="cover-img" src="{{termPoster}}" mode="aspectFill" />
      <view class="cover-shade"></view>
      <view wx:if="{{termName}}" class="cover-pill">{{termName}} · 第 {{termNo}} 个节气</view>
    </view>

    <!-- 档案卡：头像昵称 + 三个本机数字 -->
    <view id="tour-profile" class="idcard">
      <view class="idcard-top" hover-class="tap-hover" bindtap="onTapLogin">
        <view class="avatar {{avatarUrl ? 'avatar-on' : ''}}">
          <image wx:if="{{!avatarUrl}}" class="avatar-icon" src="/images/avatar-default.png" mode="aspectFit" />
          <image wx:else class="avatar-photo" src="{{avatarUrl}}" mode="aspectFill" />
        </view>
        <view class="idcard-text">
          <view class="idcard-name-row">
            <text class="idcard-name">{{loggedIn ? nickName : copy.notLogin}}</text>
            <text wx:if="{{loggedIn && !elderMode}}" class="idcard-tag">{{copy.loggedTag}}</text>
          </view>
          <text class="idcard-sub">{{loggedIn ? copy.loggedInHint : copy.loginAction}}</text>
        </view>
        <image class="idcard-arrow" src="/images/icons/yuntou-zhejiao.png" mode="aspectFit" />
      </view>

      <!-- 三个数字：收藏 / 口味 / 字号。长辈模式下收起——
           同样的信息下面的「我的收藏 / 饮食偏好 / 字号」逐行都有，
           数字堆在一起反而看不清哪个才是能点的 -->
      <view wx:if="{{!elderMode}}" class="stats">
        <view class="stat" hover-class="tap-hover" bindtap="onTapFavorite">
          <text class="stat-num">{{favoriteCount}}</text>
          <text class="stat-label">{{copy.statFavorite}}</text>
        </view>
        <view class="stat-div"></view>
        <view class="stat" hover-class="tap-hover" bindtap="onTapPref">
          <text class="stat-num stat-num-sm">{{prefDone ? copy.prefDone : copy.prefEmpty}}</text>
          <text class="stat-label">{{copy.statTaste}}</text>
        </view>
        <view class="stat-div"></view>
        <view class="stat">
          <text class="stat-num stat-num-sm">{{fontLabelText}}</text>
          <text class="stat-label">{{copy.statFont}}</text>
        </view>
      </view>
    </view>

    <!-- 壹 · 我的收藏 -->
    <view class="sec">
      <text class="sec-no">壹</text>
      <text class="sec-title">{{copy.favorite}}</text>
      <text wx:if="{{favList.length}}" class="sec-more" hover-class="tap-hover" bindtap="onTapFavorite">{{favMoreText}} ›</text>
    </view>

    <scroll-view
      wx:if="{{favList.length}}"
      class="fav-scroll"
      scroll-x
      enhanced
      show-scrollbar="{{false}}"
    >
      <view
        class="fav"
        wx:for="{{favList}}"
        wx:key="id"
        data-id="{{item.id}}"
        hover-class="tap-hover"
        bindtap="onTapDish"
      >
        <dish-media image="{{item.image}}" name="{{item.name}}" cuisine="{{item.cuisine}}" height="200" mode="thumb" flush="{{true}}" />
        <view class="fav-body">
          <text class="fav-name">{{item.name}}</text>
          <text class="fav-meta">{{item.meta}}</text>
        </view>
      </view>
    </scroll-view>

    <view wx:else class="fav-empty" hover-class="tap-hover" bindtap="onGoHome">
      <text class="fav-empty-title">{{copy.favEmptyTitle}}</text>
      <text class="fav-empty-sub">{{copy.favEmptySub}}</text>
    </view>

    <!-- 贰 · 我的偏好 -->
    <view class="sec">
      <text class="sec-no">贰</text>
      <text class="sec-title">{{copy.pref}}</text>
    </view>

    <view class="rows">
      <view class="row" hover-class="tap-hover" bindtap="onTapPref">
        <view class="row-main">
          <text class="row-label">{{copy.tasteLabel}}</text>
          <text class="row-value">{{tasteText}}</text>
        </view>
        <image class="row-arrow" src="/images/icons/yuntou-zhejiao.png" mode="aspectFit" />
      </view>

      <view class="row" hover-class="tap-hover" bindtap="onTapPref">
        <view class="row-main">
          <text class="row-label">{{copy.avoidLabel}}</text>
          <text class="row-value">{{avoidText}}</text>
        </view>
        <image class="row-arrow" src="/images/icons/yuntou-zhejiao.png" mode="aspectFit" />
      </view>

      <!-- 字号三档：长辈模式下收起——那一档固定 1.6 倍，再摆三个选项只会互相打架 -->
      <view wx:if="{{!elderMode}}" class="row row-col">
        <view class="row-main">
          <text class="row-label">{{copy.fontScale}}</text>
        </view>
        <view class="font-options">
          <view
            class="font-option {{fontScale === item.value ? 'font-option-on' : ''}}"
            wx:for="{{fontOptions}}"
            wx:key="value"
            data-value="{{item.value}}"
            hover-class="tap-hover"
            bindtap="onTapFont"
          >
            <text class="font-option-text">{{item.label}}</text>
          </view>
        </view>
      </view>

      <view class="row">
        <view class="row-main">
          <text class="row-label">{{copy.elderLabel}}</text>
          <text class="row-value">{{copy.elderDesc}}</text>
        </view>
        <switch class="row-switch" checked="{{elderMode}}" color="#3f7a45" bindchange="onToggleElder" />
      </view>

      <view wx:if="{{!elderMode}}" class="row" hover-class="tap-hover" bindtap="onTapConsent">
        <view class="row-main">
          <text class="row-label">{{copy.consent}}</text>
          <text class="row-value {{shareOn ? 'row-value-on' : ''}}">{{shareOn ? copy.consentOn : copy.consentOff}}</text>
        </view>
        <image class="row-arrow" src="/images/icons/yuntou-zhejiao.png" mode="aspectFit" />
      </view>
    </view>
    <text wx:if="{{!elderMode}}" class="rows-note">{{copy.prefNote}}</text>

    <!-- 叁 · 更多：长辈模式只留必须能找到的几件——服务协议、隐私政策、清空数据、退出登录。
         方法说明 / 关于 / 数据分享 / 再看引导都收起来，一屏里少四条可点项 -->
    <view class="sec">
      <text class="sec-no">叁</text>
      <text class="sec-title">{{copy.more}}</text>
    </view>

    <view class="rows">
      <view wx:if="{{!elderMode}}" class="row" hover-class="tap-hover" bindtap="onTapMethod">
        <view class="row-main">
          <text class="row-label">{{copy.method}}</text>
          <text class="row-value">数据来源与口径</text>
        </view>
        <image class="row-arrow" src="/images/icons/yuntou-zhejiao.png" mode="aspectFit" />
      </view>

      <view wx:if="{{!elderMode}}" class="row" hover-class="tap-hover" bindtap="onTapAbout">
        <view class="row-main">
          <text class="row-label">{{copy.about}}</text>
        </view>
        <image class="row-arrow" src="/images/icons/yuntou-zhejiao.png" mode="aspectFit" />
      </view>

      <view class="row" hover-class="tap-hover" bindtap="onTapService">
        <view class="row-main">
          <text class="row-label">{{copy.service}}</text>
        </view>
        <image class="row-arrow" src="/images/icons/yuntou-zhejiao.png" mode="aspectFit" />
      </view>

      <view class="row" hover-class="tap-hover" bindtap="onTapPrivacyDoc">
        <view class="row-main">
          <text class="row-label">{{copy.privacyDoc}}</text>
        </view>
        <image class="row-arrow" src="/images/icons/yuntou-zhejiao.png" mode="aspectFit" />
      </view>

      <!-- 清空数据留在长辈模式里：这是用户删掉本机数据的唯一入口，
           不因为「简化」就拿掉，误触有二次确认挡着 -->
      <view class="row" hover-class="tap-hover" bindtap="onClearData">
        <view class="row-main">
          <text class="row-label">{{copy.clearData}}</text>
        </view>
        <image class="row-arrow" src="/images/icons/yuntou-zhejiao.png" mode="aspectFit" />
      </view>

      <view wx:if="{{loggedIn}}" class="row" hover-class="tap-hover" bindtap="onLogout">
        <view class="row-main">
          <text class="row-label">{{copy.logout}}</text>
        </view>
        <image class="row-arrow" src="/images/icons/yuntou-zhejiao.png" mode="aspectFit" />
      </view>
    </view>

    <view wx:if="{{!elderMode}}" class="tour-again" hover-class="tap-hover" bindtap="onReplayTour">
      <text class="tour-again-text">{{copy.replayTour}}</text>
    </view>

    <text wx:if="{{!elderMode}}" class="version">{{copy.version}}</text>
  </view>

  <disclaimer />

  <!-- 登录后的功能引导：跨三页走，进度在 app.globalData.tour -->
  <guide-tour
    visible="{{tourVisible}}"
    step="{{tourStep}}"
    index="{{tourIndex}}"
    total="{{tourTotal}}"
    bind:next="onTourNext"
    bind:skip="onTourSkip"
  />
</view>
