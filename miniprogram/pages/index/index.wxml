<!-- page-meta 必须是页面第一个节点，且一页只能有一个 -->
<page-meta page-style="{{pageStyle}}" />

<!-- elder：长辈模式（1.6 倍字）下整页换一套排版规则——
     大字会让原来「一行两栏」的地方挤成两行半，所以这一档只保顺序、不保栏位 -->
<view class="page {{elderMode ? 'elder' : ''}}">
  <view class="content">

    <!-- 1. 封面 hero（暗底食光层）：节气海报压暗 + 刊名栏 + 日期印章 + 出版信息 + 蒸汽。
         节气名只由海报书法字承担，页面不再重复叠字；下方标题走 slogan，印章走日期。 -->
    <view wx:if="{{banner}}" id="tour-hero" class="hero" hover-class="tap-hover" bindtap="onTapTerm">
      <image
        wx:if="{{termPoster}}"
        class="hero-poster"
        src="{{termPoster}}"
        mode="aspectFill"
        lazy-load
      />
      <view wx:else class="hero-fallback"></view>
      <!-- 全屏暖黑压暗 + 暗角，聚焦中央 -->
      <view class="hero-shade"></view>

      <!-- 顶部刊名栏：左刊名，右日期印章 -->
      <view class="hero-top">
        <text class="hero-kicker">{{copy.heroKicker}}</text>
        <view wx:if="{{sealText}}" class="hero-seal">
          <text class="hero-seal-text">{{sealText}}</text>
        </view>
      </view>

      <!-- 底部：headline + 距下一节气；大字下一行放不下时整行折下去 -->
      <view class="hero-foot">
        <text wx:if="{{banner.headline}}" class="hero-headline">{{banner.headline}}</text>
        <text wx:if="{{banner.hint}}" class="hero-hint">{{banner.hint}}</text>
        <text wx:if="{{!elderMode}}" class="hero-ainote">{{copy.heroAiNote}}</text>
      </view>

      <!-- 蒸汽：刚出锅的通感，纯 CSS -->
      <view class="hero-steam" aria-hidden="true">
        <view class="hero-steam-i hero-steam-1"></view>
        <view class="hero-steam-i hero-steam-2"></view>
        <view class="hero-steam-i hero-steam-3"></view>
      </view>
    </view>

    <!-- ==================== 2. 节气文化 ====================
         封面之后先讲这个节气：一句标语、一首诗，点开看三候与食俗。
         文化放前面，是因为它决定这一屏推什么菜——先讲为什么，再给吃什么。 -->
    <view wx:if="{{termCulture}}" class="sec">
      <view class="sec-main">
        <text class="sec-no">{{copy.noCulture}}</text>
        <text class="sec-title">{{copy.sectionCulture}}</text>
      </view>
    </view>

    <!-- 2.1 节气文化卡：先只亮三样——节气名、一句、一首诗。
         三候 / 食俗 / 食材不在这一屏展开，点「立冬的讲究」直接去节气详情页看。 -->
    <view wx:if="{{termCulture}}" id="tour-culture" class="tculture">
      <view class="tculture-head">
        <text class="tculture-tag">{{copy.cultureTag}}</text>
        <text class="tculture-term">{{termName}}</text>
      </view>
      <text class="tculture-slogan">{{termCulture.slogan}}</text>

      <view wx:if="{{termCulture.poem}}" class="tculture-poem">
        <text class="tculture-poem-text">{{termCulture.poem.text}}</text>
        <text class="tculture-poem-by">{{termCulture.poem.author}}</text>
      </view>

      <!-- 可点的框：整框就是入口，去节气详情页，看三候 / 食俗 / 当令食材 -->
      <view class="tmore" hover-class="tap-hover" bindtap="onTapTermDetail">
        <view class="tmore-main">
          <text class="tmore-title">{{cultureTitle}}</text>
          <text class="tmore-sub">{{copy.cultureOpenSub}}</text>
        </view>
        <text class="tmore-act">{{copy.cultureOpen}} ›</text>
      </view>
    </view>

    <!-- 3. 搜菜名 / 食材：整行都是点击区，大字下也不挤 -->
    <view class="search-entry" hover-class="tap-hover" bindtap="onTapSearch">
      <text class="search-text">{{copy.searchPlaceholder}}</text>
      <text class="search-go">›</text>
    </view>

    <!-- 问问康康：对话式问卷入口。
         不放表单而放对话——问 6 道题容易中途退出，聊几句更容易走完。 -->
    <view class="ask-entry" hover-class="tap-hover" bindtap="onTapAgent">
      <view class="ask-ava">康</view>
      <view class="ask-body">
        <text class="ask-title">{{copy.askTitle}}</text>
        <text class="ask-sub">{{copy.askSub}}</text>
      </view>
      <text class="ask-go">›</text>
    </view>

    <!-- 自由对话入口：连扣子 Bot，可以打字追问 -->
    <view class="ask-entry ask-entry-alt" hover-class="tap-hover" bindtap="onTapAiChat">
      <view class="ask-ava ask-ava-alt">问</view>
      <view class="ask-body">
        <text class="ask-title">{{copy.chatTitle}}</text>
        <text class="ask-sub">{{copy.chatSub}}</text>
      </view>
      <text class="ask-go">›</text>
    </view>

    <!-- ==================== 4. 当令菜 ====================
         讲完节气、给完入口，紧接着「今天吃什么」；数据仪表盘收在页尾做复盘。
         这一页只看当令，不看口味。口味测试 → 推演 → 专属食单是另一条链路，
         归「专属推荐」tab 的今日食单，两边不混。 -->
    <view class="lead">
      <text class="lead-kicker">{{copy.leadKicker}}</text>
      <view class="lead-row">
        <view class="lead-main">
          <text class="lead-no">{{copy.noDishes}}</text>
          <text class="lead-title">{{copy.sectionDishes}}</text>
        </view>
        <view class="lead-tags">
          <text wx:if="{{termName}}" class="lead-term">{{termName}}</text>
        </view>
      </view>
    </view>

    <loading wx:if="{{status === 'loading'}}" type="skeleton" />

    <empty-state wx:elif="{{status === 'empty'}}" text="{{copy.empty}}" />

    <view wx:elif="{{status === 'error'}}" class="state-box">
      <text class="state-text">{{copy.error}}</text>
      <view class="btn" hover-class="tap-hover" bindtap="onRetry">{{copy.retry}}</view>
    </view>

    <block wx:else>
      <!-- 当令展示牌：一道一屏，自动轮播，展签（菜名 / 做法）跟着图一起换 -->
      <view wx:if="{{showcase.length}}" id="tour-showcase" class="showcase">
        <swiper
          class="sc-swiper"
          autoplay="{{showcase.length > 1}}"
          circular="{{showcase.length > 1}}"
          interval="4800"
          duration="620"
          bindchange="onShowcaseChange"
        >
          <swiper-item wx:for="{{showcase}}" wx:key="id">
            <view
              class="sc-slide"
              data-id="{{item.id}}"
              hover-class="tap-hover"
              bindtap="onTapDish"
            >
              <dish-media
                image="{{item.image}}"
                name="{{item.name}}"
                cuisine="{{item.cuisine}}"
                height="420"
                mode="hero"
                flush="{{true}}"
                steam="{{true}}"
                tint="{{true}}"
                ai-tag="{{copy.aiTag}}"
              />
              <view class="sc-caption">
                <text class="sc-no">{{item.idxText}}</text>
                <view class="sc-cap-main">
                  <view class="sc-cap-head">
                    <text class="sc-name">{{item.name}}</text>
                    <text class="sc-cuisine">{{item.cuisineName}}</text>
                  </view>
                  <text wx:if="{{item.how}}" class="sc-how">{{item.how}}</text>
                </view>
              </view>
            </view>
          </swiper-item>
        </swiper>

        <!-- 轮播刻度：一格一道菜，当前格朱砂填满 -->
        <view class="sc-dots" aria-hidden="true">
          <view
            class="sc-dot {{showcaseIndex === index ? 'sc-dot-on' : ''}}"
            wx:for="{{showcase}}"
            wx:key="id"
          ></view>
        </view>
      </view>

      <view class="section-more" hover-class="tap-hover" bindtap="onTapMenu">
        <text class="section-more-text">{{copy.seeAll}}</text>
        <image class="section-more-arrow" src="/images/icons/yuntou-zhejiao.png" mode="aspectFit" />
      </view>
    </block>

    <!-- 5. 跟着节气吃：节气驾驶舱。罗盘 + 三个数字 + 三个环，点开在卡内切五个分区。
         长辈模式下整块收起——一屏里数字太多，大字档读不清。 -->
    <block wx:if="{{!elderMode}}">
      <view class="sec">
        <view class="sec-main">
          <text class="sec-no">{{copy.noSnapshot}}</text>
          <text class="sec-title">{{copy.snapshotTitle}}</text>
        </view>
      </view>

      <view wx:if="{{stats}}" id="dash" class="ck">
        <view class="ck-top">
          <view class="ck-live">
            <view class="ck-dot"></view>
            <text class="ck-live-t">{{copy.snapLive}}</text>
          </view>
          <text class="ck-asof">{{copy.snapAsOf}} {{dataVersion}}</text>
        </view>

        <!-- 罗盘：24 根刻度＝24 节气，四段金弧＝四季；中心是当前节气 -->
        <view class="ck-hero">
          <view class="ck-compass {{dashOn ? 'on' : ''}}">
            <view class="ck-arcs"></view>
            <view
              class="ck-tick {{item.on ? 'on' : ''}} {{item.now ? 'now' : ''}}"
              wx:for="{{ck.term.ticks}}"
              wx:key="n"
              style="left: {{item.x}}rpx; top: {{item.y}}rpx; transform: rotate({{item.deg}}deg); animation-delay: {{index * 24}}ms"
            ></view>
            <text class="ck-season ck-season-1">春</text>
            <text class="ck-season ck-season-2">夏</text>
            <text class="ck-season ck-season-3">秋</text>
            <text class="ck-season ck-season-4">冬</text>
            <view class="ck-face">
              <text class="ck-term">{{stats.term.name}}</text>
              <text class="ck-pos">{{stats.term.posText}}</text>
            </view>
          </view>

          <view class="ck-kpis">
            <view class="ck-kpi">
              <view class="ck-kpi-n">
                <text class="ck-num">{{stats.perTerm}}</text>
                <text class="ck-unit">道</text>
              </view>
              <text class="ck-k">每个节气</text>
              <text class="ck-s">{{copy.ckKpi1}}</text>
            </view>
            <view class="ck-kpi">
              <view class="ck-kpi-n">
                <text class="ck-num">{{stats.term.total}}</text>
                <text class="ck-unit">个</text>
              </view>
              <text class="ck-k">节气 · 每年</text>
              <text class="ck-s">{{copy.ckKpi2}}</text>
            </view>
            <view class="ck-kpi">
              <view class="ck-kpi-n">
                <text class="ck-num">{{stats.easyPct}}</text>
                <text class="ck-unit">%</text>
              </view>
              <text class="ck-k">家常可做</text>
              <text class="ck-s">{{copy.ckKpi3}}</text>
            </view>
          </view>
        </view>

        <!-- 三个环：环的进度由 inline conic-gradient 画，百分比同时以数字呈现 -->
        <view class="ck-rings">
          <view class="ck-ring-item" wx:for="{{stats.promises}}" wx:key="key">
            <view
              class="ck-ring"
              style="background: conic-gradient(#7fc9ba 0 {{item.pct}}%, rgba(243,234,218,0.14) {{item.pct}}% 100%)"
            >
              <view class="ck-ring-in">
                <text class="ck-ring-t">{{item.text}}</text>
              </view>
            </view>
            <text class="ck-rk">{{item.label}}</text>
            <text class="ck-rs">{{item.sub}}</text>
          </view>
        </view>

        <text class="ck-note">{{copy.snapNote}}</text>

        <!-- 展开 / 收起 -->
        <view class="ck-more" hover-class="tap-hover" bindtap="onToggleCockpit">
          <text class="ck-more-t">{{ckOpen ? copy.ckCollapse : copy.ckExpand}}</text>
          <text class="ck-chev {{ckOpen ? 'up' : ''}}">⌄</text>
        </view>

        <!-- ======== 分区台：默认 01 节气视图 ======== -->
        <view wx:if="{{ckOpen && ck}}" class="ck-panel">
          <view class="ck-tabs">
            <view
              class="ck-tab {{ckTab === item.key ? 'on' : ''}}"
              wx:for="{{ck.tabs}}"
              wx:key="key"
              bindtap="onPickCockpitTab"
              data-key="{{item.key}}"
            >
              <text class="ck-tab-n">{{index + 1}}</text>
              <text>{{item.name}}</text>
            </view>
          </view>

          <text class="ck-pcap">{{ckCap}}</text>

          <!-- 01 节气视图（实算） -->
          <view wx:if="{{ckTab === 'term'}}" class="ck-p">
            <view class="ck-metrics">
              <view class="ck-metric" wx:for="{{ck.term.metrics}}" wx:key="label">
                <view class="ck-metric-n">
                  <text class="ck-mv">{{item.v}}</text>
                  <text class="ck-mu">{{item.u}}</text>
                </view>
                <text class="ck-ml">{{item.label}}</text>
              </view>
            </view>

            <view class="ck-cells">
              <view class="ck-cell {{item.cur ? 'cur' : ''}}" wx:for="{{ck.term.cells}}" wx:key="name">
                <text class="ck-cell-t">{{item.name}}</text>
              </view>
            </view>

            <text class="ck-pnote">{{ck.term.note}}</text>
          </view>

          <!-- 02 菜系对照（实算） -->
          <view wx:if="{{ckTab === 'cuisine'}}" class="ck-p">
            <view class="ck-cu" wx:for="{{ck.cuisine.list}}" wx:key="name">
              <view class="ck-cu-h">
                <text class="ck-cu-n">{{item.name}}</text>
                <text class="ck-cu-v">{{item.n}} 道</text>
              </view>
              <view class="ck-stack">
                <view style="width: {{item.lowPct}}%; background-color: #6fbfb0"></view>
                <view style="width: {{item.midPct}}%; background-color: #3e7f72"></view>
                <view style="width: {{item.highPct}}%; background-color: #c9a227"></view>
              </view>
              <view class="ck-legend">
                <text>低 {{item.low}}</text>
                <text>中 {{item.mid}}</text>
                <text>高 {{item.high}}</text>
              </view>
              <text class="ck-cu-f">★★★ {{item.hard}} 道 · 忌口提示 {{item.caution}}/{{item.n}}</text>
            </view>
            <text class="ck-pnote">{{ck.cuisine.note}}</text>
          </view>

          <!-- 03 体质适配（示例） -->
          <view wx:if="{{ckTab === 'fit'}}" class="ck-p">
            <view class="ck-cap">
              <text>宜（多标签，不可相加）</text>
              <text wx:if="{{ck.fit.sample}}" class="ck-tag">示例</text>
            </view>
            <view class="ck-bar" wx:for="{{ck.fit.good}}" wx:key="name">
              <text class="ck-bar-l">{{item.name}}</text>
              <view class="ck-track"><view class="ck-fill jade" style="width: {{item.w}}%"></view></view>
              <text class="ck-bar-v">{{item.v}}</text>
            </view>

            <view class="ck-cap ck-cap-gap">
              <text>忌 / 少（同轴对照）</text>
              <text wx:if="{{ck.fit.sample}}" class="ck-tag">示例</text>
            </view>
            <view class="ck-bar" wx:for="{{ck.fit.avoid}}" wx:key="name">
              <text class="ck-bar-l">{{item.name}}</text>
              <view class="ck-track"><view class="ck-fill cin" style="width: {{item.w}}%"></view></view>
              <text class="ck-bar-v">{{item.v}}</text>
            </view>

            <view class="ck-cap ck-cap-gap">
              <text>忌口风险标签</text>
              <text wx:if="{{ck.fit.sample}}" class="ck-tag">示例</text>
            </view>
            <view class="ck-bar" wx:for="{{ck.fit.risk}}" wx:key="name">
              <text class="ck-bar-l">{{item.name}}</text>
              <view class="ck-track"><view class="ck-fill cin" style="width: {{item.w}}%"></view></view>
              <text class="ck-bar-v">{{item.v}}</text>
            </view>

            <text class="ck-pnote">{{ck.fit.note}}</text>
          </view>

          <!-- 04 知识图谱（计数实算，节点示例） -->
          <view wx:if="{{ckTab === 'graph'}}" class="ck-p">
            <view class="ck-graph">
              <view class="ck-g-core">
                <text class="ck-g-core-n">{{ck.graph.core.name}}</text>
                <text class="ck-g-core-s">{{ck.graph.core.sub}}</text>
              </view>
              <view class="ck-g-rings">
                <view class="ck-g-ring" wx:for="{{ck.graph.rings}}" wx:key="name">
                  <text class="ck-g-ring-n">{{item.n}}</text>
                  <text class="ck-g-ring-l">{{item.name}}</text>
                </view>
              </view>
              <text class="ck-g-edge">{{ck.graph.edges}} 条关系边</text>
            </view>

            <view class="ck-cap ck-cap-gap">
              <text>主料节点</text>
              <text wx:if="{{ck.graph.sample}}" class="ck-tag">示例</text>
            </view>
            <view class="ck-bar" wx:for="{{ck.graph.ingredients}}" wx:key="name">
              <text class="ck-bar-l">{{item.name}}</text>
              <view class="ck-track"><view class="ck-fill ochre" style="width: {{item.w}}%"></view></view>
              <text class="ck-bar-v">{{item.v}}</text>
            </view>

            <view class="ck-cap ck-cap-gap">
              <text>体质节点</text>
              <text wx:if="{{ck.graph.sample}}" class="ck-tag">示例</text>
            </view>
            <view class="ck-bar" wx:for="{{ck.graph.fits}}" wx:key="name">
              <text class="ck-bar-l">{{item.name}}</text>
              <view class="ck-track"><view class="ck-fill bam" style="width: {{item.w}}%"></view></view>
              <text class="ck-bar-v">{{item.v}}</text>
            </view>

            <text class="ck-pnote">{{ck.graph.note}}</text>
          </view>

          <!-- 05 食材深库（示例） -->
          <view wx:if="{{ckTab === 'library'}}" class="ck-p">
            <view class="ck-cap">
              <text>291 条索引怎么变成 222 张卡</text>
              <text wx:if="{{ck.library.sample}}" class="ck-tag">示例</text>
            </view>
            <view class="ck-fn" wx:for="{{ck.library.funnel}}" wx:key="name">
              <text class="ck-fn-l">{{item.name}}</text>
              <view class="ck-fn-bar ck-tone-{{item.tone}}" style="width: {{item.w}}%">
                <text>{{item.n}}</text>
              </view>
            </view>

            <view class="ck-cap ck-cap-gap">
              <text>成熟度</text>
            </view>
            <view class="ck-lv" wx:for="{{ck.library.levels}}" wx:key="name">
              <text class="ck-lv-l">{{item.name}}</text>
              <view class="ck-track">
                <view class="ck-fill {{item.building ? 'hatch' : 'jade'}}" style="width: {{item.pct}}%"></view>
              </view>
              <text class="ck-lv-v">{{item.note}}</text>
            </view>

            <view class="ck-cap ck-cap-gap">
              <text>出处构成（288 道）</text>
            </view>
            <view class="ck-stack ck-stack-lib">
              <view wx:for="{{ck.library.sources}}" wx:key="name" style="width: {{item.pct}}%; background-color: {{item.dim ? 'rgba(243,234,218,0.18)' : (index === 0 ? '#3e7f72' : '#c9a227')}}"></view>
            </view>
            <view class="ck-legend">
              <text wx:for="{{ck.library.sources}}" wx:key="name">{{item.name}} {{item.n}}</text>
            </view>

            <text class="ck-pnote">{{ck.library.note}}</text>
          </view>
        </view>
      </view>
    </block>
  </view>

  <disclaimer />

  <!-- 登录后的功能引导：跨三页走，进度在 app.globalData.tour -->
  <guide-tour
    visible="{{tourVisible}}"
    step="{{tourStep}}"
    index="{{tourIndex}}"
    total="{{tourTotal}}"
    bind:next="onTourNext"
    bind:skip="onTourSkip"
  />
</view>
