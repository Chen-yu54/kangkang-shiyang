/* pages/index/index.wxss —— 推荐页（杂志封面版）
 * 约束：字号 / 颜色 / 圆角 / 阴影 / 点击区一律取 app.wxss 的 CSS 变量。
 * 首屏：长辈模式条 → 节气封面 hero（立冬海报）→ 栏目头 → 当令菜展示牌。
 * 时辰问候条与节气文化卡已移去食养 tab，首页不再压别的内容。
 */

/* ==================== 1. 封面 hero：暗底食光层 ==================== */
.hero {
  position: relative;
  /* 600 → 560：封面仍是暗底开场，但把主区的栏目引题往上提 40rpx，
     首屏能看见「本期 · 节气食单 / 当令菜」而不是只剩一张海报 */
  height: 560rpx;
  margin-bottom: 24rpx;
  border-radius: var(--radius-card);
  box-shadow: var(--shadow-deep);
  overflow: hidden;
  background-color: var(--color-night);
}

.hero-poster {
  position: absolute;
  top: 0;
  right: 0;
  bottom: 0;
  left: 0;
  width: 100%;
  height: 100%;
}

.hero-fallback {
  position: absolute;
  top: 0;
  right: 0;
  bottom: 0;
  left: 0;
  background-image: linear-gradient(160deg, var(--color-night-2) 0%, var(--color-night) 100%);
}

/* 全屏暖黑压暗：顶部透气、底部沉，让上方字与底部字都可读；
 * 再叠一层暗角把视线收向中央食物。色值取夜色变量，不写死。
 * 海报是浅色水墨，底部渐变需压到 0.78 才能托住反白正文。 */
.hero-shade {
  position: absolute;
  top: 0;
  right: 0;
  bottom: 0;
  left: 0;
  background-image:
    linear-gradient(
      180deg,
      rgba(34, 23, 18, 0.52) 0%,
      rgba(34, 23, 18, 0.06) 26%,
      rgba(34, 23, 18, 0.3) 56%,
      rgba(34, 23, 18, 0.78) 100%
    ),
    radial-gradient(ellipse at center, rgba(34, 23, 18, 0) 50%, rgba(34, 23, 18, 0.46) 100%);
}

/* 顶部刊名栏 */
.hero-top {
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  padding: 24rpx 28rpx 0;
}

.hero-kicker {
  font-size: var(--font-caption);
  letter-spacing: var(--tracking-caps);
  color: var(--color-on-night-dim);
  padding-top: 8rpx;
}

/* 朱砂日期印章：只打日期（如 11.7），节气名由海报书法字承担 */
.hero-seal {
  display: flex;
  align-items: center;
  justify-content: center;
  min-width: 88rpx;
  height: 76rpx;
  padding: 0 14rpx;
  border-radius: 10rpx;
  background-color: var(--color-flame);
  box-shadow: 0 4rpx 12rpx rgba(24, 16, 10, 0.4);
}

.hero-seal-text {
  font-family: var(--font-serif);
  font-size: var(--font-seal-sm);
  line-height: 1.15;
  letter-spacing: 0.02em;
  text-align: center;
  color: var(--color-on-night);
}

/* 底部信息 */
.hero-foot {
  position: absolute;
  left: 32rpx;
  right: 32rpx;
  bottom: 28rpx;
  display: flex;
  flex-direction: column;
  align-items: flex-start;
}

.hero-headline {
  font-family: var(--font-serif);
  font-size: var(--font-title);
  line-height: 1.4;
  color: var(--color-on-night);
  text-shadow: 0 2rpx 12rpx rgba(24, 16, 10, 0.5);
}

.hero-hint {
  margin-top: 6rpx;
  font-size: var(--font-base);
  color: var(--color-on-night-dim);
}

.hero-ainote {
  margin-top: 14rpx;
  padding: 4rpx 14rpx;
  border: 1rpx solid rgba(246, 236, 216, 0.34);
  border-radius: 999rpx;
  font-size: var(--font-caption);
  letter-spacing: var(--tracking-caps);
  color: var(--color-on-night-dim);
}

/* 蒸汽：右下角三道，缓慢上升 */
.hero-steam {
  position: absolute;
  right: 15%;
  bottom: 24%;
  width: 0;
  height: 0;
  pointer-events: none;
}

.hero-steam-i {
  position: absolute;
  bottom: 0;
  width: 16rpx;
  height: 110rpx;
  border-radius: 999rpx;
  background-image: linear-gradient(180deg, rgba(255, 252, 244, 0) 0%, rgba(255, 252, 244, 0.9) 45%, rgba(255, 252, 244, 0) 100%);
  opacity: 0;
  animation: hero-steam-rise 3.6s ease-in-out infinite;
}

.hero-steam-1 { right: 0; animation-delay: 0s; }
.hero-steam-2 { right: 32rpx; height: 142rpx; animation-delay: 1.2s; }
.hero-steam-3 { right: 64rpx; height: 92rpx; animation-delay: 2.4s; }

@keyframes hero-steam-rise {
  0%   { transform: translateY(28rpx) translateX(0) scaleY(0.7); opacity: 0; }
  28%  { opacity: 0.9; }
  62%  { transform: translateY(-110rpx) translateX(-12rpx) scaleY(1); opacity: 0.5; }
  100% { transform: translateY(-190rpx) translateX(10rpx) scaleY(1.15); opacity: 0; }
}

/* ==================== 2.3 主区栏目头：朱砂引题 + 粗书口线 ====================
 * 「当令菜」是推荐页的主区标题。层级靠三件事拉开，不靠加粗加大乱来：
 *   ① 朱砂引题（本期 · 节气推荐）在上面起头
 *   ② 标题 48rpx + 宋体 + 宽字距 + 前面一枚书口序号
 *   ③ 双线书口加粗到 6rpx，风物区只有 2rpx 细线
 * 右侧给节气签（立冬）与道数（3 道），节气名不重复进标题（海报已有书法字）。 */
.lead {
  margin: 4rpx 0 22rpx;
}

.lead-kicker {
  display: block;
  font-size: var(--font-caption);
  letter-spacing: var(--tracking-caps);
  color: var(--color-flame);
}

.lead-row {
  position: relative;
  display: flex;
  align-items: baseline;
  justify-content: space-between;
  margin-top: 10rpx;
  padding-bottom: 16rpx;
  border-bottom: 6rpx solid var(--color-ink);
}

/* 书口细线：跟 .masthead 一样的「一粗一细」印刷件 */
.lead-row::after {
  content: '';
  position: absolute;
  left: 0;
  right: 0;
  bottom: 5rpx;
  border-bottom: 2rpx solid var(--color-ink);
}

.lead-main {
  display: flex;
  align-items: baseline;
  min-width: 0;
}

.lead-no {
  flex: none;
  margin-right: 16rpx;
  font-family: var(--font-serif);
  font-size: var(--font-caption);
  letter-spacing: var(--tracking-caps);
  color: var(--color-flame);
}

.lead-title {
  font-family: var(--font-serif);
  font-size: var(--font-title);
  font-weight: 600;
  letter-spacing: 0.1em;
  line-height: 1.2;
  color: var(--color-ink);
}

.lead-tags {
  flex: none;
  display: flex;
  align-items: baseline;
  margin-left: 16rpx;
}

/* 节气签：朱砂描边小印，代替标题里的「· 立冬」 */
.lead-term {
  padding: 2rpx 14rpx;
  border: 2rpx solid var(--color-flame);
  border-radius: 6rpx;
  font-family: var(--font-serif);
  font-size: var(--font-caption);
  line-height: 1.5;
  letter-spacing: 0.06em;
  color: var(--color-flame);
}

.lead-count {
  margin-left: 12rpx;
  font-size: var(--font-caption);
  color: var(--color-ink-3);
}

/* ==================== 3. 搜菜名 / 分隔 / 栏目头 ====================
 * 主区（当令菜）之后的内容统一降一档：搜索只剩一根细描边，
 * 风物区用居中小字分隔线，栏目头由 48rpx 双线降为 36rpx 单细线。 */
.search-entry {
  display: flex;
  align-items: center;
  justify-content: space-between;
  min-height: var(--tap-min);
  margin: 20rpx 0 0;
  padding: 0 24rpx;
  border: 2rpx solid var(--color-border-hair);
  border-radius: var(--radius-pill);
  background-color: transparent;
  box-sizing: border-box;
}

.search-text { font-size: var(--font-base); color: var(--color-ink-3); }

.search-go {
  font-family: var(--font-serif);
  font-size: var(--font-base);
  color: var(--color-border);
}

/* 风物区分隔：两根细线夹一个小字标签，像杂志里的「、」分隔页 */
.band {
  display: flex;
  align-items: center;
  margin: 40rpx 0 8rpx;
}

.band-rule {
  flex: 1;
  height: 2rpx;
  background-color: var(--color-border);
}

.band-label {
  flex: none;
  margin: 0 20rpx;
  font-family: var(--font-serif);
  font-size: 24rpx;
  letter-spacing: 0.3em;
  color: var(--color-ink-3);
}

/* 栏目头（次区）：序号 + 小标题 + 单细线 */
.sec {
  display: flex;
  align-items: baseline;
  justify-content: space-between;
  margin: 32rpx 0 18rpx;
  padding-bottom: 12rpx;
  border-bottom: 2rpx solid var(--color-border-hair);
}

.sec-main {
  display: flex;
  align-items: baseline;
  min-width: 0;
}

.sec-no {
  flex: none;
  margin-right: 14rpx;
  font-family: var(--font-serif);
  font-size: var(--font-caption);
  letter-spacing: var(--tracking-caps);
  color: var(--color-flame);
}

.sec-title {
  font-family: var(--font-serif);
  font-size: var(--font-base);
  letter-spacing: var(--tracking-title);
  color: var(--color-ink-2);
}

/* 风物区的荐语：字号降一档、上下留白收紧，读起来是「附文」不是「社论」。
 * 顶线去掉——上面紧跟分隔线，两道细线会叠成双横线；只留底线收尾。 */
.pullquote-quiet {
  padding: 30rpx 24rpx 26rpx;
  margin: 8rpx 0 4rpx;
}

.pullquote-quiet::before {
  display: none;
}

.pullquote-quiet .pullquote-text {
  font-size: var(--font-base);
  line-height: 1.85;
}

.pullquote-quiet::after {
  left: 34%;
  right: 34%;
}

/* ==================== 4. 节气文化卡（次区第一块） ====================
 * 只取三种色：纸（底）、墨（文字）、朱砂（小签 / 入口框）。
 * 冬季节气色是黛蓝，落在暖纸面上发冷，这里不走节气色；
 * 卡片不原地铺开：立冬 + 一句 + 诗，点「立冬的讲究」直接去节气详情页。 */
.tculture {
  padding: 26rpx 26rpx 22rpx;
  margin: 0 0 20rpx;
  background-color: var(--color-card);
  border: 2rpx solid var(--color-border-hair);
  border-radius: var(--radius-small);
  box-sizing: border-box;
}

.tculture-head {
  display: flex;
  align-items: baseline;
}

/* 「节气」两字做成一枚小签，让立冬两个字一眼是主角 */
.tculture-tag {
  flex: none;
  margin-right: 14rpx;
  padding: 2rpx 10rpx;
  font-size: var(--font-caption);
  letter-spacing: var(--tracking-title);
  color: var(--color-flame);
  border: 2rpx solid var(--color-flame);
  border-radius: 6rpx;
}

.tculture-term {
  flex: 1;
  min-width: 0;
  font-family: var(--font-serif);
  font-size: var(--font-title);
  font-weight: 600;
  letter-spacing: 8rpx;
  color: var(--color-ink);
}

.tculture-slogan {
  display: block;
  margin-top: 6rpx;
  font-family: var(--font-serif);
  font-size: var(--font-subtitle);
  letter-spacing: var(--tracking-title);
  color: var(--color-ink-2);
}

/* 诗句并进卡头：原来它单占一屏，跟文化卡说的是同一件事 */
.tculture-poem {
  margin-top: 16rpx;
  padding-left: 18rpx;
  border-left: 2rpx solid var(--color-border);
}

.tculture-poem-text {
  display: block;
  font-family: var(--font-serif);
  font-size: var(--font-base);
  line-height: 1.7;
  color: var(--color-ink-2);
}

.tculture-poem-by {
  display: block;
  margin-top: 4rpx;
  font-size: var(--font-caption);
  color: var(--color-ink-3);
}

/* 入口框：朱砂细边 + 极淡暖底，比正文块显眼一档，但仍是「纸上一页」不是按钮 */
.tmore {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-top: 18rpx;
  padding: 18rpx 20rpx;
  border: 2rpx solid var(--color-flame);
  border-radius: var(--radius-small);
  background-color: rgba(181, 72, 42, 0.06);
  box-sizing: border-box;
}

.tmore-main {
  flex: 1;
  min-width: 0;
}

.tmore-title {
  display: block;
  font-family: var(--font-serif);
  font-size: var(--font-base);
  font-weight: 600;
  letter-spacing: 2rpx;
  color: var(--color-flame);
}

.tmore-sub {
  display: block;
  margin-top: 4rpx;
  font-size: var(--font-caption);
  color: var(--color-ink-3);
}

.tmore-act {
  flex: none;
  margin-left: 12rpx;
  font-size: var(--font-caption);
  white-space: nowrap;
  color: var(--color-flame);
}

/* 展开到底再看整个节气页：挂在内容末尾，不占折叠态的位置 */
/* ==================== 5. 当令展示牌 ====================
 * 一道一屏自动轮播，图 + 展签（序号 / 菜名 / 做法）同步切换。
 * 上一版是「一张主推大卡 + 三列 296rpx 横滑卡」，做法文字在窄列里被压成
 * 两字一行、还读不完；改成整屏展示牌，一段话有两个整行可以落。 */
.showcase {
  margin-bottom: 4rpx;
}

.sc-swiper {
  height: 640rpx;
  border: 2rpx solid var(--color-border-hair);
  border-radius: var(--radius-card);
  background-color: var(--color-card);
  box-shadow: var(--shadow-lift);
  overflow: hidden;
}

.sc-slide {
  display: flex;
  flex-direction: column;
  height: 100%;
}

/* 展签：左边朱砂序号，右边菜名 + 做法——像展品旁边的说明牌 */
.sc-caption {
  flex: 1;
  display: flex;
  align-items: flex-start;
  padding: 22rpx 26rpx 16rpx;
  box-sizing: border-box;
  overflow: hidden;
}

.sc-no {
  flex: none;
  margin-right: 20rpx;
  padding-top: 6rpx;
  font-family: var(--font-serif);
  font-size: 40rpx;
  line-height: 1;
  letter-spacing: 0.02em;
  color: var(--color-flame);
}

.sc-cap-main {
  flex: 1;
  min-width: 0;
}

.sc-cap-head {
  display: flex;
  align-items: baseline;
}

.sc-name {
  max-width: 400rpx;
  font-family: var(--font-serif);
  font-size: var(--font-subtitle);
  letter-spacing: var(--tracking-title);
  line-height: 1.3;
  color: var(--color-ink);
  overflow: hidden;
  white-space: nowrap;
  text-overflow: ellipsis;
}

.sc-cuisine {
  flex: none;
  margin-left: 14rpx;
  font-size: var(--font-caption);
  letter-spacing: 0.08em;
  color: var(--color-ink-3);
}

/* 做法：最多两行，超出裁掉（完整做法在菜品详情页） */
.sc-how {
  display: -webkit-box;
  -webkit-box-orient: vertical;
  -webkit-line-clamp: 2;
  margin-top: 8rpx;
  font-size: var(--font-btn);
  line-height: 1.5;
  color: var(--color-ink-2);
  overflow: hidden;
}

/* 轮播刻度：一格一道菜，当前格朱砂填满 */
.sc-dots {
  display: flex;
  align-items: center;
  justify-content: center;
  padding-top: 18rpx;
}

.sc-dot {
  width: 40rpx;
  height: 4rpx;
  margin: 0 6rpx;
  border-radius: 2rpx;
  background-color: var(--color-border);
  transition: width 0.2s ease, background-color 0.2s ease;
}

.sc-dot-on {
  width: 64rpx;
  background-color: var(--color-flame);
}

/* 全部入口：主区的收尾动作，比风物区文字重半档 */
.section-more {
  display: flex;
  align-items: center;
  justify-content: flex-end;
  padding: 14rpx 0 4rpx;
}

.section-more-text { font-size: var(--font-btn); color: var(--color-ink-2); }
.section-more-arrow { width: 28rpx; height: 28rpx; margin-left: 4rpx; }

/* ==================== 6. 跟着节气吃：节气驾驶舱 ====================
 * 深色卡，与封面呼应。左罗盘（24 刻度 / 四季弧 / 当前节气），右三组数字，
 * 下排三个环；点「展开全部数据」在卡内切五个分区。
 * 颜色纪律：整块只用三种色 —— 墨底、青瓷（数据）、赤金（刻度与选中）。
 * 环的进度用 conic-gradient 画，百分比同时有数字，颜色识别不了也读得懂。 */
.ck {
  padding: 30rpx 28rpx 22rpx;
  border-radius: 28rpx;
  background-image: linear-gradient(150deg, #241d15 0%, #14100b 100%);
  box-shadow: 0 14rpx 36rpx rgba(34, 23, 18, 0.22);
  overflow: hidden;
}

.ck-top {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.ck-live {
  display: flex;
  align-items: center;
}

.ck-dot {
  width: 10rpx;
  height: 10rpx;
  margin-right: 10rpx;
  border-radius: 50%;
  background-color: #7fc9ba;
  box-shadow: 0 0 10rpx rgba(127, 201, 186, 0.7);
  animation: ck-breathe 2.4s ease-in-out infinite;
}

.ck-live-t {
  font-size: 22rpx;
  letter-spacing: 0.14em;
  color: rgba(232, 220, 196, 0.9);
}

.ck-asof {
  font-size: 20rpx;
  color: rgba(232, 220, 196, 0.45);
}

/* —— 罗盘 —— */
.ck-hero {
  display: flex;
  align-items: center;
  margin-top: 20rpx;
}

.ck-compass {
  position: relative;
  flex: none;
  width: 264rpx;
  height: 264rpx;
}

/* 四季弧：四段 87° 的金弧，段间留 3° 缝；中间挖空成细环。
   用 conic-gradient 而不是四个只露上边框的圆——后者四段会连成一个整圆，看不出「季」。 */
.ck-arcs {
  position: absolute;
  left: 14rpx;
  top: 14rpx;
  width: 236rpx;
  height: 236rpx;
  border-radius: 50%;
  background-image: conic-gradient(
    from -90deg,
    rgba(201, 162, 39, 0.34) 0deg 87deg,
    transparent 87deg 90deg,
    rgba(201, 162, 39, 0.34) 90deg 177deg,
    transparent 177deg 180deg,
    rgba(201, 162, 39, 0.34) 180deg 267deg,
    transparent 267deg 270deg,
    rgba(201, 162, 39, 0.62) 270deg 357deg,
    transparent 357deg 360deg
  );
}

.ck-arcs::after {
  content: '';
  position: absolute;
  left: 8rpx;
  top: 8rpx;
  right: 8rpx;
  bottom: 8rpx;
  border-radius: 50%;
  background-color: #1c1811;
}

/* 24 根刻度：left/top 由 cockpit.buildTicks 按圆心算好，这里只对齐中心 */
.ck-tick {
  position: absolute;
  width: 3rpx;
  height: 16rpx;
  margin-left: -1.5rpx;
  margin-top: -8rpx;
  border-radius: 2rpx;
  background-color: rgba(201, 162, 39, 0.34);
  opacity: 0;
}

.ck-compass.on .ck-tick {
  animation: ck-tick-in 0.4s ease-out both;
}

.ck-tick.on {
  background-color: rgba(230, 186, 98, 0.85);
}

.ck-tick.now {
  height: 22rpx;
  margin-top: -11rpx;
  background-color: #f4dda9;
  box-shadow: 0 0 10rpx rgba(244, 221, 169, 0.85);
}

.ck-season {
  position: absolute;
  font-family: var(--font-serif);
  font-size: 18rpx;
  letter-spacing: 1rpx;
  color: rgba(201, 162, 39, 0.66);
  transform: translate(-50%, -50%);
}

.ck-season-1 { left: 200rpx; top: 64rpx; }
.ck-season-2 { left: 200rpx; top: 200rpx; }
.ck-season-3 { left: 64rpx; top: 200rpx; }
.ck-season-4 { left: 64rpx; top: 64rpx; }

.ck-face {
  position: absolute;
  left: 56rpx;
  top: 56rpx;
  width: 152rpx;
  height: 152rpx;
  border-radius: 50%;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  background-image: radial-gradient(circle at 50% 34%, #2c3b35 0%, #1c2a26 62%, #16211e 100%);
  box-shadow: inset 0 0 24rpx rgba(0, 0, 0, 0.35);
}

.ck-term {
  font-family: var(--font-serif);
  font-size: 44rpx;
  letter-spacing: 3rpx;
  line-height: 1.1;
  color: #f6eedf;
}

.ck-pos {
  margin-top: 6rpx;
  font-size: 18rpx;
  letter-spacing: 0.5rpx;
  color: #7fc9ba;
}

/* —— 右侧三组数字 —— */
.ck-kpis {
  flex: 1;
  min-width: 0;
  margin-left: 18rpx;
}

.ck-kpi {
  padding: 12rpx 0;
  border-bottom: 1rpx solid rgba(243, 234, 218, 0.12);
}

.ck-kpi:last-child {
  border-bottom: 0;
}

.ck-kpi-n {
  display: flex;
  align-items: baseline;
}

.ck-num {
  font-family: var(--font-serif);
  font-size: 48rpx;
  line-height: 1;
  color: #f6eedf;
}

.ck-unit {
  margin-left: 4rpx;
  font-size: 20rpx;
  color: #7fc9ba;
}

.ck-k {
  display: block;
  margin-top: 2rpx;
  font-size: 22rpx;
  letter-spacing: 0.04em;
  color: #e9dcc6;
}

.ck-s {
  display: block;
  margin-top: 2rpx;
  font-size: 20rpx;
  line-height: 1.4;
  color: rgba(243, 234, 218, 0.48);
}

/* —— 三个环 —— */
.ck-rings {
  display: flex;
  margin-top: 24rpx;
  padding-top: 22rpx;
  border-top: 1rpx solid rgba(243, 234, 218, 0.12);
}

.ck-ring-item {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
}

.ck-ring {
  position: relative;
  width: 104rpx;
  height: 104rpx;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
}

.ck-ring-in {
  width: 84rpx;
  height: 84rpx;
  border-radius: 50%;
  background-color: #1b1710;
  display: flex;
  align-items: center;
  justify-content: center;
}

.ck-ring-t {
  font-size: 22rpx;
  color: #f3eada;
}

.ck-rk {
  margin-top: 10rpx;
  font-size: 22rpx;
  color: #eadcc6;
}

.ck-rs {
  margin-top: 2rpx;
  font-size: 18rpx;
  color: rgba(243, 234, 218, 0.45);
}

.ck-note {
  display: block;
  margin-top: 20rpx;
  font-size: 20rpx;
  line-height: 1.65;
  color: rgba(243, 234, 218, 0.5);
}

/* —— 展开 / 收起 —— */
.ck-more {
  display: flex;
  align-items: center;
  justify-content: center;
  margin-top: 18rpx;
  padding: 14rpx 0 4rpx;
  border-top: 1rpx solid rgba(243, 234, 218, 0.12);
}

.ck-more-t {
  font-size: 22rpx;
  letter-spacing: 0.08em;
  color: #c9a227;
}

.ck-chev {
  margin-left: 8rpx;
  font-size: 24rpx;
  line-height: 1;
  color: #c9a227;
  transition: transform 0.25s ease;
}

.ck-chev.up {
  transform: rotate(180deg);
}

/* —— 分区台 —— */
.ck-panel {
  margin-top: 14rpx;
}

/* 五个分区不横滑、直接换行：小屏上横滑会把第 5 个藏起来，
   换行虽然多占一行，但五个入口一眼全见，选中态也不会跑到屏幕外。 */
.ck-tabs {
  display: flex;
  flex-wrap: wrap;
  margin: 0 -5rpx;
}

.ck-tab {
  display: flex;
  align-items: center;
  margin: 0 5rpx 10rpx;
  padding: 12rpx 18rpx;
  border: 1rpx solid rgba(243, 234, 218, 0.16);
  border-radius: 999rpx;
  font-size: 22rpx;
  color: rgba(243, 234, 218, 0.62);
}

.ck-tab.on {
  border-color: rgba(201, 162, 39, 0.75);
  background-color: rgba(201, 162, 39, 0.14);
  color: #f0d79a;
}

.ck-tab-n {
  margin-right: 8rpx;
  font-size: 18rpx;
  color: rgba(201, 162, 39, 0.8);
}

.ck-tab.on .ck-tab-n {
  color: #f0d79a;
}

.ck-pcap {
  display: block;
  margin: 16rpx 2rpx 2rpx;
  font-size: 20rpx;
  letter-spacing: 0.04em;
  color: rgba(243, 234, 218, 0.42);
}

.ck-p {
  margin-top: 6rpx;
}

/* 指标网格 6 格 */
.ck-metrics {
  display: flex;
  flex-wrap: wrap;
  margin-top: 6rpx;
}

.ck-metric {
  width: 33.33%;
  padding: 14rpx 0;
  box-sizing: border-box;
  text-align: center;
  border-right: 1rpx solid rgba(243, 234, 218, 0.08);
  border-bottom: 1rpx solid rgba(243, 234, 218, 0.08);
}

.ck-metric:nth-child(3n) {
  border-right: 0;
}

.ck-metric-n {
  display: flex;
  align-items: baseline;
  justify-content: center;
}

.ck-mv {
  font-family: var(--font-serif);
  font-size: 36rpx;
  line-height: 1.1;
  color: #f6eedf;
}

.ck-mu {
  margin-left: 2rpx;
  font-size: 18rpx;
  color: #7fc9ba;
}

.ck-ml {
  display: block;
  margin-top: 4rpx;
  font-size: 18rpx;
  line-height: 1.3;
  color: rgba(243, 234, 218, 0.5);
}

/* 24 节气格 */
.ck-cells {
  display: flex;
  flex-wrap: wrap;
  margin-top: 14rpx;
}

.ck-cell {
  width: 16.66%;
  padding: 8rpx 0;
  box-sizing: border-box;
  text-align: center;
}

.ck-cell-t {
  font-size: 20rpx;
  color: rgba(243, 234, 218, 0.5);
}

.ck-cell.cur .ck-cell-t {
  font-weight: 600;
  color: #e7c75b;
}

/* 菜系卡 */
.ck-cu {
  margin-top: 14rpx;
  padding: 16rpx;
  border: 1rpx solid rgba(243, 234, 218, 0.1);
  border-radius: 16rpx;
  background-color: rgba(255, 255, 255, 0.02);
}

.ck-cu-h {
  display: flex;
  align-items: baseline;
  justify-content: space-between;
}

.ck-cu-n {
  font-family: var(--font-serif);
  font-size: 26rpx;
  color: #f3eada;
}

.ck-cu-v {
  font-size: 20rpx;
  color: rgba(243, 234, 218, 0.5);
}

.ck-stack {
  display: flex;
  height: 14rpx;
  margin: 12rpx 0 10rpx;
  border-radius: 7rpx;
  overflow: hidden;
  background-color: rgba(243, 234, 218, 0.08);
}

.ck-stack-lib {
  height: 18rpx;
  margin: 10rpx 0 8rpx;
}

.ck-legend {
  display: flex;
  justify-content: space-between;
  font-size: 20rpx;
  color: rgba(243, 234, 218, 0.5);
}

.ck-cu-f {
  display: block;
  margin-top: 10rpx;
  padding-top: 10rpx;
  border-top: 1rpx dashed rgba(243, 234, 218, 0.12);
  font-size: 20rpx;
  color: rgba(243, 234, 218, 0.55);
}

/* 条形 */
.ck-bar {
  display: flex;
  align-items: center;
  margin-top: 10rpx;
}

.ck-bar-l {
  flex: none;
  width: 112rpx;
  font-size: 20rpx;
  color: rgba(243, 234, 218, 0.72);
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}

.ck-track {
  flex: 1;
  height: 10rpx;
  margin: 0 12rpx;
  border-radius: 5rpx;
  background-color: rgba(243, 234, 218, 0.08);
  overflow: hidden;
}

.ck-fill {
  height: 100%;
  border-radius: 5rpx;
}

.ck-fill.jade {
  background-image: linear-gradient(90deg, #7fc9ba, #3e7f72);
}

.ck-fill.bam {
  background-image: linear-gradient(90deg, #8fae84, #5b7f52);
}

.ck-fill.cin {
  background-image: linear-gradient(90deg, #c96a51, #b4442f);
}

.ck-fill.ochre {
  background-image: linear-gradient(90deg, #a98462, #8c6a4a);
}

.ck-fill.hatch {
  background-image: repeating-linear-gradient(45deg, rgba(154, 145, 134, 0.5) 0 4rpx, transparent 4rpx 8rpx);
}

.ck-bar-v {
  flex: none;
  width: 72rpx;
  text-align: right;
  font-size: 20rpx;
  color: rgba(243, 234, 218, 0.55);
}

/* 小标题 + 示例标签 */
.ck-cap {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-top: 16rpx;
  font-size: 20rpx;
  letter-spacing: 0.06em;
  color: rgba(243, 234, 218, 0.45);
}

.ck-cap-gap {
  margin-top: 24rpx;
}

.ck-tag {
  padding: 2rpx 10rpx;
  border: 1rpx solid rgba(201, 162, 39, 0.45);
  border-radius: 6rpx;
  font-size: 18rpx;
  letter-spacing: 0.06em;
  color: rgba(201, 162, 39, 0.9);
}

/* 图谱摘要 */
.ck-graph {
  display: flex;
  flex-direction: column;
  align-items: center;
  margin-top: 12rpx;
  padding: 22rpx 16rpx;
  border: 1rpx solid rgba(201, 162, 39, 0.18);
  border-radius: 16rpx;
  background-image: linear-gradient(150deg, #221b13, #120e09);
}

.ck-g-core {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  width: 140rpx;
  height: 140rpx;
  border: 1rpx solid rgba(201, 162, 39, 0.5);
  border-radius: 50%;
  background-color: rgba(232, 220, 196, 0.06);
}

.ck-g-core-n {
  font-family: var(--font-serif);
  font-size: 22rpx;
  color: #f3eada;
}

.ck-g-core-s {
  margin-top: 4rpx;
  font-size: 18rpx;
  color: #7fc9ba;
}

.ck-g-rings {
  display: flex;
  width: 100%;
  margin-top: 18rpx;
}

.ck-g-ring {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
}

.ck-g-ring-n {
  font-family: var(--font-serif);
  font-size: 32rpx;
  line-height: 1.1;
  color: #f6eedf;
}

.ck-g-ring-l {
  margin-top: 2rpx;
  font-size: 18rpx;
  color: rgba(243, 234, 218, 0.5);
}

.ck-g-edge {
  margin-top: 14rpx;
  font-size: 18rpx;
  letter-spacing: 0.06em;
  color: rgba(201, 162, 39, 0.8);
}

/* 漏斗 */
.ck-fn {
  display: flex;
  align-items: center;
  margin-top: 8rpx;
}

.ck-fn-l {
  flex: none;
  width: 150rpx;
  font-size: 20rpx;
  color: rgba(243, 234, 218, 0.7);
}

.ck-fn-bar {
  height: 40rpx;
  min-width: 64rpx;
  padding: 0 10rpx;
  box-sizing: border-box;
  border-radius: 6rpx;
  display: flex;
  align-items: center;
}

.ck-fn-bar text {
  font-size: 18rpx;
  color: #12100b;
}

.ck-tone-jade {
  background-image: linear-gradient(90deg, #7fc9ba, #3e7f72);
}

.ck-tone-gold {
  background-color: #c9a227;
}

.ck-tone-ochre {
  background-color: #8c6a4a;
}

.ck-tone-stone {
  background-color: rgba(154, 145, 134, 0.8);
}

.ck-tone-ochre text,
.ck-tone-stone text {
  color: #f7f0e1;
}

/* 分层 */
.ck-lv {
  display: flex;
  align-items: center;
  margin-top: 10rpx;
}

.ck-lv-l {
  flex: none;
  width: 140rpx;
  font-size: 20rpx;
  color: rgba(243, 234, 218, 0.7);
}

.ck-lv-v {
  flex: none;
  width: 100rpx;
  text-align: right;
  font-size: 18rpx;
  color: rgba(243, 234, 218, 0.5);
}

.ck-pnote {
  display: block;
  margin-top: 18rpx;
  padding-top: 14rpx;
  border-top: 1rpx dashed rgba(243, 234, 218, 0.12);
  font-size: 20rpx;
  line-height: 1.7;
  color: rgba(243, 234, 218, 0.45);
}

@keyframes ck-breathe {
  0%, 100% { opacity: 0.4; }
  50% { opacity: 1; }
}

/* 只动透明度：刻度本身带 inline rotate，动 transform 会把角度覆盖掉 */
@keyframes ck-tick-in {
  from { opacity: 0; }
  to { opacity: 1; }
}

.tap-hover { opacity: 0.82; }

/* ==================== 7. 长辈模式（1.6 倍字）====================
 * 大字的问题不是字大，是「一行塞两栏」的版式撑不住：
 * 绝对定位的封面信息会叠字、限定两行的做法会被裁、右侧标签会掉行。
 * 这一档统一改成「只保顺序、不保栏位」：
 *   ① 封面从绝对定位改成纵向流，高度随字长
 *   ② 菜名允许换行，做法不再限两行
 *   ③ 展示牌加高，让展签有地方落
 *   ④ 次区的数字仪表盘整块收起（入口在 WXML 里用 elderMode 控制）
 */
.elder .hero {
  display: flex;
  flex-direction: column;
  justify-content: space-between;
  height: auto;
  min-height: 520rpx;
  padding: 24rpx 28rpx 30rpx;
  box-sizing: border-box;
}

/* 海报是绝对定位的贴图层，会盖住处于普通文档流里的兄弟节点。
   这里不能退回 static——必须留 relative + z-index，否则大字档下
   刊名、日期印、标题全被海报压在下面（看不见字，只剩一张图）。 */
.elder .hero-top {
  position: relative;
  z-index: 2;
  padding: 0;
}

.elder .hero-foot {
  position: relative;
  z-index: 2;
  left: auto;
  right: auto;
  bottom: auto;
  margin-top: 40rpx;
}

.elder .hero-kicker {
  line-height: 1.5;
}

.elder .lead-row {
  flex-wrap: wrap;
  align-items: flex-end;
}

.elder .lead-tags {
  margin-left: 0;
  margin-top: 10rpx;
}

.elder .sc-swiper {
  height: 800rpx;
}

.elder .sc-caption {
  padding: 24rpx 24rpx 20rpx;
}

.elder .sc-cap-head {
  flex-wrap: wrap;
}

.elder .sc-name {
  max-width: 100%;
  white-space: normal;
  overflow: visible;
  text-overflow: clip;
}

.elder .sc-cuisine {
  margin-left: 0;
  margin-top: 4rpx;
}

.elder .sc-how {
  -webkit-line-clamp: 3;
}

.elder .tculture-head {
  flex-wrap: wrap;
}

.elder .tmore {
  flex-wrap: wrap;
}

.elder .tmore-act {
  margin-left: 0;
  margin-top: 8rpx;
}

.elder .search-entry {
  padding: 12rpx 24rpx;
}

/* 蒸汽是通感装饰，长辈模式下省掉，把首屏留给真实的节气海报与菜名 */
.elder .hero-steam {
  display: none;
}
/* 问问康康入口：与搜索框并排的对话入口。
   墨绿圆形头像 + 两行文案，点击区 108rpx。 */
.ask-entry {
  display: flex;
  align-items: center;
  margin: 20rpx 32rpx 0;
  padding: 24rpx 26rpx;
  min-height: 108rpx;
  background: #fdf8ee;
  border: 2rpx solid rgba(63, 122, 69, 0.24);
  border-radius: 16rpx;
}

.ask-ava {
  width: 76rpx;
  height: 76rpx;
  border-radius: 24rpx;
  background: #3f7a45;
  color: #ffffff;
  font-size: 34rpx;
  font-weight: 700;
  display: flex;
  align-items: center;
  justify-content: center;
  flex: none;
  margin-right: 20rpx;
}

.ask-body {
  flex: 1;
  min-width: 0;
}

.ask-title {
  display: block;
  font-size: 38rpx;
  font-weight: 700;
  color: #2d241a;
}

.ask-sub {
  display: block;
  margin-top: 4rpx;
  font-size: 32rpx;
  color: #8b7a5b;
}

.ask-go {
  font-size: 40rpx;
  color: #3f7a45;
  flex: none;
  margin-left: 12rpx;
}
/* 第二个入口（康康对话）：用浅底 + 棕色边，与「问问康康」问卷入口区分开，
   不要让用户觉得是同一个按钮点了两次。 */
.ask-entry-alt {
  background: #fdfaf4;
  border-color: rgba(139, 90, 43, 0.22);
  margin-top: 14rpx;
}

.ask-ava-alt {
  background: #8b5a2b;
}
