  background-color: rgba(181, 72, 42, 0.07);
}

.cp-go-main { flex: 1; min-width: 0; display: flex; flex-direction: column; }
.cp-go-t { font-size: var(--font-btn); font-weight: 600; color: var(--color-flame-deep); }
.cp-go-s { margin-top: 4rpx; font-size: var(--font-tiny); color: var(--color-ink-3); }
.cp-go-a { flex: none; margin-left: 12rpx; font-size: var(--font-subtitle); color: var(--color-flame); }

@keyframes cp-breathe {
  0%, 100% { opacity: 0.45; }
  50% { opacity: 1; }
}

@keyframes cp-tick-in {
  from { opacity: 0; }
  to { opacity: 1; }
}
.tap-hover { opacity: 0.82; }

/* ==================== 7. 长辈模式（1.6 倍字）====================
 * 大字的问题不是字大，是「一行塞两栏」的版式撑不住：
 * 绝对定位的封面信息会叠字、限定两行的做法会被裁、右侧标签会掉行。
 * 这一档统一改成「只保顺序、不保栏位」：
 *   ① 封面从绝对定位改成纵向流，高度随字长
 *   ② 菜名允许换行，做法不再限两行
 *   ③ 展示牌加高，让展签有地方落
 *   ④ 次区的数字仪表盘整块收起（入口在 WXML 里用 elderMode 控制）
 */
.elder .hero {
  display: flex;
  flex-direction: column;
  justify-content: space-between;
  height: auto;
  min-height: 520rpx;
  padding: 24rpx 28rpx 30rpx;
  box-sizing: border-box;
}

/* 海报是绝对定位的贴图层，会盖住处于普通文档流里的兄弟节点。
   这里不能退回 static——必须留 relative + z-index，否则大字档下
   刊名、日期印、标题全被海报压在下面（看不见字，只剩一张图）。 */
.elder .hero-top {
  position: relative;
  z-index: 2;
  padding: 0;
}

.elder .hero-foot {
  position: relative;
  z-index: 2;
  left: auto;
  right: auto;
  bottom: auto;
  margin-top: 40rpx;
}

.elder .hero-kicker {
  line-height: 1.6;
}

.elder .lead-row {
  flex-wrap: wrap;
  align-items: flex-end;
}

.elder .lead-tags {
  margin-left: 0;
  margin-top: 10rpx;
}

.elder .sc-swiper {
  height: 800rpx;
}

.elder .sc-caption {
  padding: 24rpx 24rpx 20rpx;
}

.elder .sc-cap-head {
  flex-wrap: wrap;
}

.elder .sc-name {
  max-width: 100%;
  white-space: normal;
  overflow: visible;
  text-overflow: clip;
}

.elder .sc-cuisine {
  margin-left: 0;
  margin-top: 4rpx;
}

.elder .sc-how {
  -webkit-line-clamp: 3;
}

.elder .tculture-head {
  flex-wrap: wrap;
}

.elder .tmore {
  flex-wrap: wrap;
}

.elder .tmore-act {
  margin-left: 0;
  margin-top: 8rpx;
}

.elder .search-entry {
  padding: 12rpx 24rpx;
}

/* 蒸汽是通感装饰，长辈模式下省掉，把首屏留给真实的节气海报与菜名 */
.elder .hero-steam {
  display: none;
}
/* ==================== 8. 康康悬浮球 ====================
   三个对话入口（问问康康 / AI 问答 / 康康对话）合成一颗球：
   右下固定、避开 tabBar，logo 走「康康食养 AI」的品牌图，气泡按时段说话。
   颜色全部取纸底那一套，不引入新色。 */
/* 首次引导：康康「发来一条消息」的顶部浮层。
   z-index 要高过引导遮罩(9000)——它是亮圈里的主角，得能看清、能点。 */
.intro-msg {
  position: fixed;
  left: 24rpx;
  right: 24rpx;
  top: 140rpx;
  z-index: 9200;
  display: flex;
  align-items: center;
  padding: 22rpx 24rpx;
  background: #FFFFFF;
  border: 2rpx solid rgba(31, 74, 54, 0.18);
  border-left: 8rpx solid #1F4A36;
  border-radius: 18rpx;
  box-shadow: 0 16rpx 40rpx rgba(24, 16, 10, 0.28);
  box-sizing: border-box;
  animation: introDrop 0.5s cubic-bezier(0.2, 0.9, 0.3, 1.2) both;
}

@keyframes introDrop {
  from { opacity: 0; transform: translateY(-40rpx) scale(0.96); }
  to { opacity: 1; transform: translateY(0) scale(1); }
}

.intro-ava {
  width: 84rpx;
  height: 84rpx;
  border-radius: 50%;
  flex: none;
  margin-right: 20rpx;
  background: #F6F2EA;
  border: 2rpx solid rgba(31, 74, 54, 0.16);
}

.intro-dot {
  position: absolute;
  top: 18rpx;
  left: 104rpx;
  width: 16rpx;
  height: 16rpx;
  border-radius: 50%;
  background: #b5482a;
  border: 2rpx solid #FFFFFF;
}

.intro-body {
  flex: 1;
  min-width: 0;
}

.intro-top {
  display: flex;
  align-items: baseline;
}

.intro-name {
  flex: 1;
  min-width: 0;
  font-size: var(--font-btn);
  font-weight: 600;
  color: #1E1E1A;
}

.intro-time {
  flex: none;
  font-size: var(--font-tiny);
  color: #6E6A5E;
}

.intro-text {
  display: block;
  margin-top: 6rpx;
  font-size: var(--font-caption);
  line-height: 1.6;
  color: #6b563c;
}

.intro-go {
  flex: none;
  margin-left: 12rpx;
  font-size: var(--font-base);
  color: #b5482a;
}

.fab {
  position: fixed;
  right: 24rpx;
  /* tabBar 约 100rpx，再让出安全区，球不压住导航 */
  bottom: calc(132rpx + env(safe-area-inset-bottom));
  z-index: 70;
  display: flex;
  align-items: center;
}

.fab-ball {
  position: relative;
  width: 108rpx;
  height: 108rpx;
  border-radius: 50%;
  overflow: hidden;
  background: #F6F2EA;
  border: 5rpx solid #FFFFFF;
  box-shadow: 0 10rpx 26rpx rgba(61, 43, 26, 0.22);
}

.fab-logo {
  width: 100%;
  height: 100%;
  display: block;
}

/* 呼吸环：不抢注意力，只是让球「活着」 */
.fab-ring {
  position: absolute;
  left: -5rpx;
  top: -5rpx;
  right: -5rpx;
  bottom: -5rpx;
  border-radius: 50%;
  border: 3rpx solid rgba(181, 72, 42, 0.42);
  animation: fabPulse 2.8s ease-out infinite;
  pointer-events: none;
}

@keyframes fabPulse {
  0% { transform: scale(1); opacity: 0.7; }
  70% { transform: scale(1.22); opacity: 0; }
  100% { transform: scale(1.22); opacity: 0; }
}

/* 气泡：贴在球左边，右侧一个小尖角指向球。
   父级 .fab 只有球那么宽（108rpx），只写 right 会把文字压成竖排；
   但给太宽又会拉成一根横条。300rpx 让主文案自然折成两行，宽高才匀称。 */
.fab-tip {
  position: absolute;
  right: 124rpx;
  bottom: 10rpx;
  width: 320rpx;
  box-sizing: border-box;
  padding: 20rpx 24rpx;
  background: #FFFFFF;
  border: 2rpx solid rgba(31, 74, 54, 0.2);
  border-radius: 16rpx;
  box-shadow: 0 8rpx 20rpx rgba(61, 43, 26, 0.12);
  opacity: 0;
  transform: translateX(16rpx) scale(0.94);
  transform-origin: right bottom;
  transition: opacity 0.24s ease, transform 0.24s ease;
  pointer-events: none;
}

.fab-tip.on {
  opacity: 1;
  transform: translateX(0) scale(1);
  pointer-events: auto;
}

.fab-tip::after {
  content: '';
  position: absolute;
  right: -10rpx;
  bottom: 38rpx;
  width: 18rpx;
  height: 18rpx;
  background: #FFFFFF;
  border-right: 2rpx solid rgba(31, 74, 54, 0.2);
  border-top: 2rpx solid rgba(31, 74, 54, 0.2);
  transform: rotate(45deg);
}

.fab-tip-t {
  display: block;
  font-size: var(--font-caption);
  line-height: 1.4;
  color: #1E1E1A;
  /* 文案里按标点预置了换行，别让系统再断在词中间 */
  white-space: pre-line;
}

.fab-tip-s {
  display: block;
  margin-top: 4rpx;
  font-size: var(--font-micro);
  color: #b5482a;
}

/* 面板样式已撤：点球直接进 /pages/kangkang 统一对话框 */

/* ============================================================
   C 主题 ·「当代岭南·清鲜」首页皮肤（2026-11-20）
