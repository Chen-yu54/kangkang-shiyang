  color: var(--color-flame);
}

.cp-unit { margin-left: 4rpx; font-size: var(--font-micro); color: var(--color-ink-3); }
.cp-k { display: block; margin-top: 2rpx; font-size: var(--font-caption); color: var(--color-ink-2); }
.cp-s { display: block; margin-top: 2rpx; font-size: var(--font-tiny); line-height: 1.4; color: var(--color-ink-3); }

.cp-rings {
  display: flex;
  margin-top: 22rpx;
  padding-top: 20rpx;
  border-top: 1rpx solid rgba(31, 74, 54, 0.12);
}

.cp-ring-item { flex: 1; display: flex; flex-direction: column; align-items: center; }
.cp-ring { position: relative; width: 118rpx; height: 118rpx; border-radius: 50%; }

.cp-ring-in {
  position: absolute;
  left: 14rpx;
  top: 14rpx;
  width: 90rpx;
  height: 90rpx;
  border-radius: 50%;
  background-color: #FFFFFF;
  display: flex;
  align-items: center;
  justify-content: center;
}

.cp-ring-t { font-family: var(--font-sans); font-size: var(--font-caption); color: var(--color-ink); }
.cp-rk { margin-top: 8rpx; font-size: var(--font-micro); color: var(--color-ink-2); }

.cp-go {
  display: flex;
  align-items: center;
  margin-top: 22rpx;
  padding: 18rpx 20rpx;
  border: 1rpx solid rgba(181, 72, 42, 0.18);
