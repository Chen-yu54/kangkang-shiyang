/* pages/index/index.wxss —— 推荐页（杂志封面版）
 * 约束：字号 / 颜色 / 圆角 / 阴影 / 点击区一律取 app.wxss 的 CSS 变量。
 * 首屏：长辈模式条 → 节气封面 hero（立冬海报）→ 栏目头 → 当令菜展示牌。
 * 时辰问候条与节气文化卡已移去食养 tab，首页不再压别的内容。
 */

/* ==================== 1. 封面 hero：暗底食光层 ==================== */
.hero {
  position: relative;
  /* 600 → 560：封面仍是暗底开场，但把主区的栏目引题往上提 40rpx，
     首屏能看见「本期 · 节气食单 / 当令菜」而不是只剩一张海报 */
  height: 560rpx;
  margin-bottom: 24rpx;
  border-radius: var(--radius-card);
  box-shadow: var(--shadow-deep);
  overflow: hidden;
  background-color: var(--color-night);
}

.hero-poster {
  position: absolute;
  top: 0;
  right: 0;
  bottom: 0;
  left: 0;
  width: 100%;
  height: 100%;
}

.hero-fallback {
  position: absolute;
  top: 0;
  right: 0;
  bottom: 0;
  left: 0;
  background-image: linear-gradient(160deg, var(--color-night-2) 0%, var(--color-night) 100%);
}

/* 全屏暖黑压暗：顶部透气、底部沉，让上方字与底部字都可读；
 * 再叠一层暗角把视线收向中央食物。色值取夜色变量，不写死。
 * 海报是浅色水墨，底部渐变需压到 0.78 才能托住反白正文。 */
.hero-shade {
  position: absolute;
  top: 0;
  right: 0;
  bottom: 0;
  left: 0;
  background-image:
    linear-gradient(
      180deg,
      rgba(34, 23, 18, 0.52) 0%,
      rgba(34, 23, 18, 0.06) 26%,
      rgba(34, 23, 18, 0.3) 56%,
      rgba(34, 23, 18, 0.78) 100%
    ),
    radial-gradient(ellipse at center, rgba(34, 23, 18, 0) 50%, rgba(34, 23, 18, 0.46) 100%);
}

/* 顶部刊名栏 */
.hero-top {
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  padding: 24rpx 28rpx 0;
}

.hero-kicker {
  font-size: var(--font-caption);
  letter-spacing: var(--tracking-caps);
  color: var(--color-on-night-dim);
  padding-top: 8rpx;
}

/* 朱砂日期印章：只打日期（如 11.7），节气名由海报书法字承担 */
.hero-seal {
  display: flex;
  align-items: center;
  justify-content: center;
  min-width: 88rpx;
  height: 76rpx;
  padding: 0 14rpx;
  border-radius: 10rpx;
  background-color: var(--color-flame);
  box-shadow: 0 4rpx 12rpx rgba(24, 16, 10, 0.4);
}

.hero-seal-text {
  font-family: var(--font-sans);
  font-size: var(--font-seal-sm);
  line-height: 1.1;
  letter-spacing: 0.02em;
  text-align: center;
  color: var(--color-on-night);
}

/* 底部信息 */
.hero-foot {
  position: absolute;
  left: 32rpx;
  right: 32rpx;
  bottom: 28rpx;
  display: flex;
  flex-direction: column;
  align-items: flex-start;
}

.hero-headline {
  font-family: var(--font-sans);
  font-size: var(--font-title);
  line-height: 1.4;
  color: var(--color-on-night);
  text-shadow: 0 2rpx 12rpx rgba(24, 16, 10, 0.5);
}

.hero-hint {
  margin-top: 6rpx;
  font-size: var(--font-base);
  color: var(--color-on-night-dim);
}

.hero-ainote {
  margin-top: 14rpx;
  padding: 4rpx 14rpx;
  border: 1rpx solid rgba(246, 236, 216, 0.34);
  border-radius: 999rpx;
  font-size: var(--font-caption);
  letter-spacing: var(--tracking-caps);
  color: var(--color-on-night-dim);
}

/* 蒸汽：右下角三道，缓慢上升 */
.hero-steam {
  position: absolute;
  right: 15%;
  bottom: 24%;
  width: 0;
  height: 0;
  pointer-events: none;
}

.hero-steam-i {
  position: absolute;
  bottom: 0;
  width: 16rpx;
  height: 110rpx;
  border-radius: 999rpx;
  background-image: linear-gradient(180deg, rgba(255, 252, 244, 0) 0%, rgba(255, 252, 244, 0.9) 45%, rgba(255, 252, 244, 0) 100%);
  opacity: 0;
  animation: hero-steam-rise 3.6s ease-in-out infinite;
}

.hero-steam-1 { right: 0; animation-delay: 0s; }
.hero-steam-2 { right: 32rpx; height: 142rpx; animation-delay: 1.2s; }
.hero-steam-3 { right: 64rpx; height: 92rpx; animation-delay: 2.4s; }

@keyframes hero-steam-rise {
  0%   { transform: translateY(28rpx) translateX(0) scaleY(0.7); opacity: 0; }
  28%  { opacity: 0.9; }
  62%  { transform: translateY(-110rpx) translateX(-12rpx) scaleY(1); opacity: 0.5; }
  100% { transform: translateY(-190rpx) translateX(10rpx) scaleY(1.15); opacity: 0; }
}

/* ==================== 2.3 主区栏目头：朱砂引题 + 粗书口线 ====================
 * 「当令菜」是推荐页的主区标题。层级靠三件事拉开，不靠加粗加大乱来：
 *   ① 朱砂引题（本期 · 节气推荐）在上面起头
 *   ② 标题 48rpx + 宋体 + 宽字距 + 前面一枚书口序号
 *   ③ 双线书口加粗到 6rpx，风物区只有 2rpx 细线
 * 右侧给节气签（立冬）与道数（3 道），节气名不重复进标题（海报已有书法字）。 */
.lead {
  margin: 4rpx 0 22rpx;
}

.lead-kicker {
  display: block;
  font-size: var(--font-caption);
  letter-spacing: var(--tracking-caps);
  color: var(--color-flame);
}

.lead-row {
  position: relative;
  display: flex;
  align-items: baseline;
  justify-content: space-between;
  margin-top: 10rpx;
  padding-bottom: 16rpx;
  border-bottom: 6rpx solid var(--color-ink);
}

/* 书口细线：跟 .masthead 一样的「一粗一细」印刷件 */
.lead-row::after {
  content: '';
  position: absolute;
  left: 0;
  right: 0;
  bottom: 5rpx;
  border-bottom: 2rpx solid var(--color-ink);
}

.lead-main {
  display: flex;
  align-items: baseline;
  min-width: 0;
}

.lead-no {
  flex: none;
  margin-right: 16rpx;
  font-family: var(--font-sans);
  font-size: var(--font-caption);
  letter-spacing: var(--tracking-caps);
  color: var(--color-flame);
}

.lead-title {
  font-family: var(--font-sans);
  font-size: var(--font-title);
  font-weight: 600;
  letter-spacing: 0.1em;
  line-height: 1.1;
  color: var(--color-ink);
}

.lead-tags {
  flex: none;
  display: flex;
  align-items: baseline;
  margin-left: 16rpx;
}

/* 节气签：朱砂描边小印，代替标题里的「· 立冬」 */
.lead-term {
  padding: 2rpx 14rpx;
  border: 2rpx solid var(--color-flame);
  border-radius: 6rpx;
  font-family: var(--font-sans);
  font-size: var(--font-caption);
  line-height: 1.6;
  letter-spacing: 0.08em;
  color: var(--color-flame);
}

.lead-count {
  margin-left: 12rpx;
  font-size: var(--font-caption);
  color: var(--color-ink-3);
}

/* ==================== 3. 搜菜名 / 分隔 / 栏目头 ====================
 * 主区（当令菜）之后的内容统一降一档：搜索只剩一根细描边，
 * 风物区用居中小字分隔线，栏目头由 48rpx 双线降为 36rpx 单细线。 */
.search-entry {
  display: flex;
  align-items: center;
  justify-content: space-between;
  min-height: var(--tap-min);
  margin: 20rpx 0 0;
  padding: 0 24rpx;
  border: 2rpx solid var(--color-border-hair);
  border-radius: var(--radius-pill);
  background-color: transparent;
  box-sizing: border-box;
}

.search-text { font-size: var(--font-base); color: var(--color-ink-3); }

.search-go {
  font-family: var(--font-sans);
  font-size: var(--font-base);
  color: var(--color-border);
}

/* 风物区分隔：两根细线夹一个小字标签，像杂志里的「、」分隔页 */
.band {
  display: flex;
  align-items: center;
  margin: 40rpx 0 8rpx;
}

.band-rule {
  flex: 1;
  height: 2rpx;
  background-color: var(--color-border);
}

.band-label {
  flex: none;
  margin: 0 20rpx;
  font-family: var(--font-sans);
  font-size: var(--font-micro);
  letter-spacing: 0.3em;
  color: var(--color-ink-3);
}

/* 栏目头（次区）：序号 + 小标题 + 单细线 */
.sec {
  display: flex;
  align-items: baseline;
  justify-content: space-between;
  margin: 32rpx 0 18rpx;
  padding-bottom: 12rpx;
  border-bottom: 2rpx solid var(--color-border-hair);
}

.sec-main {
  display: flex;
  align-items: baseline;
  min-width: 0;
}

.sec-no {
  flex: none;
  margin-right: 14rpx;
  font-family: var(--font-sans);
  font-size: var(--font-caption);
  letter-spacing: var(--tracking-caps);
  color: var(--color-flame);
}

.sec-title {
  font-family: var(--font-sans);
  font-size: var(--font-base);
  letter-spacing: var(--tracking-title);
  color: var(--color-ink-2);
}

/* 风物区的荐语：字号降一档、上下留白收紧，读起来是「附文」不是「社论」。
 * 顶线去掉——上面紧跟分隔线，两道细线会叠成双横线；只留底线收尾。 */
.pullquote-quiet {
  padding: 30rpx 24rpx 26rpx;
  margin: 8rpx 0 4rpx;
}

.pullquote-quiet::before {
  display: none;
}

.pullquote-quiet .pullquote-text {
  font-size: var(--font-base);
  line-height: 1.85;
}

.pullquote-quiet::after {
  left: 34%;
  right: 34%;
}

/* ==================== 4. 节气文化卡（次区第一块） ====================
 * 只取三种色：纸（底）、墨（文字）、朱砂（小签 / 入口框）。
 * 冬季节气色是黛蓝，落在暖纸面上发冷，这里不走节气色；
 * 卡片不原地铺开：立冬 + 一句 + 诗，点「立冬的讲究」直接去节气详情页。 */
.tculture {
  padding: 26rpx 26rpx 22rpx;
  margin: 0 0 20rpx;
  background-color: var(--color-card);
  border: 2rpx solid var(--color-border-hair);
  border-radius: var(--radius-small);
  box-sizing: border-box;
}

.tculture-head {
  display: flex;
  align-items: baseline;
}

/* 「节气」两字做成一枚小签，让立冬两个字一眼是主角 */
.tculture-tag {
  flex: none;
  margin-right: 14rpx;
  padding: 2rpx 10rpx;
  font-size: var(--font-caption);
  letter-spacing: var(--tracking-title);
  color: var(--color-flame);
  border: 2rpx solid var(--color-flame);
  border-radius: 6rpx;
}

.tculture-term {
  flex: 1;
  min-width: 0;
  font-family: var(--font-sans);
  font-size: var(--font-title);
  font-weight: 600;
  letter-spacing: 0.08em;
  color: var(--color-ink);
}

/* ============ 节气文化卡内的三候与食俗 ============ */
.tculture-block {
  margin-top: 24rpx;
  padding-top: 20rpx;
  border-top: 1rpx dashed var(--color-border-hair);
}

.tculture-label {
  display: block;
  margin-bottom: 12rpx;
  font-size: var(--font-micro);
  letter-spacing: 0.04em;
  color: var(--color-ink-3);
}

.tculture-pheno {
  display: flex;
  flex-direction: column;
}

.tculture-pheno-item {
  display: flex;
  align-items: baseline;
  margin-bottom: 8rpx;
}

.tculture-pheno-no {
  flex: none;
  width: 36rpx;
  height: 36rpx;
  line-height: 36rpx;
  margin-right: 12rpx;
  text-align: center;
  border-radius: 50%;
  background-color: var(--color-green-bg);
  color: var(--color-green);
  font-size: var(--font-tiny);
}

.tculture-pheno-text {
  flex: 1;
  font-size: var(--font-caption);
  line-height: 1.6;
  color: var(--color-ink-2);
}

.tculture-folk {
  display: flex;
  flex-direction: column;
}

.tculture-folk-item {
  margin-bottom: 10rpx;
}

.tculture-folk-title {
  display: block;
  font-size: var(--font-caption);
  font-weight: 600;
  color: var(--color-ink);
}

.tculture-folk-desc {
  display: block;
  margin-top: 2rpx;
  font-size: var(--font-micro);
  line-height: 1.6;
  color: var(--color-ink-2);
}

.tculture-slogan {
  display: block;
  margin-top: 6rpx;
  font-family: var(--font-sans);
  font-size: var(--font-subtitle);
  letter-spacing: var(--tracking-title);
  color: var(--color-ink-2);
}

/* 诗句并进卡头：原来它单占一屏，跟文化卡说的是同一件事 */
.tculture-poem {
  margin-top: 16rpx;
  padding-left: 18rpx;
  border-left: 2rpx solid var(--color-border);
}

.tculture-poem-text {
  display: block;
  font-family: var(--font-sans);
  font-size: var(--font-base);
  line-height: 1.6;
  color: var(--color-ink-2);
}

.tculture-poem-by {
  display: block;
  margin-top: 4rpx;
  font-size: var(--font-caption);
  color: var(--color-ink-3);
}

/* 入口框：朱砂细边 + 极淡暖底，比正文块显眼一档，但仍是「纸上一页」不是按钮 */
.tmore {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-top: 18rpx;
  padding: 18rpx 20rpx;
  border: 2rpx solid var(--color-flame);
  border-radius: var(--radius-small);
  background-color: rgba(181, 72, 42, 0.06);
  box-sizing: border-box;
}

.tmore-main {
  flex: 1;
  min-width: 0;
}

.tmore-title {
  display: block;
  font-family: var(--font-sans);
  font-size: var(--font-base);
  font-weight: 600;
  letter-spacing: 0.02em;
  color: var(--color-flame);
}

.tmore-sub {
  display: block;
  margin-top: 4rpx;
  font-size: var(--font-caption);
  color: var(--color-ink-3);
}

.tmore-act {
  flex: none;
  margin-left: 12rpx;
  font-size: var(--font-caption);
  white-space: nowrap;
  color: var(--color-flame);
}

/* 展开到底再看整个节气页：挂在内容末尾，不占折叠态的位置 */
/* ==================== 5. 当令展示牌 ====================
 * 一道一屏自动轮播，图 + 展签（序号 / 菜名 / 做法）同步切换。
 * 上一版是「一张主推大卡 + 三列 296rpx 横滑卡」，做法文字在窄列里被压成
 * 两字一行、还读不完；改成整屏展示牌，一段话有两个整行可以落。 */
.showcase {
  margin-bottom: 4rpx;
}

.sc-swiper {
  height: 640rpx;
  border: 2rpx solid var(--color-border-hair);
  border-radius: var(--radius-card);
  background-color: var(--color-card);
  box-shadow: var(--shadow-lift);
  overflow: hidden;
}

.sc-slide {
  display: flex;
  flex-direction: column;
  height: 100%;
}

/* 展签：左边朱砂序号，右边菜名 + 做法——像展品旁边的说明牌 */
.sc-caption {
  flex: 1;
  display: flex;
  align-items: flex-start;
  padding: 22rpx 26rpx 16rpx;
  box-sizing: border-box;
  overflow: hidden;
}

.sc-no {
  flex: none;
  margin-right: 20rpx;
  padding-top: 6rpx;
  font-family: var(--font-sans);
  font-size: var(--font-subtitle);
  line-height: 1.1;
  letter-spacing: 0.02em;
  color: var(--color-flame);
}

.sc-cap-main {
  flex: 1;
  min-width: 0;
}

.sc-cap-head {
  display: flex;
  align-items: baseline;
}

.sc-name {
  max-width: 400rpx;
  font-family: var(--font-sans);
  font-size: var(--font-subtitle);
  letter-spacing: var(--tracking-title);
  line-height: 1.4;
  color: var(--color-ink);
  overflow: hidden;
  white-space: nowrap;
  text-overflow: ellipsis;
}

.sc-cuisine {
  flex: none;
  margin-left: 14rpx;
  font-size: var(--font-caption);
  letter-spacing: 0.08em;
  color: var(--color-ink-3);
}

/* 做法：最多两行，超出裁掉（完整做法在菜品详情页） */
.sc-how {
  display: -webkit-box;
  -webkit-box-orient: vertical;
  -webkit-line-clamp: 2;
  margin-top: 8rpx;
  font-size: var(--font-btn);
  line-height: 1.6;
  color: var(--color-ink-2);
  overflow: hidden;
}

/* 轮播刻度：一格一道菜，当前格朱砂填满 */
.sc-dots {
  display: flex;
  align-items: center;
  justify-content: center;
  padding-top: 18rpx;
}

.sc-dot {
  width: 40rpx;
  height: 4rpx;
  margin: 0 6rpx;
  border-radius: 2rpx;
  background-color: var(--color-border);
  transition: width 0.2s ease, background-color 0.2s ease;
}

.sc-dot-on {
  width: 64rpx;
  background-color: var(--color-flame);
}

/* 全部入口：主区的收尾动作，比风物区文字重半档 */
.section-more {
  display: flex;
  align-items: center;
  justify-content: flex-end;
  padding: 14rpx 0 4rpx;
}

.section-more-text { font-size: var(--font-btn); color: var(--color-ink-2); }
.section-more-arrow { width: 28rpx; height: 28rpx; margin-left: 4rpx; }

/* ==================== 6. 跟着节气吃：暖浅色数据预览卡 ====================
 * 首页只放一眼能读完的概览，点整卡跳「节气数据」详情页看罗盘与五个分区。
 * 配色跟全站一致：米黄纸底 + 朱砂 / 赭金，不用深墨块，免得和纸底割裂。 */
.cp {
  padding: 26rpx 26rpx 22rpx;
  border: 1rpx solid rgba(31, 74, 54, 0.14);
  border-radius: var(--radius-card);
  background-image: linear-gradient(160deg, #FFFFFF 0%, #F6F2EA 100%);
  box-shadow: var(--shadow-card);
}

.cp-top {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.cp-live { display: flex; align-items: center; }

.cp-dot {
  width: 12rpx;
  height: 12rpx;
  margin-right: 10rpx;
  border-radius: 50%;
  background-color: var(--color-flame);
  animation: cp-breathe 2.4s ease-in-out infinite;
}

.cp-live-t {
  font-size: var(--font-micro);
  letter-spacing: 0.08em;
  color: var(--color-ink-2);
}

.cp-asof { font-size: var(--font-tiny); color: var(--color-ink-3); }

.cp-body { display: flex; align-items: center; margin-top: 20rpx; }

/* 小罗盘：264rpx 方框，圆心 (132,132)、半径 118，坐标由 data/cockpit.buildTicks 算好。
   四段 conic-gradient 是四季弧，中间盖一张纸色圆盘就露出环带，不用 mask，真机稳。 */
.cp-compass {
  position: relative;
  flex: none;
  width: 264rpx;
  height: 264rpx;
}

.cp-arcs {
  position: absolute;
  left: 0;
  top: 0;
  width: 264rpx;
  height: 264rpx;
  border-radius: 50%;
  background: conic-gradient(from -90deg,
    #d8ac63 0 86deg, transparent 86deg 90deg,
    #c07a3a 90deg 176deg, transparent 176deg 180deg,
    #b5482a 180deg 266deg, transparent 266deg 270deg,
    #1F4A36 270deg 356deg, transparent 356deg 360deg);
}

.cp-disc {
  position: absolute;
  left: 22rpx;
  top: 22rpx;
  width: 220rpx;
  height: 220rpx;
  border-radius: 50%;
  background-color: #FFFFFF;
  box-shadow: inset 0 0 0 1rpx rgba(31, 74, 54, 0.1);
}

.cp-tick {
  position: absolute;
  width: 4rpx;
  height: 14rpx;
  margin-left: -2rpx;
  margin-top: -7rpx;
  border-radius: 2rpx;
  background-color: rgba(31, 74, 54, 0.28);
  opacity: 0;
}

.cp-compass.on .cp-tick { animation: cp-tick-in 0.4s ease-out both; }
.cp-tick.on { background-color: #c9a15a; }
.cp-tick.now {
  height: 22rpx;
  margin-top: -11rpx;
  background-color: var(--color-flame);
}

.cp-face {
  position: absolute;
  left: 22rpx;
  top: 22rpx;
  width: 220rpx;
  height: 220rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
}

.cp-term {
  font-family: var(--font-sans);
  font-size: 52rpx;
  line-height: 1.1;
  letter-spacing: 0.08em;
  color: var(--color-ink);
}

.cp-pos { margin-top: 8rpx; font-size: var(--font-tiny); color: var(--color-ink-3); }

.cp-kpis {
  flex: 1;
  min-width: 0;
  display: flex;
  flex-direction: column;
  margin-left: 18rpx;
}

.cp-kpi { padding: 8rpx 0; border-bottom: 1rpx solid rgba(31, 74, 54, 0.1); }
.cp-kpi:last-child { border-bottom: 0; }
.cp-kpi-n { display: flex; align-items: baseline; }

.cp-num {
  font-family: var(--font-sans);
  font-size: 56rpx;
