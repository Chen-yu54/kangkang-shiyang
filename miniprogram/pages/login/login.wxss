/* pages/login/login.wxss —— 登录页
 * 版式参考：标志居中、一句口号、一个大按钮、协议一行。
 * 配色仍守全站三色：纸（底）、墨（文字）、朱砂（按钮）。
 * 标志本身是暖绿插画，落在米黄纸上不打架；不为此整页换绿主题。 */

.lg {
  position: relative;
  display: flex;
  flex-direction: column;
  min-height: 100vh;
  padding: 0 48rpx;
  box-sizing: border-box;
  background-color: var(--color-bg);
  overflow: hidden;
}

/* 顶部一团极淡的暖光，避免大块米黄显得死 */
.lg-glow {
  position: absolute;
  top: -180rpx;
  left: 50%;
  width: 720rpx;
  height: 720rpx;
  margin-left: -360rpx;
  border-radius: 50%;
  background-image: radial-gradient(
    circle,
    rgba(181, 72, 42, 0.07) 0%,
    rgba(181, 72, 42, 0.02) 45%,
    rgba(181, 72, 42, 0) 70%
  );
  pointer-events: none;
}

.lg-back {
  position: absolute;
  top: 24rpx;
  left: 24rpx;
  z-index: 2;
  display: flex;
  align-items: center;
  justify-content: center;
  width: 88rpx;
  height: 88rpx;
}

.lg-back-text {
  font-family: var(--font-serif);
  font-size: 48rpx;
  color: var(--color-ink-2);
}

/* —— 品牌区 —— */
.lg-top {
  position: relative;
  z-index: 1;
}

.lg-brand {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding-top: 64rpx;
}

.lg-logo-ring {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 200rpx;
  height: 200rpx;
  border: 2rpx solid rgba(139, 90, 43, 0.22);
  border-radius: 50%;
  background-color: var(--color-bg-soft);
  box-shadow: 0 8rpx 24rpx rgba(90, 60, 30, 0.1);
  overflow: hidden;
  box-sizing: border-box;
}

.lg-logo {
  width: 100%;
  height: 100%;
  border-radius: 50%;
}

.lg-name {
  margin-top: 28rpx;
  padding-left: 10rpx;
  font-family: var(--font-serif);
  font-size: 64rpx;
  font-weight: 600;
  letter-spacing: 10rpx;
  color: var(--color-ink);
}

.lg-slogan {
  margin-top: 14rpx;
  font-size: 30rpx;
  letter-spacing: 4rpx;
  color: var(--color-ink-3);
}

/* —— 三个说明点：这一页不做功能讲解，只交代「这里有什么」 —— */
.lg-points {
  margin-top: 56rpx;
  padding: 24rpx 26rpx;
  border: 2rpx solid var(--color-border-hair);
  border-radius: var(--radius-card);
  background-color: rgba(251, 247, 234, 0.7);
}

.lg-point {
  display: flex;
  align-items: flex-start;
  padding: 10rpx 0;
}

.lg-point-no {
  flex: none;
  width: 44rpx;
  font-family: var(--font-serif);
  font-size: 24rpx;
  line-height: 1.6;
  color: var(--color-flame);
}

.lg-point-text {
  flex: 1;
  min-width: 0;
  font-size: 28rpx;
  line-height: 1.6;
  color: var(--color-ink-2);
}

.lg-fill {
  flex: 1;
  min-height: 40rpx;
}

/* —— 底部操作区 —— */
.lg-bottom {
  position: relative;
  z-index: 1;
  padding-bottom: 40rpx;
}

.lg-btn {
  display: flex;
  align-items: center;
  justify-content: center;
  min-height: 104rpx;
  border-radius: 999rpx;
  background-color: var(--color-flame);
  box-shadow: 0 10rpx 24rpx rgba(181, 72, 42, 0.22);
}

.lg-btn-hover {
  opacity: 0.86;
}

.lg-btn-text {
  font-size: 34rpx;
  font-weight: 600;
  letter-spacing: 6rpx;
  color: #fdf3e0;
}

.lg-agree {
  display: flex;
  flex-wrap: wrap;
  align-items: center;
  justify-content: center;
  margin-top: 20rpx;
}

.lg-agree-text {
  font-size: 24rpx;
  color: var(--color-ink-3);
}

.lg-link {
  font-size: 24rpx;
  color: var(--color-flame);
}

.lg-skip {
  display: flex;
  align-items: center;
  justify-content: center;
  min-height: 88rpx;
}

.lg-skip-text {
  font-size: 28rpx;
  color: var(--color-ink-3);
}

/* —— 字号档位 —— */
.lg-font {
  display: flex;
  align-items: center;
  justify-content: center;
  margin-top: 4rpx;
}

.lg-font-label {
  margin-right: 14rpx;
  font-size: 24rpx;
  color: var(--color-ink-3);
}

.lg-font-opts {
  display: flex;
}

.lg-font-opt {
  min-width: 88rpx;
  min-height: 64rpx;
  margin-left: 10rpx;
  padding: 8rpx 16rpx;
  border: 2rpx solid var(--color-border-hair);
  border-radius: 999rpx;
  font-size: var(--font-caption);
  line-height: 1.5;
  text-align: center;
  color: var(--color-ink-2);
  background-color: var(--color-bg-soft);
  box-sizing: border-box;
}

.lg-font-on {
  border-color: var(--color-flame);
  color: var(--color-flame);
  background-color: rgba(181, 72, 42, 0.06);
}

.lg-foot {
  display: block;
  margin-top: 20rpx;
  text-align: center;
  font-size: 22rpx;
  letter-spacing: 1rpx;
  color: var(--color-ink-3);
  opacity: 0.85;
}

/* ==================== 微信登录弹层 ==================== */
.auth-mask {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  z-index: 200;
  display: flex;
  align-items: flex-end;
  background-color: rgba(24, 16, 10, 0.46);
}

.auth-sheet {
  width: 100%;
  padding: 20rpx 40rpx calc(40rpx + env(safe-area-inset-bottom));
  border-radius: 32rpx 32rpx 0 0;
  background-color: var(--color-bg-soft);
  box-sizing: border-box;
}

.auth-bar {
  width: 72rpx;
  height: 8rpx;
  margin: 0 auto 26rpx;
  border-radius: 999rpx;
  background-color: rgba(90, 70, 48, 0.18);
}

.auth-title {
  display: block;
  text-align: center;
  font-family: var(--font-serif);
  font-size: 40rpx;
  letter-spacing: 4rpx;
  color: var(--color-ink);
}

.auth-sub {
  display: block;
  margin-top: 10rpx;
  text-align: center;
  font-size: 26rpx;
  color: var(--color-ink-3);
}

.auth-who {
  display: flex;
  align-items: center;
  margin-top: 36rpx;
}

/* button 默认样式清掉，只留可点的圆头像 */
.auth-avatar {
  display: flex;
  flex-direction: column;
  align-items: center;
  flex: none;
  width: 168rpx;
  padding: 0;
  margin: 0;
  border: none;
  background-color: transparent;
  line-height: 1;
}

.auth-avatar::after {
  border: none;
}

.auth-avatar-img {
  width: 128rpx;
  height: 128rpx;
  border: 2rpx solid var(--color-border);
  border-radius: 50%;
  background-color: var(--color-bg);
  box-sizing: border-box;
}

.auth-avatar-hint {
  margin-top: 10rpx;
  font-size: 22rpx;
  color: var(--color-ink-3);
}

.auth-nick-box {
  flex: 1;
  min-width: 0;
  margin-left: 24rpx;
}

.auth-nick-label {
  display: block;
  font-size: 24rpx;
  color: var(--color-ink-3);
}

.auth-nick {
  height: 76rpx;
  margin-top: 6rpx;
  border-bottom: 2rpx solid var(--color-border-soft);
  font-size: 34rpx;
  color: var(--color-ink);
}

.auth-nick-ph {
  color: var(--color-ink-3);
  opacity: 0.6;
}

.auth-agree {
  display: flex;
  align-items: flex-start;
  min-height: 88rpx;
  margin-top: 24rpx;
}

.auth-cb {
  display: flex;
  align-items: center;
  justify-content: center;
  flex: none;
  width: 40rpx;
  height: 40rpx;
  margin-top: 4rpx;
  border: 2rpx solid var(--color-border);
  border-radius: 8rpx;
  background-color: var(--color-bg);
  box-sizing: border-box;
}

.auth-cb-on {
  border-color: var(--color-flame);
  background-color: var(--color-flame);
}

.auth-cb-tick {
  font-size: 24rpx;
  line-height: 1;
  color: #fdf3e0;
}

.auth-agree-text {
  flex: 1;
  margin-left: 14rpx;
  font-size: 24rpx;
  line-height: 1.6;
  color: var(--color-ink-2);
}

.auth-submit {
  display: flex;
  align-items: center;
  justify-content: center;
  min-height: 100rpx;
  margin-top: 12rpx;
  border-radius: 999rpx;
  background-color: var(--color-flame);
}

.auth-submit-text {
  font-size: 32rpx;
  font-weight: 600;
  letter-spacing: 6rpx;
  color: #fdf3e0;
}

.auth-note {
  display: block;
  margin-top: 20rpx;
  text-align: center;
  font-size: 22rpx;
  line-height: 1.6;
  color: var(--color-ink-3);
}
