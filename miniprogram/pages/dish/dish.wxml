<!-- page-meta 必须是页面第一个节点，一页只能有一个 -->
<page-meta page-style="{{pageStyle}}" />

<view class="page {{elderMode ? 'elder' : ''}}">
  <view class="content">

    <loading wx:if="{{status === 'loading'}}" type="spinner" />

    <view wx:elif="{{status === 'notfound'}}" class="state-box">
      <text class="state-text">{{copy.notFound}}</text>
      <view class="btn" hover-class="tap-hover" bindtap="onBack">{{copy.notFoundAction}}</view>
    </view>

    <view wx:elif="{{status === 'error'}}" class="state-box">
      <text class="state-text">{{copy.error}}</text>
      <view class="btn" hover-class="tap-hover" bindtap="onRetry">{{copy.retry}}</view>
    </view>

    <block wx:else>
      <view class="dish-media">
        <dish-media
          image="{{dish.image}}"
          name="{{dish.name}}"
          cuisine="{{dish.cuisine}}"
          height="420"
          mode="hero"
          round="{{true}}"
        />
      </view>

      <!-- 生成式内容显式标识：不是文案修饰，是合规要求，也是「AI 在哪参与」的可见证据 -->
      <text wx:if="{{dish.image}}" class="ai-tag">{{copy.aiImage}}</text>

      <view class="dish-head">
        <text class="dish-name">{{dish.name}}</text>
        <text wx:if="{{dish.costText}}" class="dish-cost">{{dish.costText}}</text>
      </view>

      <view wx:if="{{dish.cuisineName || dish.termText}}" class="meta-row">
        <text wx:if="{{dish.cuisineName}}" class="meta-text">{{dish.cuisineName}}</text>
        <image wx:if="{{dish.cuisineName && dish.termText}}" class="meta-dot" src="/images/icons/taodian.png" mode="aspectFit" />
        <text wx:if="{{dish.termText}}" class="meta-text">{{dish.termText}}</text>
      </view>

      <!-- 收藏：点击区 ≥ 88rpx -->
      <view class="fav-btn {{faved ? 'fav-btn-on' : ''}}" hover-class="tap-hover" bindtap="onToggleFavorite">
        <text class="fav-text">{{faved ? favoritedText : favoriteText}}</text>
      </view>

      <!-- 当令由头：知识库里「立冬（增城菜心当造）」括号里那一句，讲清为什么这个时节吃它 -->
      <view wx:if="{{dish.termNote}}" class="section">
        <text class="section-label">{{copy.termWhy}}</text>
        <view class="why-box">
          <text wx:if="{{dish.mainTerm}}" class="why-term">{{dish.mainTerm}}</text>
          <text class="why-text">{{dish.termNote}}</text>
        </view>
      </view>

      <view wx:if="{{dish.mainIngredients.length}}" class="section">
        <view class="section-head">
          <text class="section-label">{{copy.mainIngredients}}</text>
          <text class="section-hint">{{copy.ingredientHint}}</text>
        </view>
        <view class="chip-row">
          <view
            class="chip chip-tap"
            wx:for="{{dish.mainIngredients}}"
            wx:key="*this"
            data-name="{{item}}"
            hover-class="tap-hover"
            bindtap="onTapIngredient"
          >{{item}} ›</view>
        </view>
      </view>

      <view wx:if="{{dish.difficultyText || dish.costText}}" class="section">
        <view wx:if="{{dish.difficultyText}}" class="kv-row">
          <text class="kv-key">{{copy.difficulty}}</text>
          <text class="kv-val">{{dish.difficultyText}}</text>
        </view>
        <view wx:if="{{dish.costText}}" class="kv-row">
          <text class="kv-key">{{copy.cost}}</text>
          <text class="kv-val">{{dish.costText}}</text>
        </view>
      </view>

      <view wx:if="{{dish.method || dish.how}}" class="section">
        <text class="section-label">{{copy.steps}}</text>
        <text wx:if="{{dish.method}}" class="section-body">{{copy.method}}：{{dish.method}}</text>
        <text wx:if="{{dish.how}}" class="section-body">{{dish.how}}</text>
      </view>

      <view wx:if="{{dish.ageSuitable.length || dish.ageCaution}}" class="section">
        <text class="section-label">{{copy.ageSuitable}}</text>
        <view wx:if="{{dish.ageSuitable.length}}" class="chip-row">
          <text class="chip" wx:for="{{dish.ageSuitable}}" wx:key="*this">{{item}}</text>
        </view>
        <view wx:if="{{dish.ageCaution}}" class="notice-line">
          <text class="notice-key">{{copy.ageCaution}}</text>
          <text class="notice-val">{{dish.ageCaution}}</text>
        </view>
      </view>

      <!-- 过敏原是 M6 安全硬指标（学龄段漏报率必须为 0），有值就必显 -->
      <view wx:if="{{dish.allergen}}" class="section">
        <text class="section-label">{{copy.allergen}}</text>
        <text class="section-body">{{dish.allergen}}</text>
      </view>

      <view wx:if="{{dish.isUnverifiedClassic}}" class="notice-line">
        <text class="notice-val">{{copy.classicHint}}</text>
      </view>

      <!-- 同节气还能吃这些：同节气里再取 4 道，点进各自详情 -->
      <view wx:if="{{related.length}}" class="section">
        <text class="section-label">{{copy.related}}</text>
        <view class="rel-list">
          <view
            wx:for="{{related}}"
            wx:key="id"
            class="rel-item"
            hover-class="tap-hover"
            data-id="{{item.id}}"
            bindtap="onTapRelated"
          >
            <text class="rel-name">{{item.name}}</text>
            <text wx:if="{{item.cuisineName}}" class="rel-cuisine">{{item.cuisineName}}</text>
          </view>
        </view>
      </view>

      <!-- 出处：只留「一两个标签 + 可展开的原文」，不再解释等级口径。
           等级口径是给评审看的说明，摆在每道菜下面会让用户以为这是质检结论。 -->
      <view wx:if="{{dish.originText || dish.evidence || dish.source}}" class="section">
        <text class="section-label">{{copy.evidenceBlock}}</text>

        <view class="badge-row">
          <text wx:if="{{dish.originText}}" class="badge">{{dish.originText}}</text>
          <text wx:if="{{dish.evidenceText}}" class="badge badge-ev badge-ev-{{dish.evidence}}">{{dish.evidenceText}}</text>
        </view>

        <view
          wx:if="{{dish.source}}"
          class="src-toggle"
          hover-class="tap-hover"
          bindtap="onToggleSource"
        >
          <text class="src-toggle-text">{{sourceOpen ? copy.sourceHide : copy.sourceShow}}</text>
          <image
            class="src-toggle-ico"
            src="{{sourceOpen ? '/images/icons/zhujian-jianhao.png' : '/images/icons/zhuqian-jiahao.png'}}"
            mode="aspectFit"
          />
        </view>

        <text wx:if="{{sourceOpen}}" class="section-body src-body">{{dish.source}}</text>
      </view>
    </block>
  </view>

  <disclaimer />
</view>
