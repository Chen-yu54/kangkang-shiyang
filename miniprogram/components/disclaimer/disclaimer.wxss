/* 声明条：纸色底 + 左侧一条节气强调色，跟正文同一个色系。
 * 原版是「浅绿整块底 + 深绿字」，立冬这类蓝灰主题下会和暖纸底打架，
 * 一屏里出现两种冷色。改成只露一条 6rpx 的边后，
 * 仍然看得出「这是提示」，但不再抢主题色。
 * 文字对 #fbf7ea 底约 7.5:1，满足 4.5:1。 */

.disc {
  display: flex;
  align-items: flex-start;
  margin: 8rpx 0 16rpx;
  padding: 18rpx 24rpx 18rpx 22rpx;
  background-color: var(--color-bg-soft);
  border: 2rpx solid var(--color-border-hair);
  border-left: 6rpx solid var(--color-green);
  border-radius: 16rpx;
  box-sizing: border-box;
}

.disc-ico {
  flex: none;
  width: 36rpx;
  height: 36rpx;
  margin-top: 6rpx;
  opacity: 0.9;
}

.disc-txt {
  flex: 1;
  min-width: 0;
  margin-left: 14rpx;
  font-size: var(--font-base);
  line-height: 1.5;
  color: var(--color-ink-3);
}
