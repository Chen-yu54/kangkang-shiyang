<view wx:if="{{visible}}" class="tour" catchtouchmove="noop" bindtap="onNext">
  <!-- 四块实心遮罩围出亮圈：可靠地吃掉点击，也避免阴影方案在部分机型上渲染不一致 -->
  <block wx:if="{{hole}}">
    <view class="mask" style="left:0;right:0;top:0;height:{{hole.top}}px"></view>
    <view class="mask" style="left:0;top:{{hole.top}}px;width:{{hole.left}}px;height:{{hole.h}}px"></view>
    <view class="mask" style="left:{{hole.right}}px;right:0;top:{{hole.top}}px;height:{{hole.h}}px"></view>
    <view class="mask" style="left:0;right:0;top:{{hole.bottom}}px;bottom:0"></view>
    <!-- 亮圈：白色细描边 + 呼吸，像一束光落在那块上 -->
    <view class="ring" style="left:{{hole.left}}px;top:{{hole.top}}px;width:{{hole.w}}px;height:{{hole.h}}px"></view>
  </block>
  <view wx:else class="mask" style="left:0;right:0;top:0;bottom:0"></view>

  <view
    wx:if="{{tip}}"
    class="tip"
    style="left:{{tip.left}}px;top:{{tip.top}}px;width:{{tip.width}}px"
    catchtap="noop"
  >
    <view class="tip-head">
      <text class="tip-no">{{index + 1}}</text>
      <text class="tip-total">/{{total}}</text>
      <text class="tip-title">{{step.title}}</text>
    </view>
    <text class="tip-desc">{{step.desc}}</text>

    <view class="tip-acts">
      <view class="tip-skip" hover-class="tap-hover" catchtap="onSkip">{{skipText}}</view>
      <view class="tip-next" hover-class="tap-hover" catchtap="onNext">
        <text class="tip-next-text">{{index + 1 >= total ? doneText : nextText}}</text>
        <text class="tip-next-arrow">›</text>
      </view>
    </view>
  </view>
</view>
