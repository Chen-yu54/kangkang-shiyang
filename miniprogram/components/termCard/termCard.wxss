.term {
  position: relative;
  display: block;
  padding: 24rpx 24rpx 24rpx 32rpx;
  margin-bottom: 24rpx;
  background-color: var(--color-card);
  border: 2rpx solid var(--color-border);
  border-radius: var(--radius-card);
  box-shadow: var(--shadow-card);
  box-sizing: border-box;
  min-height: var(--tap-min);
  overflow: hidden;
}

/* 左侧季节色条：春嫩绿 / 夏浓绿 / 秋赭黄 / 冬黛蓝（色值见 app.wxss 的 --color-spring 等） */
.term-bar {
  position: absolute;
  top: 0;
  bottom: 0;
  left: 0;
  width: 10rpx;
}

.term-spring .term-bar {
  background-color: var(--color-spring);
}

.term-summer .term-bar {
  background-color: var(--color-summer);
}

.term-autumn .term-bar {
  background-color: var(--color-autumn);
}

.term-winter .term-bar {
  background-color: var(--color-winter);
}

.term-hover {
  opacity: 0.82;
}

/* 当前节气高亮：走节气主色（随日期变化），文字色不变（主色做正文对比度不足） */
.term-active {
  border-color: var(--color-green);
  background-color: var(--color-green-bg);
}

.term-active .term-name {
  font-weight: 600;
}

.term-head {
  display: flex;
  flex-wrap: wrap;
  align-items: baseline;
}

.term-name {
  font-size: var(--font-title);
  color: var(--color-ink);
}

.term-flag {
  margin-left: 16rpx;
  padding: 0 16rpx;
  border: 2rpx solid var(--color-green-deep);
  border-radius: var(--radius-card);
  font-size: var(--font-btn);
  color: var(--color-green-ink);
  box-sizing: border-box;
}

.term-window {
  margin-left: 16rpx;
  font-size: var(--font-base);
  color: var(--color-ink);
}

.term-headline {
  display: block;
  margin-top: 8rpx;
  font-size: var(--font-base);
  line-height: 1.6;
  color: var(--color-ink);
}
