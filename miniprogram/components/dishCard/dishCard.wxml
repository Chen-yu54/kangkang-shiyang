<view class="card" hover-class="card-hover" bindtap="onTap">
  <view class="card-media">
    <dish-media image="{{dish.image}}" name="{{dish.name}}" cuisine="{{dish.cuisine}}" height="320" mode="card" ai-tag="{{aiTag}}" flush="{{true}}" />

    <!-- 收藏按钮：圆形 88rpx，压印五角星图形，catchtap 阻止冒泡 -->
    <view
      class="fav-btn {{faved ? 'fav-btn-on' : ''}}"
      catchtap="onFavoriteTap"
      hover-class="fav-btn-hover"
      aria-label="{{faved ? favoritedText : favoriteText}}"
    >
      <image class="fav-icon" src="/images/icons/yayin-wujiaoxing.png" mode="aspectFit" />
    </view>
  </view>

  <view class="card-body">
    <view class="card-head">
      <text class="card-name">{{dish.name}}</text>
      <text class="card-cost" wx:if="{{dish.costText}}">{{dish.costText}}</text>
    </view>

    <view class="card-meta" wx:if="{{dish.cuisineName || (showTerm && dish.termText)}}">
      <text class="card-meta-text" wx:if="{{dish.cuisineName}}">{{dish.cuisineName}}</text>
      <image class="card-meta-dot" src="/images/icons/taodian.png" mode="aspectFit" wx:if="{{dish.cuisineName && showTerm && dish.termText}}" />
      <text class="card-meta-text" wx:if="{{showTerm && dish.termText}}">{{dish.termText}}</text>
    </view>

    <text class="card-feature" wx:if="{{dish.how || dish.feature}}">{{dish.how || dish.feature}}</text>
    <text class="card-extra" wx:if="{{dish.difficultyText}}">{{dish.difficultyText}}</text>

    <!-- 风味色谱条：卡底的菜系色签 -->
    <view class="ribbon ribbon-{{dish.cuisine}}"></view>
  </view>
</view>
