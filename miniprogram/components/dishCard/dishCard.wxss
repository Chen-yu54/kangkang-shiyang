.card {
  margin-bottom: 24rpx;
  background-color: var(--color-card);
  border: 2rpx solid var(--color-border-hair);
  border-radius: var(--radius-card);
  box-shadow: var(--shadow-card);
  overflow: hidden;
}

.card-hover {
  opacity: 0.82;
}

.card-media {
  position: relative;
}

/* 图片位由 dishMedia 组件渲染：有图显示风味卡，无图显示风味签，两态等高 320rpx */

/* 收藏按钮：圆形浮在图片右上角，半透明米白底，88rpx 点击区 */
.fav-btn {
  position: absolute;
  top: 16rpx;
  right: 16rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  width: var(--tap-min);
  height: var(--tap-min);
  border: 2rpx solid rgba(251, 247, 234, 0.6);
  border-radius: 50%;
  background-color: rgba(34, 23, 18, 0.34);
  box-sizing: border-box;
}

.fav-btn-on {
  border-color: var(--color-gold);
  background-color: rgba(181, 72, 42, 0.82);
}

.fav-btn-hover {
  opacity: 0.82;
}

.fav-icon {
  width: 40rpx;
  height: 40rpx;
}

.card-body {
  padding: 24rpx;
}

.card-head {
  display: flex;
  align-items: baseline;
  justify-content: space-between;
}

.card-name {
  flex: 1;
  font-family: var(--font-sans);
  letter-spacing: var(--tracking-title);
  font-size: var(--font-title);
  color: var(--color-ink);
}

/* 风味色谱条：卡底的菜系色签（组件样式隔离，全局 chromaribbon 进不来，此处自绘） */
.ribbon {
  width: 96rpx;
  height: 8rpx;
  margin-top: 16rpx;
  border-radius: 4rpx;
  background-color: var(--cuisine-other);
}

.ribbon-lingnan_home {
  background-color: var(--cuisine-lingnan);
}

.ribbon-guangfu {
  background-color: var(--cuisine-guangfu);
}

.ribbon-chaoshan {
  background-color: var(--cuisine-chaoshan);
}

.ribbon-hakka {
  background-color: var(--cuisine-hakka);
}

.ribbon-other {
  background-color: var(--cuisine-other);
}

.card-cost {
  margin-left: 16rpx;
  font-size: var(--font-btn);
  color: var(--color-ink);
}

.card-meta {
  display: flex;
  flex-wrap: wrap;
  align-items: center;
  margin-top: 8rpx;
}

.card-meta-text {
  font-size: var(--font-base);
  color: var(--color-ink);
}

.card-meta-dot {
  width: 16rpx;
  height: 16rpx;
  margin: 0 8rpx;
}

/* 正文自然换行，不做行数截断：
 * 验收口径要求「系统字号放大后不破版、不截断」，因此不引入 -webkit-line-clamp */
.card-feature {
  display: block;
  margin-top: 12rpx;
  font-size: var(--font-base);
  line-height: 1.6;
  color: var(--color-ink);
}

.card-extra {
  display: block;
  margin-top: 8rpx;
  font-size: var(--font-base);
  color: var(--color-ink);
}
