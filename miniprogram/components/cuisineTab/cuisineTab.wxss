/* components/cuisineTab —— 菜系胶囊 tab
 * 设计稿：三等分胶囊，未选白底细描边，选中深绿底白字（不是只描个绿边）。
 * 只在「菜系浏览」里使用；字号用 --font-btn，点击区保 ≥88rpx。 */
.tabs {
  display: flex;
  margin-bottom: 20rpx;
}

.tab {
  flex: 1;
  display: flex;
  align-items: center;
  justify-content: center;
  min-height: var(--tap-min);
  margin-right: 12rpx;
  padding: 0 8rpx;
  border: 1rpx solid var(--color-border);
  border-radius: 999rpx;
  background-color: #FFFFFF;
  box-sizing: border-box;
}

.tab:last-child {
  margin-right: 0;
}

.tab-active {
  border-color: var(--color-green);
  background-color: var(--color-green);
}

.tab-hover {
  opacity: 0.82;
}

.tab-text {
  font-size: var(--font-btn);
  color: var(--color-ink-2);
  text-align: center;
}

.tab-active .tab-text {
  font-weight: 600;
  color: #FFFFFF;
}
