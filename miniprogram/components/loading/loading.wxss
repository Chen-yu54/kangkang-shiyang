/* —— 骨架屏 —— */
.sk-wrap {
  display: block;
}

.sk-block {
  background-color: var(--color-skeleton);
  border-radius: var(--radius-card);
  animation: sk-pulse 1.4s ease-in-out infinite;
}

.sk-banner {
  height: 220rpx;
  margin-bottom: 24rpx;
}

.sk-card {
  height: 300rpx;
  margin-bottom: 24rpx;
}

@keyframes sk-pulse {
  0%,
  100% {
    opacity: 1;
  }
  50% {
    opacity: 0.55;
  }
}

/* —— 墨迹圆环加载态 —— */
.loading-center {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 96rpx 0;
}

.loading-circle {
  position: relative;
  width: 240rpx;
  height: 240rpx;
  border-radius: 50%;
  border: 2rpx solid var(--color-green-soft);
}

/* 三点之间的细线（版面设计稿：三枚墨点串在一条竖线上） */
.loading-thread {
  position: absolute;
  top: 56rpx;
  bottom: 56rpx;
  left: 50%;
  width: 2rpx;
  margin-left: -1rpx;
  background-color: var(--color-green-soft);
}

/* 内两层细金线圆环 */
.loading-circle::before,
.loading-circle::after {
  content: '';
  position: absolute;
  border-radius: 50%;
  border: 2rpx solid var(--color-border);
}

.loading-circle::before {
  top: 20rpx;
  right: 20rpx;
  bottom: 20rpx;
  left: 20rpx;
}

.loading-circle::after {
  top: 44rpx;
  right: 44rpx;
  bottom: 44rpx;
  left: 44rpx;
}

/* 三枚墨点：绿 / 棕 / 灰，各自呼吸 */
.loading-dot {
  position: absolute;
  width: 28rpx;
  height: 28rpx;
  border-radius: 50%;
  background-color: var(--color-green);
  top: 44rpx;
  left: 50%;
  margin-left: -14rpx;
  animation: dot-pulse 1.6s ease-in-out infinite;
}

.loading-dot.two {
  background-color: var(--color-brand);
  top: 50%;
  margin-top: -14rpx;
  animation-delay: 0.3s;
}

.loading-dot.three {
  background-color: var(--color-ink-3);
  top: auto;
  bottom: 36rpx;
  animation-delay: 0.6s;
}

@keyframes dot-pulse {
  0%,
  100% {
    opacity: 1;
    transform: scale(1);
  }
  50% {
    opacity: 0.5;
    transform: scale(0.82);
  }
}

.loading-title {
  margin-top: 32rpx;
  font-size: var(--font-title);
  letter-spacing: 4rpx;
  color: var(--color-ink);
  font-family: var(--font-heading);
}

.loading-en {
  margin-top: 8rpx;
  font-size: var(--font-base);
  letter-spacing: 1rpx;
  color: var(--color-ink-3);
}

.loading-sub {
  margin-top: 12rpx;
  font-size: var(--font-base);
  color: var(--color-ink-3);
}
